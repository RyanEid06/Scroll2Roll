import rocket.graphics
import rocket.graphics.canvas
import rocket.raylib.safe
import rocket.ui
import rocket.ui.controls
import rocket.ui.styles
import rocket.ui.theme

pub struct Navigation:
    context: ui.Context
    first: controls.Button
    second: controls.Button
    first_clicked: Bool
    second_clicked: Bool

fn button_styles(primary: Bool) -> styles.StyleStates:
    let base = styles.default_styles(theme.dark_theme())
    var normal_fill = graphics.color_from_rgba(0.89, 0.67, 0.39)
    var hovered_fill = graphics.color_from_rgba(0.98, 0.77, 0.48)
    var pressed_fill = graphics.color_from_rgba(0.70, 0.49, 0.27)
    var text_ink = graphics.color_from_rgba(0.09, 0.12, 0.14)
    var border_ink = graphics.color_from_rgba(0.95, 0.78, 0.52)
    if not primary:
        normal_fill = graphics.color_from_rgba(0.15, 0.22, 0.27)
        hovered_fill = graphics.color_from_rgba(0.20, 0.31, 0.36)
        pressed_fill = graphics.color_from_rgba(0.11, 0.17, 0.22)
        text_ink = graphics.color_from_rgba(0.93, 0.95, 0.92)
        border_ink = graphics.color_from_rgba(0.30, 0.42, 0.45)
    let border = styles.border_style(border_ink, 1.0, 11.0)
    let shadow = styles.shadow_style(graphics.color_from_rgba(0.0, 0.0, 0.0, 0.24), graphics.vec2(0.0, 3.0))
    let label = styles.text_style(text_ink, 19.0)
    let normal_button = styles.button_style(normal_fill, label, border, shadow, 11.0)
    let hovered_button = styles.button_style(hovered_fill, label, border, shadow, 11.0)
    let pressed_button = styles.button_style(pressed_fill, label, border, shadow, 11.0)
    let normal = styles.style_set(base.normal.text, base.normal.panel, normal_button, base.normal.image)
    let hovered = styles.style_set(base.hovered.text, base.hovered.panel, hovered_button, base.hovered.image)
    let pressed = styles.style_set(base.pressed.text, base.pressed.panel, pressed_button, base.pressed.image)
    return styles.style_states(normal, hovered, pressed, base.disabled, hovered)

pub fn update_navigation(context: ui.Context, window: safe.Window, screen: Int) -> Result[Navigation, String]:
    match canvas.from_window(window, graphics.size(1280.0, 720.0)):
        case Err(message):
            return Err(message)
        case Ok(mapping):
            match ui.begin_frame(context, window, mapping):
                case Err(message):
                    return Err(message)
                case Ok(ui_frame):
                    var first_label = "BLACKJACK"
                    var second_label = "SETTINGS"
                    if screen == 1:
                        first_label = "LOBBY"
                    if screen == 2:
                        first_label = "LOBBY"
                        second_label = "BLACKJACK"
                    let primary_states = button_styles(true)
                    let secondary_states = button_styles(false)
                    match controls.button(ui_frame, ui.widget_id("primary"), first_label, graphics.rect(1004.0, 235.0, 202.0, 54.0), primary_states):
                        case Err(message):
                            return Err(message)
                        case Ok(first):
                            match controls.button(first.frame, ui.widget_id("secondary"), second_label, graphics.rect(1004.0, 300.0, 202.0, 54.0), secondary_states):
                                case Err(message):
                                    return Err(message)
                                case Ok(second):
                                    match ui.end_frame(second.frame):
                                        case Err(message):
                                            return Err(message)
                                        case Ok(next_context):
                                            return Ok(Navigation(next_context, first.control, second.control, first.response.clicked, second.response.clicked))
