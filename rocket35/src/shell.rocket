import rocket.graphics
import rocket.graphics.canvas
import rocket.raylib.safe
import rocket.ui
import rocket.ui.controls
import rocket.ui.styles
import rocket.ui.theme

pub struct Navigation:
    context: ui.Context
    first: controls.Button
    second: controls.Button
    first_clicked: Bool
    second_clicked: Bool

fn button_styles() -> styles.StyleStates:
    let base = styles.default_styles(theme.dark_theme())
    let ink = graphics.color_from_rgba(0.05, 0.07, 0.10)
    let border = styles.border_style(graphics.color_from_rgba(0.98, 0.83, 0.48), 1.0, 8.0)
    let shadow = styles.shadow_style(graphics.color_from_rgba(0.0, 0.0, 0.0, 0.40), graphics.vec2(2.0, 3.0))
    let label = styles.text_style(ink, 17.0)
    let normal_button = styles.button_style(graphics.color_from_rgba(0.82, 0.61, 0.27), label, border, shadow, 8.0)
    let hovered_button = styles.button_style(graphics.color_from_rgba(0.98, 0.76, 0.37), label, border, shadow, 8.0)
    let pressed_button = styles.button_style(graphics.color_from_rgba(0.63, 0.45, 0.18), label, border, shadow, 8.0)
    let normal = styles.style_set(base.normal.text, base.normal.panel, normal_button, base.normal.image)
    let hovered = styles.style_set(base.hovered.text, base.hovered.panel, hovered_button, base.hovered.image)
    let pressed = styles.style_set(base.pressed.text, base.pressed.panel, pressed_button, base.pressed.image)
    return styles.style_states(normal, hovered, pressed, base.disabled, hovered)

pub fn update_navigation(context: ui.Context, window: safe.Window, screen: Int) -> Result[Navigation, String]:
    match canvas.from_window(window, graphics.size(1280.0, 720.0)):
        case Err(message):
            return Err(message)
        case Ok(mapping):
            match ui.begin_frame(context, window, mapping):
                case Err(message):
                    return Err(message)
                case Ok(ui_frame):
                    var first_label = "BLACKJACK"
                    var second_label = "SETTINGS"
                    if screen == 1:
                        first_label = "LOBBY"
                    if screen == 2:
                        first_label = "LOBBY"
                        second_label = "BLACKJACK"
                    let states = button_styles()
                    match controls.button(ui_frame, ui.widget_id("primary"), first_label, graphics.rect(1040.0, 122.0, 210.0, 46.0), states):
                        case Err(message):
                            return Err(message)
                        case Ok(first):
                            match controls.button(first.frame, ui.widget_id("secondary"), second_label, graphics.rect(1040.0, 181.0, 210.0, 46.0), states):
                                case Err(message):
                                    return Err(message)
                                case Ok(second):
                                    match ui.end_frame(second.frame):
                                        case Err(message):
                                            return Err(message)
                                        case Ok(next_context):
                                            return Ok(Navigation(next_context, first.control, second.control, first.response.clicked, second.response.clicked))
