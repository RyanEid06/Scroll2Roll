import src.crossing.crossing_engine
import src.crossing.crossing_model

pub struct Session:
    game: crossing_model.Game

pub fn new_session(starting_balance: Int, seed: Int) -> Result[Session, String]:
    return Ok(Session(crossing_engine.new_game(starting_balance, seed)?))

pub fn with_bet(session: Session, bet: Int) -> Result[Session, String]:
    return Ok(Session(crossing_engine.with_bet(session.game, bet)?))

pub fn with_start(session: Session) -> Result[Session, String]:
    return Ok(Session(crossing_engine.start(session.game)?))

pub fn with_move(session: Session, horizontal: Int, vertical: Int) -> Result[Session, String]:
    return Ok(Session(crossing_engine.move_player(session.game, horizontal, vertical)?))

pub fn with_ticks(session: Session, count: Int) -> Result[Session, String]:
    return Ok(Session(crossing_engine.tick_many(session.game, count)?))

pub fn with_pause(session: Session) -> Result[Session, String]:
    return Ok(Session(crossing_engine.toggle_pause(session.game)?))

pub fn with_cash_out(session: Session) -> Result[Session, String]:
    return Ok(Session(crossing_engine.cash_out(session.game)?))

pub fn with_next_round(session: Session) -> Result[Session, String]:
    return Ok(Session(crossing_engine.next_round(session.game)?))

pub fn phase_code(session: Session) -> Int:
    return crossing_engine.phase_code(session.game.phase)
