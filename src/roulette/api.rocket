import src.roulette.engine
import src.roulette.model
import src.roulette.rules

pub struct Session:
    game: model.Game

pub fn new_session(starting_balance: Int, seed: Int) -> Result[Session, String]:
    return Ok(Session(engine.new_game(starting_balance, seed)?))

pub fn with_selected_chip(session: Session, amount: Int) -> Result[Session, String]:
    return Ok(Session(engine.select_chip(session.game, amount)?))

pub fn with_bet(session: Session, bet: model.Bet) -> Result[Session, String]:
    return Ok(Session(engine.place(session.game, bet)?))

pub fn with_undo(session: Session) -> Result[Session, String]:
    return Ok(Session(engine.undo(session.game)?))

pub fn with_clear(session: Session) -> Result[Session, String]:
    return Ok(Session(engine.clear(session.game)?))

pub fn with_repeat(session: Session) -> Result[Session, String]:
    return Ok(Session(engine.repeat(session.game)?))

pub fn with_spin(session: Session) -> Result[Session, String]:
    return Ok(Session(engine.spin(session.game)?))

pub fn with_settlement(session: Session) -> Result[Session, String]:
    return Ok(Session(engine.settle(session.game)?))

pub fn with_next_round(session: Session) -> Result[Session, String]:
    return Ok(Session(engine.next_round(session.game)?))

pub fn with_rebet(session: Session) -> Result[Session, String]:
    let next = engine.next_round(session.game)?
    return Ok(Session(engine.rebet(next)?))

pub fn new_game(starting_balance: Int, seed: Int) -> Result[model.Game, String]:
    return engine.new_game(starting_balance, seed)

pub fn select_chip(game: model.Game, amount: Int) -> Result[model.Game, String]:
    return engine.select_chip(game, amount)

pub fn place(game: model.Game, bet: model.Bet) -> Result[model.Game, String]:
    return engine.place(game, bet)

pub fn straight(number: Int, stake: Int) -> Result[model.Bet, String]:
    return rules.straight(number, stake)

pub fn split(first: Int, second: Int, stake: Int) -> Result[model.Bet, String]:
    return rules.split(first, second, stake)

pub fn street(first: Int, stake: Int) -> Result[model.Bet, String]:
    return rules.street(first, stake)

pub fn corner(first: Int, stake: Int) -> Result[model.Bet, String]:
    return rules.corner(first, stake)

pub fn six_line(first: Int, stake: Int) -> Result[model.Bet, String]:
    return rules.six_line(first, stake)

pub fn basket(stake: Int) -> Result[model.Bet, String]:
    return rules.basket(stake)

pub fn dozen(index: Int, stake: Int) -> Result[model.Bet, String]:
    return rules.dozen(index, stake)

pub fn column(index: Int, stake: Int) -> Result[model.Bet, String]:
    return rules.column(index, stake)

pub fn outside(kind: model.BetKind, stake: Int) -> Result[model.Bet, String]:
    return rules.outside(kind, stake)

pub fn undo(game: model.Game) -> Result[model.Game, String]:
    return engine.undo(game)

pub fn clear(game: model.Game) -> Result[model.Game, String]:
    return engine.clear(game)

pub fn repeat(game: model.Game) -> Result[model.Game, String]:
    return engine.repeat(game)

pub fn rebet(game: model.Game) -> Result[model.Game, String]:
    return engine.rebet(game)

pub fn spin(game: model.Game) -> Result[model.Game, String]:
    return engine.spin(game)

pub fn settle(game: model.Game) -> Result[model.Game, String]:
    return engine.settle(game)

pub fn next_round(game: model.Game) -> Result[model.Game, String]:
    return engine.next_round(game)

pub fn total_wager(game: model.Game) -> Int:
    return engine.total_wager(game)

pub fn phase_code(game: model.Game) -> Int:
    return engine.phase_code(game.phase)
