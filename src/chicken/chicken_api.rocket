import src.chicken.engine
import src.chicken.model

pub struct Session:
    game: model.Game

pub fn new_session(starting_balance: Int, seed: Int) -> Result[Session, String]:
    return Ok(Session(engine.new_game(starting_balance, seed)?))

pub fn with_risk(session: Session, risk: model.Risk) -> Result[Session, String]:
    return Ok(Session(engine.with_risk(session.game, risk)?))

pub fn risk_code(session: Session) -> Int:
    match session.game.risk:
        case model.Low:
            return 0
        case model.Medium:
            return 1
        case model.High:
            return 2

pub fn with_risk_code(session: Session, code: Int) -> Result[Session, String]:
    if code == 0:
        return with_risk(session, model.Low())
    if code == 1:
        return with_risk(session, model.Medium())
    if code == 2:
        return with_risk(session, model.High())
    return Err("Coop Climb risk code must be between 0 and 2")

pub fn with_bet(session: Session, bet: Int) -> Result[Session, String]:
    return Ok(Session(engine.with_bet(session.game, bet)?))

pub fn with_start(session: Session) -> Result[Session, String]:
    return Ok(Session(engine.start(session.game)?))

pub fn with_advance(session: Session) -> Result[Session, String]:
    return Ok(Session(engine.advance(session.game)?))

pub fn with_cash_out(session: Session) -> Result[Session, String]:
    return Ok(Session(engine.cash_out(session.game)?))

pub fn with_next_round(session: Session) -> Result[Session, String]:
    return Ok(Session(engine.next_round(session.game)?))

pub fn phase_code(session: Session) -> Int:
    return engine.phase_code(session.game.phase)
