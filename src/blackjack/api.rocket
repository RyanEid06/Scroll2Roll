import src.blackjack.engine
import src.blackjack.model

pub fn new_game(human_name: String, starting_balance: Int, ai_count: Int, seed: Int) -> Result[model.Game, String]:
    return engine.new_game(human_name, starting_balance, ai_count, seed)

pub fn set_bet(game: model.Game, player_index: Int, amount: Int) -> Result[model.Game, String]:
    return engine.set_bet(game, player_index, amount)

pub fn place_ai_bets(game: model.Game) -> Result[model.Game, String]:
    return engine.place_ai_bets(game)

pub fn start_round(game: model.Game) -> Result[model.Game, String]:
    return engine.start_round(game)

pub fn available_actions(game: model.Game) -> Array[model.Action]:
    return engine.available_actions(game)

pub fn apply_action(game: model.Game, action: model.Action) -> Result[model.Game, String]:
    return engine.apply_action(game, action)

pub fn ai_step(game: model.Game) -> Result[model.Game, String]:
    return engine.ai_step(game)

pub fn dealer_step(game: model.Game) -> Result[model.Game, String]:
    return engine.dealer_step(game)

pub fn begin_next_round(game: model.Game) -> Result[model.Game, String]:
    return engine.begin_next_round(game)

pub fn phase_code(game: model.Game) -> Int:
    return engine.phase_code(game.phase)
