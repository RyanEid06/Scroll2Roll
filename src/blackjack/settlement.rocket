import src.blackjack.blackjack_cards
import src.blackjack.blackjack_model

pub fn hand(player: blackjack_model.Hand, dealer: blackjack_model.Hand, table: blackjack_model.Rules) -> blackjack_model.HandSettlement:
    let player_value = blackjack_cards.value(player)
    let dealer_value = blackjack_cards.value(dealer)
    if player.surrendered:
        return blackjack_model.HandSettlement(blackjack_model.Surrendered(), player.bet / 2, player_value.total, dealer_value.total)
    if dealer_value.blackjack:
        if player_value.blackjack:
            return blackjack_model.HandSettlement(blackjack_model.Push(), player.bet, player_value.total, dealer_value.total)
        return blackjack_model.HandSettlement(blackjack_model.Lose(), 0, player_value.total, dealer_value.total)
    if player_value.blackjack:
        let profit = player.bet * table.blackjack_numerator / table.blackjack_denominator
        return blackjack_model.HandSettlement(blackjack_model.BlackjackWin(), player.bet + profit, player_value.total, dealer_value.total)
    if player_value.busted:
        return blackjack_model.HandSettlement(blackjack_model.Lose(), 0, player_value.total, dealer_value.total)
    if dealer_value.busted or player_value.total > dealer_value.total:
        return blackjack_model.HandSettlement(blackjack_model.Win(), player.bet * 2, player_value.total, dealer_value.total)
    if player_value.total == dealer_value.total:
        return blackjack_model.HandSettlement(blackjack_model.Push(), player.bet, player_value.total, dealer_value.total)
    return blackjack_model.HandSettlement(blackjack_model.Lose(), 0, player_value.total, dealer_value.total)

pub fn outcome_code(value: blackjack_model.Outcome) -> Int:
    match value:
        case blackjack_model.BlackjackWin:
            return 0
        case blackjack_model.Win:
            return 1
        case blackjack_model.Push:
            return 2
        case blackjack_model.Lose:
            return 3
        case blackjack_model.Surrendered:
            return 4

pub fn outcome_name(value: blackjack_model.Outcome) -> String:
    match value:
        case blackjack_model.BlackjackWin:
            return "Blackjack"
        case blackjack_model.Win:
            return "Win"
        case blackjack_model.Push:
            return "Push"
        case blackjack_model.Lose:
            return "Lose"
        case blackjack_model.Surrendered:
            return "Surrender"
