import src.blackjack.blackjack_cards
import src.blackjack.blackjack_model
import src.blackjack.blackjack_rules
import src.blackjack.settlement
import src.blackjack.shoe
import src.blackjack.strategy
import std.collections
import std.string

struct PlayersDraw:
    players: Array[blackjack_model.Player]
    shoe: blackjack_model.Shoe

struct TurnPosition:
    found: Bool
    player_index: Int
    hand_index: Int

pub fn phase_code(value: blackjack_model.Phase) -> Int:
    match value:
        case blackjack_model.Betting:
            return 0
        case blackjack_model.PlayerTurns:
            return 1
        case blackjack_model.DealerTurn:
            return 2
        case blackjack_model.Settled:
            return 3

pub fn action_code(value: blackjack_model.Action) -> Int:
    match value:
        case blackjack_model.Hit:
            return 0
        case blackjack_model.Stand:
            return 1
        case blackjack_model.Double:
            return 2
        case blackjack_model.Split:
            return 3
        case blackjack_model.Surrender:
            return 4

pub fn action_name(value: blackjack_model.Action) -> String:
    match value:
        case blackjack_model.Hit:
            return "Hit"
        case blackjack_model.Stand:
            return "Stand"
        case blackjack_model.Double:
            return "Double"
        case blackjack_model.Split:
            return "Split"
        case blackjack_model.Surrender:
            return "Surrender"

fn replace_player(players: Array[blackjack_model.Player], index: Int, value: blackjack_model.Player) -> Array[blackjack_model.Player]:
    var updated = players
    updated[index] = value
    return updated

fn replace_hand(hands: Array[blackjack_model.Hand], index: Int, value: blackjack_model.Hand) -> Array[blackjack_model.Hand]:
    var updated = hands
    updated[index] = value
    return updated

fn update(game: blackjack_model.Game, next_shoe: blackjack_model.Shoe, dealer: blackjack_model.Hand, players: Array[blackjack_model.Player], phase: blackjack_model.Phase, active_player: Int, message: String, results: Array[blackjack_model.HandResult]) -> blackjack_model.Game:
    return blackjack_model.Game(game.rules, next_shoe, dealer, players, phase, active_player, game.round_number, game.seed, message, results)

pub fn new_game(human_name: String, starting_balance: Int, ai_count: Int, seed: Int) -> Result[blackjack_model.Game, String]:
    let table = blackjack_rules.standard()
    if ai_count < 0 or ai_count > 5:
        return Err("AI count must be between 0 and 5")
    if starting_balance < table.minimum_bet:
        return Err("Starting balance is below the table minimum")
    var players: Array[blackjack_model.Player] = []
    let no_hands: Array[blackjack_model.Hand] = []
    players = collections.append(players, blackjack_model.Player(0, human_name, true, starting_balance, 0, no_hands, 0))
    var index = 0
    while index < ai_count:
        let number = index + 1
        let ai_hands: Array[blackjack_model.Hand] = []
        players = collections.append(players, blackjack_model.Player(number, string.concat("AI ", string.from_int(number)), false, starting_balance, 0, ai_hands, 0))
        index = index + 1
    let no_results: Array[blackjack_model.HandResult] = []
    return Ok(blackjack_model.Game(table, shoe.create(table, seed), blackjack_cards.empty_hand(0, false), players, blackjack_model.Betting(), 0, 1, seed, "Place your bet", no_results))

pub fn set_bet(game: blackjack_model.Game, player_index: Int, amount: Int) -> Result[blackjack_model.Game, String]:
    if phase_code(game.phase) != 0:
        return Err("Bets can only be changed during the betting phase")
    if player_index < 0 or player_index >= collections.length(game.players):
        return Err("Invalid player index")
    if amount != 0:
        if amount < game.rules.minimum_bet:
            return Err("Bet is below the table minimum")
        if amount > game.rules.maximum_bet:
            return Err("Bet is above the table maximum")
        if amount / game.rules.bet_unit * game.rules.bet_unit != amount:
            return Err("Bet does not match the table betting unit")
    let player = game.players[player_index]
    let available = player.balance + player.pending_bet
    if amount > available:
        return Err("Player does not have enough chips")
    let changed = blackjack_model.Player(player.id, player.name, player.is_human, available - amount, amount, player.hands, player.active_hand)
    return Ok(update(game, game.shoe, game.dealer_hand, replace_player(game.players, player_index, changed), game.phase, game.active_player, "Bet updated", game.results))

fn ai_bet(player: blackjack_model.Player, table: blackjack_model.Rules, round_number: Int) -> Int:
    if player.balance < table.minimum_bet:
        return 0
    let source = player.id + round_number
    let cycle = source - source / 3 * 3
    var amount = table.minimum_bet *(cycle + 1)
    if amount > table.maximum_bet:
        amount = table.maximum_bet
    if amount > player.balance:
        amount = player.balance / table.bet_unit * table.bet_unit
    if amount < table.minimum_bet:
        return 0
    return amount

pub fn place_ai_bets(game: blackjack_model.Game) -> Result[blackjack_model.Game, String]:
    if phase_code(game.phase) != 0:
        return Err("AI bets can only be placed during the betting phase")
    var current = game
    var index = 0
    while index < collections.length(current.players):
        let player = current.players[index]
        if not player.is_human:
            current = set_bet(current, index, ai_bet(player, current.rules, current.round_number))?
        index = index + 1
    return Ok(current)

fn player_for_round(player: blackjack_model.Player) -> blackjack_model.Player:
    if player.pending_bet <= 0:
        let no_hands: Array[blackjack_model.Hand] = []
        return blackjack_model.Player(player.id, player.name, player.is_human, player.balance, 0, no_hands, 0)
    var hands: Array[blackjack_model.Hand] = []
    hands = collections.append(hands, blackjack_cards.empty_hand(player.pending_bet, false))
    return blackjack_model.Player(player.id, player.name, player.is_human, player.balance, 0, hands, 0)

fn deal_one(players: Array[blackjack_model.Player], player_index: Int, source: blackjack_model.Shoe) -> Result[PlayersDraw, String]:
    let player = players[player_index]
    if collections.length(player.hands) == 0:
        return Ok(PlayersDraw(players, source))
    let drawn = shoe.draw(source)?
    let hand = player.hands[0]
    let values = collections.append(hand.cards, drawn.card)
    let changed_hand = blackjack_model.Hand(values, hand.bet, hand.stood, hand.surrendered, hand.doubled, hand.from_split, hand.split_aces, hand.action_count, hand.finished)
    let changed_player = blackjack_model.Player(player.id, player.name, player.is_human, player.balance, player.pending_bet, replace_hand(player.hands, 0, changed_hand), player.active_hand)
    return Ok(PlayersDraw(replace_player(players, player_index, changed_player), drawn.shoe))

fn mark_naturals(players: Array[blackjack_model.Player]) -> Array[blackjack_model.Player]:
    var result = players
    var player_index = 0
    while player_index < collections.length(result):
        let player = result[player_index]
        if collections.length(player.hands) > 0:
            let hand = player.hands[0]
            if blackjack_cards.value(hand).blackjack:
                let finished = blackjack_model.Hand(hand.cards, hand.bet, hand.stood, hand.surrendered, hand.doubled, hand.from_split, hand.split_aces, hand.action_count, true)
                result = replace_player(result, player_index, blackjack_model.Player(player.id, player.name, player.is_human, player.balance, player.pending_bet, replace_hand(player.hands, 0, finished), 0))
        player_index = player_index + 1
    return result

fn first_turn(players: Array[blackjack_model.Player]) -> TurnPosition:
    var player_index = 0
    while player_index < collections.length(players):
        var hand_index = 0
        while hand_index < collections.length(players[player_index].hands):
            if not players[player_index].hands[hand_index].finished:
                return TurnPosition(true, player_index, hand_index)
            hand_index = hand_index + 1
        player_index = player_index + 1
    return TurnPosition(false, 0, 0)

fn next_turn(players: Array[blackjack_model.Player], current_player: Int, current_hand: Int) -> TurnPosition:
    var player_index = current_player
    var hand_index = current_hand + 1
    while player_index < collections.length(players):
        while hand_index < collections.length(players[player_index].hands):
            if not players[player_index].hands[hand_index].finished:
                return TurnPosition(true, player_index, hand_index)
            hand_index = hand_index + 1
        player_index = player_index + 1
        hand_index = 0
    return TurnPosition(false, 0, 0)

fn set_active_hand(players: Array[blackjack_model.Player], player_index: Int, hand_index: Int) -> Array[blackjack_model.Player]:
    let player = players[player_index]
    return replace_player(players, player_index, blackjack_model.Player(player.id, player.name, player.is_human, player.balance, player.pending_bet, player.hands, hand_index))

fn settle_game(game: blackjack_model.Game) -> blackjack_model.Game:
    var players = game.players
    var results: Array[blackjack_model.HandResult] = []
    var player_index = 0
    while player_index < collections.length(players):
        let player = players[player_index]
        var balance = player.balance
        var hand_index = 0
        while hand_index < collections.length(player.hands):
            let result = settlement.hand(player.hands[hand_index], game.dealer_hand, game.rules)
            balance = balance + result.payout
            results = collections.append(results, blackjack_model.HandResult(player_index, hand_index, result.outcome, result.payout, result.player_total, result.dealer_total))
            hand_index = hand_index + 1
        players = replace_player(players, player_index, blackjack_model.Player(player.id, player.name, player.is_human, balance, 0, player.hands, player.active_hand))
        player_index = player_index + 1
    return update(game, game.shoe, game.dealer_hand, players, blackjack_model.Settled(), 0, "Round settled", results)

pub fn start_round(game: blackjack_model.Game) -> Result[blackjack_model.Game, String]:
    if phase_code(game.phase) != 0:
        return Err("Round can only start from the betting phase")
    if game.players[0].pending_bet <= 0:
        return Err("The human player must place a bet")
    var players = game.players
    var player_index = 0
    while player_index < collections.length(players):
        players[player_index] = player_for_round(players[player_index])
        player_index = player_index + 1
    var next_shoe = shoe.prepared(game.shoe, game.rules, game.seed, game.round_number, collections.length(players))
    player_index = 0
    while player_index < collections.length(players):
        let dealt = deal_one(players, player_index, next_shoe)?
        players = dealt.players
        next_shoe = dealt.shoe
        player_index = player_index + 1
    let dealer_up = shoe.draw(next_shoe)?
    next_shoe = dealer_up.shoe
    var dealer_cards: Array[blackjack_model.Card] = []
    dealer_cards = collections.append(dealer_cards, dealer_up.card)
    player_index = 0
    while player_index < collections.length(players):
        let dealt = deal_one(players, player_index, next_shoe)?
        players = dealt.players
        next_shoe = dealt.shoe
        player_index = player_index + 1
    let dealer_hole = shoe.draw(next_shoe)?
    next_shoe = dealer_hole.shoe
    dealer_cards = collections.append(dealer_cards, dealer_hole.card)
    let dealer = blackjack_model.Hand(dealer_cards, 0, false, false, false, false, false, 0, false)
    players = mark_naturals(players)
    let position = first_turn(players)
    let no_results: Array[blackjack_model.HandResult] = []
    let base = blackjack_model.Game(game.rules, next_shoe, dealer, players, blackjack_model.PlayerTurns(), 0, game.round_number, game.seed, "Player turns", no_results)
    if blackjack_cards.value(dealer).blackjack:
        return Ok(settle_game(update(base, next_shoe, dealer, players, blackjack_model.DealerTurn(), 0, "Dealer has blackjack", no_results)))
    if not position.found:
        return Ok(settle_game(update(base, next_shoe, dealer, players, blackjack_model.DealerTurn(), 0, "Resolving naturals", no_results)))
    let active_players = set_active_hand(players, position.player_index, position.hand_index)
    return Ok(update(base, next_shoe, dealer, active_players, blackjack_model.PlayerTurns(), position.player_index, string.concat(active_players[position.player_index].name, "'s turn"), no_results))

fn has_action(actions: Array[blackjack_model.Action], code: Int) -> Bool:
    var index = 0
    while index < collections.length(actions):
        if action_code(actions[index]) == code:
            return true
        index = index + 1
    return false

fn can_double(game: blackjack_model.Game, player: blackjack_model.Player, hand: blackjack_model.Hand) -> Bool:
    if collections.length(hand.cards) != 2 or hand.action_count != 0 or player.balance < hand.bet or hand.split_aces:
        return false
    if hand.from_split and not game.rules.allow_double_after_split:
        return false
    return true

fn can_split(game: blackjack_model.Game, player: blackjack_model.Player, hand: blackjack_model.Hand) -> Bool:
    if collections.length(hand.cards) != 2 or hand.action_count != 0 or player.balance < hand.bet:
        return false
    if collections.length(player.hands) >= game.rules.max_split_hands:
        return false
    if hand.cards[0].rank != hand.cards[1].rank:
        return false
    if hand.cards[0].rank == 1 and hand.from_split and not game.rules.allow_resplit_aces:
        return false
    return true

fn can_surrender(game: blackjack_model.Game, hand: blackjack_model.Hand) -> Bool:
    return game.rules.allow_surrender and not hand.from_split and collections.length(hand.cards) == 2 and hand.action_count == 0

pub fn available_actions(game: blackjack_model.Game) -> Array[blackjack_model.Action]:
    var actions: Array[blackjack_model.Action] = []
    if phase_code(game.phase) != 1 or game.active_player < 0 or game.active_player >= collections.length(game.players):
        return actions
    let player = game.players[game.active_player]
    if player.active_hand < 0 or player.active_hand >= collections.length(player.hands):
        return actions
    let hand = player.hands[player.active_hand]
    if hand.finished:
        return actions
    actions = collections.append(actions, blackjack_model.Hit())
    actions = collections.append(actions, blackjack_model.Stand())
    if can_double(game, player, hand):
        actions = collections.append(actions, blackjack_model.Double())
    if can_split(game, player, hand):
        actions = collections.append(actions, blackjack_model.Split())
    if can_surrender(game, hand):
        actions = collections.append(actions, blackjack_model.Surrender())
    return actions

fn advance(game: blackjack_model.Game, players: Array[blackjack_model.Player]) -> blackjack_model.Game:
    let current_hand = players[game.active_player].active_hand
    let position = next_turn(players, game.active_player, current_hand)
    if position.found:
        let active_players = set_active_hand(players, position.player_index, position.hand_index)
        return update(game, game.shoe, game.dealer_hand, active_players, blackjack_model.PlayerTurns(), position.player_index, string.concat(active_players[position.player_index].name, "'s turn"), game.results)
    return update(game, game.shoe, game.dealer_hand, players, blackjack_model.DealerTurn(), 0, "Dealer turn", game.results)

fn hit_action(game: blackjack_model.Game) -> Result[blackjack_model.Game, String]:
    let player = game.players[game.active_player]
    let hand = player.hands[player.active_hand]
    let drawn = shoe.draw(game.shoe)?
    let values = collections.append(hand.cards, drawn.card)
    let temporary = blackjack_model.Hand(values, hand.bet, false, false, hand.doubled, hand.from_split, hand.split_aces, hand.action_count + 1, false)
    let hand_value = blackjack_cards.value(temporary)
    let finished = hand_value.busted or hand_value.total == 21
    let changed_hand = blackjack_model.Hand(values, hand.bet, false, false, hand.doubled, hand.from_split, hand.split_aces, hand.action_count + 1, finished)
    let changed_player = blackjack_model.Player(player.id, player.name, player.is_human, player.balance, player.pending_bet, replace_hand(player.hands, player.active_hand, changed_hand), player.active_hand)
    let changed_players = replace_player(game.players, game.active_player, changed_player)
    let changed_game = update(game, drawn.shoe, game.dealer_hand, changed_players, game.phase, game.active_player, "Card dealt", game.results)
    if finished:
        return Ok(advance(changed_game, changed_players))
    return Ok(changed_game)

fn stand_action(game: blackjack_model.Game) -> blackjack_model.Game:
    let player = game.players[game.active_player]
    let hand = player.hands[player.active_hand]
    let changed_hand = blackjack_model.Hand(hand.cards, hand.bet, true, hand.surrendered, hand.doubled, hand.from_split, hand.split_aces, hand.action_count + 1, true)
    let changed_player = blackjack_model.Player(player.id, player.name, player.is_human, player.balance, player.pending_bet, replace_hand(player.hands, player.active_hand, changed_hand), player.active_hand)
    let changed_players = replace_player(game.players, game.active_player, changed_player)
    return advance(update(game, game.shoe, game.dealer_hand, changed_players, game.phase, game.active_player, "Hand stands", game.results), changed_players)

fn surrender_action(game: blackjack_model.Game) -> blackjack_model.Game:
    let player = game.players[game.active_player]
    let hand = player.hands[player.active_hand]
    let changed_hand = blackjack_model.Hand(hand.cards, hand.bet, false, true, hand.doubled, hand.from_split, hand.split_aces, hand.action_count + 1, true)
    let changed_player = blackjack_model.Player(player.id, player.name, player.is_human, player.balance, player.pending_bet, replace_hand(player.hands, player.active_hand, changed_hand), player.active_hand)
    let changed_players = replace_player(game.players, game.active_player, changed_player)
    return advance(update(game, game.shoe, game.dealer_hand, changed_players, game.phase, game.active_player, "Hand surrendered", game.results), changed_players)

fn double_action(game: blackjack_model.Game) -> Result[blackjack_model.Game, String]:
    let player = game.players[game.active_player]
    let hand = player.hands[player.active_hand]
    let drawn = shoe.draw(game.shoe)?
    let values = collections.append(hand.cards, drawn.card)
    let changed_hand = blackjack_model.Hand(values, hand.bet * 2, false, false, true, hand.from_split, hand.split_aces, hand.action_count + 1, true)
    let changed_player = blackjack_model.Player(player.id, player.name, player.is_human, player.balance - hand.bet, player.pending_bet, replace_hand(player.hands, player.active_hand, changed_hand), player.active_hand)
    let changed_players = replace_player(game.players, game.active_player, changed_player)
    return Ok(advance(update(game, drawn.shoe, game.dealer_hand, changed_players, game.phase, game.active_player, "Bet doubled; one card dealt", game.results), changed_players))

fn split_action(game: blackjack_model.Game) -> Result[blackjack_model.Game, String]:
    let player = game.players[game.active_player]
    let hand_index = player.active_hand
    let hand = player.hands[hand_index]
    let splitting_aces = hand.cards[0].rank == 1
    let first_draw = shoe.draw(game.shoe)?
    let second_draw = shoe.draw(first_draw.shoe)?
    var first_cards: Array[blackjack_model.Card] = []
    first_cards = collections.append(first_cards, hand.cards[0])
    first_cards = collections.append(first_cards, first_draw.card)
    var second_cards: Array[blackjack_model.Card] = []
    second_cards = collections.append(second_cards, hand.cards[1])
    second_cards = collections.append(second_cards, second_draw.card)
    let auto_finish = splitting_aces and not game.rules.allow_resplit_aces
    let first_hand = blackjack_model.Hand(first_cards, hand.bet, false, false, false, true, splitting_aces, 0, auto_finish)
    let second_hand = blackjack_model.Hand(second_cards, hand.bet, false, false, false, true, splitting_aces, 0, auto_finish)
    var hands = replace_hand(player.hands, hand_index, first_hand)
    hands = collections.insert(hands, hand_index + 1, second_hand)
    let changed_player = blackjack_model.Player(player.id, player.name, player.is_human, player.balance - hand.bet, player.pending_bet, hands, hand_index)
    let changed_players = replace_player(game.players, game.active_player, changed_player)
    let changed_game = update(game, second_draw.shoe, game.dealer_hand, changed_players, game.phase, game.active_player, "Pair split into two hands", game.results)
    if auto_finish:
        return Ok(advance(changed_game, changed_players))
    return Ok(changed_game)

pub fn apply_action(game: blackjack_model.Game, action: blackjack_model.Action) -> Result[blackjack_model.Game, String]:
    if phase_code(game.phase) != 1:
        return Err("Actions are only legal during player turns")
    let actions = available_actions(game)
    let code = action_code(action)
    if not has_action(actions, code):
        return Err("That action is not legal for the current hand")
    if code == 0:
        return hit_action(game)
    if code == 1:
        return Ok(stand_action(game))
    if code == 2:
        return double_action(game)
    if code == 3:
        return split_action(game)
    return Ok(surrender_action(game))

pub fn dealer_up_card(game: blackjack_model.Game) -> Result[blackjack_model.Card, String]:
    if collections.length(game.dealer_hand.cards) == 0:
        return Err("Dealer has no up card")
    return Ok(game.dealer_hand.cards[0])

pub fn dealer_should_hit(hand: blackjack_model.Hand, table: blackjack_model.Rules) -> Bool:
    let value = blackjack_cards.value(hand)
    if value.busted or value.total > 17:
        return false
    if value.total < 17:
        return true
    return value.soft and table.dealer_hits_soft_17

fn live_hand(players: Array[blackjack_model.Player]) -> Bool:
    var player_index = 0
    while player_index < collections.length(players):
        var hand_index = 0
        while hand_index < collections.length(players[player_index].hands):
            let hand = players[player_index].hands[hand_index]
            let value = blackjack_cards.value(hand)
            if not hand.surrendered and not value.busted and not value.blackjack:
                return true
            hand_index = hand_index + 1
        player_index = player_index + 1
    return false

pub fn dealer_step(game: blackjack_model.Game) -> Result[blackjack_model.Game, String]:
    if phase_code(game.phase) != 2:
        return Err("Dealer can only act during the dealer phase")
    if not live_hand(game.players) or not dealer_should_hit(game.dealer_hand, game.rules):
        return Ok(settle_game(game))
    let drawn = shoe.draw(game.shoe)?
    let values = collections.append(game.dealer_hand.cards, drawn.card)
    let dealer = blackjack_model.Hand(values, 0, false, false, false, false, false, game.dealer_hand.action_count + 1, false)
    let changed = update(game, drawn.shoe, dealer, game.players, blackjack_model.DealerTurn(), 0, "Dealer draws", game.results)
    if dealer_should_hit(dealer, game.rules):
        return Ok(changed)
    return Ok(settle_game(changed))

pub fn play_dealer_to_end(game: blackjack_model.Game) -> Result[blackjack_model.Game, String]:
    var current = game
    var guard = 0
    while phase_code(current.phase) == 2 and guard < 20:
        current = dealer_step(current)?
        guard = guard + 1
    if phase_code(current.phase) == 2:
        return Err("Dealer turn exceeded the safety limit")
    return Ok(current)

pub fn choose_basic_action(game: blackjack_model.Game) -> Result[blackjack_model.Action, String]:
    if phase_code(game.phase) != 1:
        return Err("Basic strategy requires an active player hand")
    let player = game.players[game.active_player]
    let up_card = dealer_up_card(game)?
    return strategy.choose(player.hands[player.active_hand], up_card, available_actions(game))

pub fn active_player_is_human(game: blackjack_model.Game) -> Bool:
    return phase_code(game.phase) == 1 and game.players[game.active_player].is_human

pub fn ai_step(game: blackjack_model.Game) -> Result[blackjack_model.Game, String]:
    if phase_code(game.phase) != 1:
        return Err("AI can only act during player turns")
    if game.players[game.active_player].is_human:
        return Err("The active player is human")
    return apply_action(game, choose_basic_action(game)?)

pub fn run_ai_until_human_or_dealer(game: blackjack_model.Game) -> Result[blackjack_model.Game, String]:
    var current = game
    var guard = 0
    while phase_code(current.phase) == 1:
        if active_player_is_human(current):
            return Ok(current)
        if guard >= 200:
            return Err("AI turn loop exceeded the safety limit")
        current = ai_step(current)?
        guard = guard + 1
    return Ok(current)

pub fn begin_next_round(game: blackjack_model.Game) -> Result[blackjack_model.Game, String]:
    if phase_code(game.phase) != 3:
        return Err("The current round has not been settled")
    var players = game.players
    var index = 0
    while index < collections.length(players):
        let player = players[index]
        let no_hands: Array[blackjack_model.Hand] = []
        players[index] = blackjack_model.Player(player.id, player.name, player.is_human, player.balance, 0, no_hands, 0)
        index = index + 1
    let no_results: Array[blackjack_model.HandResult] = []
    return Ok(blackjack_model.Game(game.rules, game.shoe, blackjack_cards.empty_hand(0, false), players, blackjack_model.Betting(), 0, game.round_number + 1, game.seed, "Place your bet", no_results))

pub fn available_action_names(game: blackjack_model.Game) -> Array[String]:
    let actions = available_actions(game)
    var names: Array[String] = []
    var index = 0
    while index < collections.length(actions):
        names = collections.append(names, action_name(actions[index]))
        index = index + 1
    return names

pub fn instruction(game: blackjack_model.Game) -> String:
    let phase = phase_code(game.phase)
    if phase == 0:
        return "Choose a legal bet, then start the round"
    if phase == 1:
        if game.players[game.active_player].is_human:
            return string.concat("Your options: ", collections.join(available_action_names(game), " | "))
        return string.concat(game.players[game.active_player].name, " is choosing an action")
    if phase == 2:
        return "Dealer is drawing to the table rule"
    return "Round complete; review results or begin the next round"

pub fn chips_for(amount: Int) -> blackjack_model.ChipStack:
    var remaining = amount
    let purple = remaining / 500
    remaining = remaining - purple * 500
    let black = remaining / 100
    remaining = remaining - black * 100
    let green = remaining / 25
    remaining = remaining - green * 25
    let blue = remaining / 10
    remaining = remaining - blue * 10
    let red = remaining / 5
    remaining = remaining - red * 5
    return blackjack_model.ChipStack(amount, purple, black, green, blue, red, remaining)
