fn empty_tables() -> TableResources:
    let missing = rocket_raylib.Texture(0, 0, 0)
    return TableResources(missing, false, missing, false, missing, false, missing, false, missing, false, missing, false, missing, false, empty_blackjack())

fn empty_blackjack() -> BlackjackPremiumResources:
    let missing = rocket_raylib.Texture(0, 0, 0)
    return BlackjackPremiumResources(missing, false, missing, false, missing, false, missing, false, missing, false, rocket_raylib.Font(0), false, rocket_raylib.Font(0), false)

fn empty_group_three() -> GroupThreeResources:
    let missing = rocket_raylib.Texture(0, 0, 0)
    return GroupThreeResources(missing, false, missing, false, missing, false, missing, false, missing, false, missing, false, missing, false, missing, false)

fn empty_group_four() -> GroupFourResources:
    let missing = rocket_raylib.Texture(0, 0, 0)
    return GroupFourResources(missing, false, missing, false, missing, false, missing, false, missing, false)

pub fn empty() -> UiResources:
    let missing = rocket_raylib.Texture(0, 0, 0)
    return UiResources(rocket_raylib.Font(0), false, missing, false, missing, false, missing, false, missing, false, missing, false, missing, false, missing, false, missing, false, missing, false, missing, false, missing, false, missing, false, missing, false, empty_tables(), empty_group_three(), empty_group_four(), "Procedural visual fallback active")

pub fn load_from_paths(window: rocket_raylib.Window, font_path: String, atlas_a_path: String, atlas_b_path: String) -> UiResources:
    var font = rocket_raylib.Font(0)
    var font_ready = false
    var atlas_a = rocket_raylib.Texture(0, 0, 0)
    var atlas_a_ready = false
    var atlas_b = rocket_raylib.Texture(0, 0, 0)
    var atlas_b_ready = false
    match rocket_raylib.load_font(window, font_path):
        case Ok(loaded):
            font = loaded
            font_ready = true
        case Err(error):
            let expected = error
    match rocket_raylib.load_texture(window, atlas_a_path):
        case Ok(loaded):
            atlas_a = loaded
            atlas_a_ready = true
        case Err(error):
            let expected = error
    match rocket_raylib.load_texture(window, atlas_b_path):
        case Ok(loaded):
            atlas_b = loaded
            atlas_b_ready = true
        case Err(error):
            let expected = error
    var message = "Some visual resources unavailable; procedural fallback active"
    if font_ready and atlas_a_ready and atlas_b_ready:
        message = "Original artwork and bundled typography loaded"
    let missing = rocket_raylib.Texture(0, 0, 0)
    return UiResources(font, font_ready, atlas_a, atlas_a_ready, atlas_b, atlas_b_ready, missing, false, missing, false, missing, false, missing, false, missing, false, missing, false, missing, false, missing, false, missing, false, missing, false, missing, false, empty_tables(), empty_group_three(), empty_group_four(), message)

fn try_texture(window: rocket_raylib.Window, path: String) -> rocket_raylib.Texture:
    match rocket_raylib.load_texture(window, path):
        case Ok(texture):
            return texture
        case Err(error):
            let expected = error
            return rocket_raylib.Texture(0, 0, 0)

fn texture_ready(texture: rocket_raylib.Texture) -> Bool:
    return texture.id > 0 and texture.width > 0 and texture.height > 0

fn try_font(window: rocket_raylib.Window, path: String) -> rocket_raylib.Font:
    match rocket_raylib.load_font(window, path):
        case Ok(font):
            return font
        case Err(error):
            let expected = error
            return rocket_raylib.Font(0)

fn font_ready(font: rocket_raylib.Font) -> Bool:
    return font.id > 0

pub fn load(window: rocket_raylib.Window) -> UiResources:
    let shared = load_from_paths(window, "assets/fonts/manrope/Manrope-Medium.ttf", "assets/ui/scroll2roll-cover-atlas-a.png", "assets/ui/scroll2roll-cover-atlas-b.png")
    let midnight_city = try_texture(window, "assets/games/group1-v1/midnight-city-base.png")
    let midnight_car_coral = try_texture(window, "assets/games/group1-v1/midnight-car-coral.png")
    let midnight_car_cyan = try_texture(window, "assets/games/group1-v1/midnight-car-cyan.png")
    let midnight_tram = try_texture(window, "assets/games/group1-v1/midnight-tram.png")
    let midnight_raft = try_texture(window, "assets/games/group1-v1/midnight-log-raft.png")
    let chicken_explorer = try_texture(window, "assets/games/group1-v1/chicken-explorer-topdown.png")
    let crash_flight = try_texture(window, "assets/games/group1-v1/crash-flight-background.png")
    let crash_rocket = try_texture(window, "assets/games/group1-v1/crash-rocket.png")
    let crash_burst = try_texture(window, "assets/games/group1-v1/crash-vfx-burst.png")
    let coop_observatory = try_texture(window, "assets/games/group1-v1/coop-observatory-background.png")
    let coop_platform = try_texture(window, "assets/games/group1-v1/coop-climb-platform.png")
    let blackjack_room = try_texture(window, "assets/games/group2-v1/blackjack-room-background.png")
    let blackjack_shoe = try_texture(window, "assets/games/group2-v1/blackjack-dealing-shoe.png")
    let casino_chips = try_texture(window, "assets/games/group2-v1/casino-chip-stack.png")
    let holdem_lounge = try_texture(window, "assets/games/group2-v1/holdem-lounge-background.png")
    let holdem_props = try_texture(window, "assets/games/group2-v1/holdem-props-atlas.png")
    let roulette_room = try_texture(window, "assets/games/group2-v1/roulette-room-background.png")
    let roulette_wheel = try_texture(window, "assets/games/group2-v1/roulette-wheel.png")
    let blackjack_scene = try_texture(window, "assets/games/blackjack-reference-v1/blackjack-permanent-scene-1280x720.png")
    let blackjack_cards = try_texture(window, "assets/games/blackjack-reference-v1/blackjack-cards-atlas.png")
    let blackjack_chips = try_texture(window, "assets/games/blackjack-reference-v1/blackjack-chips-atlas.png")
    let blackjack_components = try_texture(window, "assets/games/blackjack-reference-v1/blackjack-components-atlas.png")
    let blackjack_icons = try_texture(window, "assets/games/blackjack-reference-v1/blackjack-icons-atlas.png")
    let blackjack_inter = try_font(window, "assets/games/blackjack-reference-v1/Inter-SemiBold.otf")
    let blackjack_garamond = try_font(window, "assets/games/blackjack-reference-v1/EBGaramond12-Regular.ttf")
    let blackjack = BlackjackPremiumResources(blackjack_scene, texture_ready(blackjack_scene), blackjack_cards, texture_ready(blackjack_cards), blackjack_chips, texture_ready(blackjack_chips), blackjack_components, texture_ready(blackjack_components), blackjack_icons, texture_ready(blackjack_icons), blackjack_inter, font_ready(blackjack_inter), blackjack_garamond, font_ready(blackjack_garamond))
    let tables = TableResources(blackjack_room, texture_ready(blackjack_room), blackjack_shoe, texture_ready(blackjack_shoe), casino_chips, texture_ready(casino_chips), holdem_lounge, texture_ready(holdem_lounge), holdem_props, texture_ready(holdem_props), roulette_room, texture_ready(roulette_room), roulette_wheel, texture_ready(roulette_wheel), blackjack)
    let slots_arcade = try_texture(window, "assets/games/group3-v1/slots-arcade-background.png")
    let slots_cabinet = try_texture(window, "assets/games/group3-v1/slots-cabinet.png")
    let slots_symbols = try_texture(window, "assets/games/group3-v1/slots-symbols-exact.png")
    let plinko_chamber = try_texture(window, "assets/games/group3-v1/plinko-chamber-background.png")
    let plinko_enclosure = try_texture(window, "assets/games/group3-v1/plinko-enclosure.png")
    let mines_cavern = try_texture(window, "assets/games/group3-v1/mines-cavern-background.png")
    let mines_mine = try_texture(window, "assets/games/group3-v1/mines-mechanical-mine.png")
    let mines_tiles = try_texture(window, "assets/games/group3-v1/mines-tile-state-atlas.png")
    let group_three = GroupThreeResources(slots_arcade, texture_ready(slots_arcade), slots_cabinet, texture_ready(slots_cabinet), slots_symbols, texture_ready(slots_symbols), plinko_chamber, texture_ready(plinko_chamber), plinko_enclosure, texture_ready(plinko_enclosure), mines_cavern, texture_ready(mines_cavern), mines_mine, texture_ready(mines_mine), mines_tiles, texture_ready(mines_tiles))
    let dice_vault = try_texture(window, "assets/games/group4-v1/dice-vault-background.png")
    let dice_signal_display = try_texture(window, "assets/games/group4-v1/dice-signal-display.png")
    let hilo_room = try_texture(window, "assets/games/group4-v1/hilo-prediction-room.png")
    let hilo_card_tray = try_texture(window, "assets/games/group4-v1/hilo-card-tray.png")
    let hilo_effects = try_texture(window, "assets/games/group4-v1/hilo-effects-atlas.png")
    let group_four = GroupFourResources(dice_vault, texture_ready(dice_vault), dice_signal_display, texture_ready(dice_signal_display), hilo_room, texture_ready(hilo_room), hilo_card_tray, texture_ready(hilo_card_tray), hilo_effects, texture_ready(hilo_effects))
    var message = shared.message
    if texture_ready(midnight_city) and texture_ready(midnight_car_coral) and texture_ready(midnight_car_cyan) and texture_ready(midnight_tram) and texture_ready(midnight_raft) and texture_ready(chicken_explorer) and texture_ready(crash_flight) and texture_ready(crash_rocket) and texture_ready(crash_burst) and texture_ready(coop_observatory) and texture_ready(coop_platform):
        message = "Group 1 artwork and shared resources loaded"
    if tables.blackjack_room_ready and tables.blackjack_shoe_ready and tables.casino_chips_ready and tables.holdem_lounge_ready and tables.holdem_props_ready and tables.roulette_room_ready and tables.roulette_wheel_ready:
        message = "Group 1 and Group 2 artwork with shared resources loaded"
    if blackjack.scene_ready and blackjack.cards_ready and blackjack.chips_ready and blackjack.components_ready and blackjack.icons_ready and blackjack.inter_ready and blackjack.garamond_ready:
        message = "Blackjack authority artwork and bundled typography loaded"
    if group_three.slots_arcade_ready and group_three.slots_cabinet_ready and group_three.slots_symbols_ready and group_three.plinko_chamber_ready and group_three.plinko_enclosure_ready and group_three.mines_cavern_ready and group_three.mines_mine_ready and group_three.mines_tiles_ready:
        message = "Groups 1-3 artwork with shared resources loaded"
    if group_four.dice_vault_ready and group_four.dice_signal_display_ready and group_four.hilo_room_ready and group_four.hilo_card_tray_ready and group_four.hilo_effects_ready:
        message = "Groups 1-4 artwork with shared resources loaded"
    return UiResources(shared.font, shared.font_ready, shared.atlas_a, shared.atlas_a_ready, shared.atlas_b, shared.atlas_b_ready, midnight_city, texture_ready(midnight_city), midnight_car_coral, texture_ready(midnight_car_coral), midnight_car_cyan, texture_ready(midnight_car_cyan), midnight_tram, texture_ready(midnight_tram), midnight_raft, texture_ready(midnight_raft), chicken_explorer, texture_ready(chicken_explorer), crash_flight, texture_ready(crash_flight), crash_rocket, texture_ready(crash_rocket), crash_burst, texture_ready(crash_burst), coop_observatory, texture_ready(coop_observatory), coop_platform, texture_ready(coop_platform), tables, group_three, group_four, message)

pub fn ready(value: UiResources) -> Bool:
    return value.font_ready and value.atlas_a_ready and value.atlas_b_ready

