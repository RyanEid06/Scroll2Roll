    crash_accumulator: Float
    slots: slots_api.Session
    slots_help: Bool
    slots_reel_stage: Int
    slots_animation_end: Float

fn rebuild(state: State, screen: Int, game: blackjack_model.Game, selected_bet: Int, settings: persistence.Settings, notice: String, error: String, exit_prompt: Bool, running: Bool, next_step: Float, saved_round: Int) -> State:
    return State(screen, game, state.roulette, selected_bet, settings, state.save_path, notice, error, exit_prompt, running, next_step, saved_round, state.roulette_kind, state.roulette_target, state.roulette_help, state.roulette_spin_end, state.plinko, state.plinko_help, state.plinko_stage, state.plinko_next_step, state.chicken, state.chicken_help, state.crossing, state.crossing_help, state.crossing_accumulator, state.holdem, state.holdem_help, state.holdem_target, state.mines, state.mines_help, state.mines_selected, state.mines_animation_end, state.dice, state.dice_help, state.dice_animation_end, state.hilo, state.hilo_help, state.hilo_animation_end, state.crash, state.crash_help, state.crash_accumulator, state.slots, state.slots_help, state.slots_reel_stage, state.slots_animation_end)

fn new_table(settings: persistence.Settings, seed: Int) -> Result[blackjack_model.Game, String]:
    let game = blackjack_engine.new_game("Player", settings.play_balance, settings.ai_count, seed)?
    return blackjack_engine.set_bet(game, 0, game.rules.minimum_bet)

fn holdem_ai_count(settings: persistence.Settings) -> Int:
    if settings.ai_count < 1:
        return 1
    return settings.ai_count

fn initial(settings: persistence.Settings, save_path: String, notice: String) -> Result[State, String]:
    let game = new_table(settings, 20260808)?
    let roulette = roulette_api.new_session(settings.play_balance, 20260809)?
    let plinko = plinko_api.new_session(settings.play_balance, 20260810)?
    let chicken = chicken_api.new_session(settings.play_balance, 20260811)?
    let crossing = crossing_api.new_session(settings.play_balance, 20260812)?
    let holdem = holdem_api.new_session(settings.play_balance, holdem_ai_count(settings), 20260813)?
    let mines = mines_api.new_session(settings.play_balance, 20260814)?
    let dice = dice_api.new_session(settings.play_balance, 20260815)?
    let hilo = hilo_api.new_session(settings.play_balance, 20260816)?
    let crash = crash_api.new_session(settings.play_balance, 20260817)?
    let slots = slots_api.new_session(settings.play_balance, 20260818)?
    return Ok(State(0, game, roulette, game.rules.minimum_bet, settings, save_path, notice, "", false, true, 0.0, 0, 0, 0, false, 0.0, plinko, false, 0, 0.0, chicken, false, crossing, false, 0.0, holdem, false, 10, mines, false, 0, 0.0, dice, false, 0.0, hilo, false, 0.0, crash, false, 0.0, slots, false, 0, 0.0))

fn save_settings(state: State, settings: persistence.Settings) -> State:
    match persistence.save(state.save_path, settings):
        case Ok(saved):
            return rebuild(state, state.screen, state.game, state.selected_bet, settings, "Settings saved locally", "", state.exit_prompt, state.running, state.next_step, state.saved_round)
        case Err(error):
            return rebuild(state, state.screen, state.game, state.selected_bet, settings, state.notice, error, state.exit_prompt, state.running, state.next_step, state.saved_round)

fn with_game(state: State, game: blackjack_model.Game, next_step: Float) -> State:
    return rebuild(state, state.screen, game, state.selected_bet, state.settings, state.notice, "", state.exit_prompt, state.running, next_step, state.saved_round)

