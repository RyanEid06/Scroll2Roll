            return with_slots(entered, session, 5, 0.0)
        case Err(error):
            return with_error(state, error)

fn route_game(state: State, index: Int) -> State:
    if index == 0 and registry.available(index):
        return enter_game(state, 20260808 + index)
    if index == 1 and registry.available(index):
        return enter_roulette(state, 20260808 + index)
    if index == 2 and registry.available(index):
        return enter_plinko(state, 20260808 + index)
    if index == 3 and registry.available(index):
        return enter_chicken(state, 20260808 + index)
    if index == 4 and registry.available(index):
        return enter_crossing(state, 20260808 + index)
    if index == 5 and registry.available(index):
        return enter_holdem(state, 20260808 + index)
    if index == 6 and registry.available(index):
        return enter_mines(state, 20260808 + index)
    if index == 7 and registry.available(index):
        return enter_dice(state, 20260808 + index)
    if index == 8 and registry.available(index):
        return enter_hilo(state, 20260808 + index)
    if index == 9 and registry.available(index):
        return enter_crash(state, 20260808 + index)
    if index == 10 and registry.available(index):
        return enter_slots(state, 20260808 + index)
    return rebuild(state, state.screen, state.game, state.selected_bet, state.settings, "That game is a future placeholder", "", state.exit_prompt, state.running, state.next_step, state.saved_round)

fn change_bet(state: State, delta: Int) -> State:
    let player = state.game.players[0]
    let available = player.balance + player.pending_bet
    var amount = state.selected_bet + delta
    if amount < state.game.rules.minimum_bet:
        amount = state.game.rules.minimum_bet
    if amount > state.game.rules.maximum_bet:
        amount = state.game.rules.maximum_bet
    if amount > available:
        amount = available / state.game.rules.bet_unit * state.game.rules.bet_unit
    match blackjack_engine.set_bet(state.game, 0, amount):
        case Ok(game):
            return rebuild(state, state.screen, game, amount, state.settings, "Bet changed", "", state.exit_prompt, state.running, state.next_step, state.saved_round)
        case Err(error):
            return with_error(state, error)

fn deal(state: State, now: Float) -> State:
    match blackjack_engine.place_ai_bets(state.game):
        case Ok(with_ai_bets):
            match blackjack_engine.start_round(with_ai_bets):
                case Ok(game):
                    return with_game(state, game, now + theme.turn_delay_seconds())
                case Err(error):
                    return with_error(state, error)
        case Err(error):
            return with_error(state, error)

fn apply_action_code(state: State, code: Int, now: Float) -> State:
    let actions = blackjack_engine.available_actions(state.game)
    var index = 0
    while index < actions.length():
        if blackjack_engine.action_code(actions[index]) == code:
            match blackjack_engine.apply_action(state.game, actions[index]):
                case Ok(game):
                    return with_game(state, game, now + theme.turn_delay_seconds())
                case Err(error):
                    return with_error(state, error)
        index = index + 1
    return with_error(state, "That action is not legal for the active hand")

fn next_round(state: State) -> State:
    match blackjack_engine.begin_next_round(state.game):
        case Ok(game):
            match blackjack_engine.set_bet(game, 0, game.rules.minimum_bet):
                case Ok(with_bet):
                    return rebuild(state, 2, with_bet, with_bet.rules.minimum_bet, state.settings, "New round ready", "", false, true, 0.0, state.saved_round)
                case Err(error):
                    return with_error(state, error)
        case Err(error):
            return with_error(state, error)

fn restart_table(state: State) -> State:
    let current_balance = state.game.players[0].balance + state.game.players[0].pending_bet
    let settings = persistence.with_balance(state.settings, current_balance)
    match new_table(settings, state.game.seed + state.game.round_number * 104729):
        case Ok(game):
            return save_settings(rebuild(state, 2, game, game.rules.minimum_bet, settings, "Table restarted", "", false, true, 0.0, state.saved_round), settings)
        case Err(error):
            return with_error(state, error)

fn return_to_lobby(state: State) -> State:
    let balance = state.game.players[0].balance + state.game.players[0].pending_bet
    let settings = persistence.with_balance(state.settings, balance)
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "Progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn settings_audio(state: State) -> State:
    return save_settings(state, persistence.with_audio(state.settings, not state.settings.audio_enabled))

fn settings_volume(state: State, delta: Int) -> State:
    return save_settings(state, persistence.with_volume(state.settings, state.settings.volume_percent + delta))

fn settings_ai(state: State, delta: Int) -> State:
    return save_settings(state, persistence.with_ai_count(state.settings, state.settings.ai_count + delta))

fn settings_theme(state: State) -> State:
    return save_settings(state, persistence.with_theme(state.settings, not state.settings.light_mode))

fn settings_motion(state: State) -> State:
    return save_settings(state, persistence.with_reduced_motion(state.settings, not state.settings.reduced_motion))

fn update_lobby(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    let focus = shell_view.lobby_focus(state.screen)
    let columns = shell_view.lobby_columns(width)
    let capacity = shell_view.lobby_capacity(width, height)
    var next_focus = focus
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_tab()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()):
        next_focus = focus + 1
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()):
        next_focus = focus - 1
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()):
        next_focus = focus + columns
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()):
        next_focus = focus - columns
    let wheel = rocket_raylib.mouse_wheel(window)
    if wheel < 0.0:
        next_focus = focus + capacity
    if wheel > 0.0:
        next_focus = focus - capacity
    if next_focus < 0:
        next_focus = 0
    if next_focus >= registry.game_count():
        next_focus = registry.game_count() - 1
    if next_focus != focus:
        return rebuild(state, shell_view.lobby_screen(next_focus), state.game, state.selected_bet, state.settings, "Keyboard focus moved", "", false, true, state.next_step, state.saved_round)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()):
        return route_game(state, focus)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_l()):
        return route_game(state, 0)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()):
        return rebuild(state, 3, state.game, state.selected_bet, state.settings, "Settings", "", false, true, state.next_step, state.saved_round)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(shell_view.exit_rect(width, height), mouse_x, mouse_y):
        return rebuild(state, state.screen, state.game, state.selected_bet, state.settings, state.notice, "", true, state.running, state.next_step, state.saved_round)
    if clicked:
        let page = shell_view.lobby_page(focus, width, height)
        let pages = shell_view.lobby_page_count(width, height)
        if page > 0 and components.contains(shell_view.previous_page_rect(width, height), mouse_x, mouse_y):
            return rebuild(state, shell_view.lobby_screen((page - 1) * capacity), state.game, state.selected_bet, state.settings, "Previous game shelf", "", false, true, state.next_step, state.saved_round)
        if page + 1 < pages and components.contains(shell_view.next_page_rect(width, height), mouse_x, mouse_y):
            return rebuild(state, shell_view.lobby_screen((page + 1) * capacity), state.game, state.selected_bet, state.settings, "Next game shelf", "", false, true, state.next_step, state.saved_round)
        var index = page * capacity
        while index < registry.game_count() and index <(page + 1) * capacity:
            if components.contains(shell_view.lobby_card_rect(index, width, height), mouse_x, mouse_y):
                return route_game(state, index)
            index = index + 1
    return state

fn update_settings(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_m()):
        return settings_audio(state)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_t()):
        return settings_theme(state)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()):
        return settings_motion(state)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()):
        return settings_volume(state, -10)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()):
        return settings_volume(state, 10)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()):
        return settings_ai(state, -1)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()):
        return settings_ai(state, 1)
    if clicked:
        if components.contains(shell_view.setting_control_rect(0, 0, width, height), mouse_x, mouse_y):
            return settings_theme(state)
        if components.contains(shell_view.setting_control_rect(1, 0, width, height), mouse_x, mouse_y):
            return settings_motion(state)
        if components.contains(shell_view.setting_control_rect(2, 0, width, height), mouse_x, mouse_y):
            return settings_audio(state)
        if components.contains(shell_view.setting_control_rect(3, 0, width, height), mouse_x, mouse_y):
            return settings_volume(state, -10)
        if components.contains(shell_view.setting_control_rect(3, 1, width, height), mouse_x, mouse_y):
            return settings_volume(state, 10)
        let slider = shell_view.settings_slider_rect(width, height)
        if components.contains(slider, mouse_x, mouse_y):
            return settings_volume(state,(mouse_x - slider.x) * 100 / slider.width - state.settings.volume_percent)
        if components.contains(shell_view.setting_control_rect(4, 0, width, height), mouse_x, mouse_y):
            return settings_ai(state, -1)
        if components.contains(shell_view.setting_control_rect(4, 1, width, height), mouse_x, mouse_y):
            return settings_ai(state, 1)
    return state

fn update_game(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int, now: Float) -> State:
    let phase = blackjack_engine.phase_code(state.game.phase)
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()) or clicked and components.contains(blackjack_view.bet_minus_rect(width, height), mouse_x, mouse_y):
            return change_bet(state, 10 - 20)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()) or clicked and components.contains(blackjack_view.bet_plus_rect(width, height), mouse_x, mouse_y):
            return change_bet(state, 10)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(blackjack_view.deal_rect(width, height), mouse_x, mouse_y):
            return deal(state, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()):
            return return_to_lobby(state)
    if phase == 1 and blackjack_engine.active_player_is_human(state.game):
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_h()):
            return apply_action_code(state, 0, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()):
            return apply_action_code(state, 1, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_d()):
            return apply_action_code(state, 2, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()):
            return apply_action_code(state, 3, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()):
            return apply_action_code(state, 4, now)
        if clicked:
            var code = 0
            while code < 5:
                if components.contains(blackjack_view.action_rect(code, width, height), mouse_x, mouse_y):
                    return apply_action_code(state, code, now)
                code = code + 1
    if phase == 1 and not blackjack_engine.active_player_is_human(state.game) and now >= state.next_step:
        match blackjack_engine.ai_step(state.game):
            case Ok(game):
                return with_game(state, game, now + theme.turn_delay_seconds())
            case Err(error):
                return with_error(state, error)
    if phase == 2 and now >= state.next_step:
        match blackjack_engine.dealer_step(state.game):
            case Ok(game):
                return with_game(state, game, now + theme.turn_delay_seconds())
            case Err(error):
                return with_error(state, error)
    if phase == 3:
        var settled_state = state
        if state.saved_round != state.game.round_number:
            let settings = persistence.with_balance(state.settings, state.game.players[0].balance)
            settled_state = save_settings(rebuild(state, state.screen, state.game, state.selected_bet, settings, "Round progress saved", "", state.exit_prompt, state.running, state.next_step, state.game.round_number), settings)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(blackjack_view.next_rect(width, height), mouse_x, mouse_y):
            return next_round(settled_state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()) or clicked and components.contains(blackjack_view.restart_rect(width, height), mouse_x, mouse_y):
            return restart_table(settled_state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(blackjack_view.lobby_rect(width, height), mouse_x, mouse_y):
            return return_to_lobby(settled_state)
        return settled_state
    return state

fn roulette_chip(current: Int, direction: Int) -> Int:
    let values = [5, 10, 25, 50, 100, 500]
    var index = 0
    while index < collections.length(values):
        if values[index] == current:
            var next = index + direction
            if next < 0:
                next = collections.length(values) - 1
            if next >= collections.length(values):
                next = 0
            return values[next]
        index = index + 1
    return 10

fn roulette_select_chip(state: State, amount: Int) -> State:
    match roulette_api.with_selected_chip(state.roulette, amount):
        case Ok(session):
            return with_roulette(state, session, state.roulette_spin_end)
        case Err(error):
            return with_error(state, error)

fn roulette_change_focus(state: State, kind_delta: Int, target_delta: Int) -> State:
    var kind = state.roulette_kind + kind_delta
    if kind < 0:
        kind = 13
    if kind > 13:
        kind = 0
    var target = state.roulette_target
    if kind_delta != 0:
        target = 0
    else:
        target = target + target_delta
    let count = roulette_view.focus_count(kind)
    if target < 0:
        target = count - 1
    if target >= count:
        target = 0
    return roulette_focus(state, kind, target)

fn roulette_place_focus(state: State) -> State:
    match roulette_view.focus_bet(state.roulette_kind, state.roulette_target, state.roulette.game.selected_chip):
        case Ok(bet):
            match roulette_api.with_bet(state.roulette, bet):
                case Ok(session):
                    return with_roulette(state, session, state.roulette_spin_end)
                case Err(error):
                    return with_error(state, error)
        case Err(error):
            return with_error(state, error)

fn roulette_place_mouse(state: State, mouse_x: Int, mouse_y: Int, width: Int, height: Int) -> State:
    match roulette_view.mouse_bet(mouse_x, mouse_y, width, height, state.roulette.game.selected_chip):
        case Ok(bet):
            match roulette_api.with_bet(state.roulette, bet):
                case Ok(session):
                    return with_roulette(state, session, state.roulette_spin_end)
                case Err(error):
                    return with_error(state, error)
        case Err(error):
            return state

fn roulette_return_to_lobby(state: State) -> State:
    if roulette_api.phase_code(state.roulette.game) == 1 or roulette_api.phase_code(state.roulette.game) == 0 and collections.length(state.roulette.game.bets) > 0:
        return with_error(state, "Settle the spin or clear live Roulette bets before leaving")
    let settings = persistence.with_balance(state.settings, state.roulette.game.balance)
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "Roulette progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn update_roulette(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int, now: Float) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()) or clicked and components.contains(roulette_view.help_rect(width, height), mouse_x, mouse_y):
        return roulette_help(state, not state.roulette_help)
    if state.roulette_help:
        return state
    let phase = roulette_api.phase_code(state.roulette.game)
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_tab()):
            return roulette_change_focus(state, 1, 0)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()):
            return roulette_change_focus(state, 0, -1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()):
            return roulette_change_focus(state, 0, 1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()):
            return roulette_select_chip(state, roulette_chip(state.roulette.game.selected_chip, 1))
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()):
            return roulette_select_chip(state, roulette_chip(state.roulette.game.selected_chip, -1))
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()):
            return roulette_place_focus(state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_h()) or clicked and components.contains(roulette_view.undo_rect(width, height), mouse_x, mouse_y):
            match roulette_api.with_undo(state.roulette):
                case Ok(session):
                    return with_roulette(state, session, state.roulette_spin_end)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_d()) or clicked and components.contains(roulette_view.clear_rect(width, height), mouse_x, mouse_y):
            match roulette_api.with_clear(state.roulette):
                case Ok(session):
                    return with_roulette(state, session, state.roulette_spin_end)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()) or clicked and components.contains(roulette_view.repeat_rect(width, height), mouse_x, mouse_y):
            match roulette_api.with_repeat(state.roulette):
                case Ok(session):
                    return with_roulette(state, session, state.roulette_spin_end)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()) or clicked and components.contains(roulette_view.spin_rect(width, height), mouse_x, mouse_y):
            match roulette_api.with_spin(state.roulette):
                case Ok(session):
                    return with_roulette(state, session, now + 2.0)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()):
            return roulette_return_to_lobby(state)
        if clicked:
            var chip_index = 0
            while chip_index < 6:
                if components.contains(roulette_view.chip_rect(chip_index, width, height), mouse_x, mouse_y):
                    return roulette_select_chip(state, roulette_view.chip_value(chip_index))
                chip_index = chip_index + 1
            if roulette_view.is_bet_target(mouse_x, mouse_y, width, height):
                return roulette_place_mouse(state, mouse_x, mouse_y, width, height)
    if phase == 1 and now >= state.roulette_spin_end:
        match roulette_api.with_settlement(state.roulette):
            case Ok(session):
                let settings = persistence.with_balance(state.settings, session.game.balance)
                return save_settings(with_roulette(rebuild(state, state.screen, state.game, state.selected_bet, settings, "Roulette spin saved", "", false, true, state.next_step, state.saved_round), session, state.roulette_spin_end), settings)
            case Err(error):
                return with_error(state, error)
    if phase == 2:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(roulette_view.next_rect(width, height), mouse_x, mouse_y):
            match roulette_api.with_next_round(state.roulette):
                case Ok(session):
                    return with_roulette(state, session, 0.0)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()) or clicked and components.contains(roulette_view.rebet_rect(width, height), mouse_x, mouse_y):
            match roulette_api.with_rebet(state.roulette):
                case Ok(session):
                    return with_roulette(state, session, 0.0)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or clicked and components.contains(roulette_view.lobby_rect(width, height), mouse_x, mouse_y) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()):
            return roulette_return_to_lobby(state)
    return state

fn plinko_configure_rows(state: State, delta: Int) -> State:
    var rows = state.plinko.game.rows + delta
    if rows < 8:
        rows = 16
    if rows > 16:
        rows = 8
    match plinko_api.with_rows(state.plinko, rows):
        case Ok(session):
            return with_plinko(state, session, state.plinko_stage, state.plinko_next_step)
        case Err(error):
            return with_error(state, error)

fn plinko_cycle_risk(state: State) -> State:
    var code = plinko_api.risk_code(state.plinko) + 1
    if code > 2:
        code = 0
    match plinko_api.with_risk_code(state.plinko, code):
        case Ok(session):
            return with_plinko(state, session, state.plinko_stage, state.plinko_next_step)
        case Err(error):
            return with_error(state, error)

fn plinko_configure_bet(state: State, delta: Int) -> State:
    var bet = state.plinko.game.bet + delta
    if bet < 5:
        bet = 5
    if bet > 1000:
        bet = 1000
    match plinko_api.with_bet(state.plinko, bet):
        case Ok(session):
            return with_plinko(state, session, state.plinko_stage, state.plinko_next_step)
        case Err(error):
            return with_error(state, error)

fn plinko_configure_batch(state: State, delta: Int) -> State:
    var count = state.plinko.game.batch_count + delta
    if count < 1:
        count = 10
    if count > 10:
        count = 1
    match plinko_api.with_batch(state.plinko, count):
        case Ok(session):
            return with_plinko(state, session, state.plinko_stage, state.plinko_next_step)
        case Err(error):
            return with_error(state, error)

fn plinko_start(state: State, now: Float) -> State:
    match plinko_api.with_drop(state.plinko):
        case Ok(session):
            return with_plinko(state, session, 0, now + 0.08)
        case Err(error):
            return with_error(state, error)

fn plinko_return_to_lobby(state: State) -> State:
    if plinko_engine_phase(state) == 1:
        return with_error(state, "Finish the bounded Plinko animation before leaving")
    let settings = persistence.with_balance(state.settings, state.plinko.game.balance)
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "Plinko progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn plinko_engine_phase(state: State) -> Int:
    return plinko_api.phase_code(state.plinko)

fn update_plinko(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int, now: Float) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()) or clicked and components.contains(plinko_view.help_rect(width, height), mouse_x, mouse_y):
        return plinko_help(state, not state.plinko_help)
    if state.plinko_help:
        return state
    let phase = plinko_engine_phase(state)
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()) or clicked and components.contains(plinko_view.rows_minus_rect(width, height), mouse_x, mouse_y):
            return plinko_configure_rows(state, -1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()) or clicked and components.contains(plinko_view.rows_plus_rect(width, height), mouse_x, mouse_y):
            return plinko_configure_rows(state, 1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_tab()) or clicked and components.contains(plinko_view.risk_rect(width, height), mouse_x, mouse_y):
            return plinko_cycle_risk(state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()) or clicked and components.contains(plinko_view.bet_minus_rect(width, height), mouse_x, mouse_y):
            return plinko_configure_bet(state, -5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()) or clicked and components.contains(plinko_view.bet_plus_rect(width, height), mouse_x, mouse_y):
            return plinko_configure_bet(state, 5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_m()):
            return plinko_configure_batch(state, 1)
        if clicked and components.contains(plinko_view.batch_minus_rect(width, height), mouse_x, mouse_y):
            return plinko_configure_batch(state, -1)
        if clicked and components.contains(plinko_view.batch_plus_rect(width, height), mouse_x, mouse_y):
            return plinko_configure_batch(state, 1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(plinko_view.drop_rect(width, height), mouse_x, mouse_y):
            return plinko_start(state, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()):
            return plinko_return_to_lobby(state)
    if phase == 1 and now >= state.plinko_next_step:
        let final_stage = state.plinko.game.rows +(state.plinko.game.batch_count - 1) * 2
        if state.plinko_stage >= final_stage:
            match plinko_api.with_settlement(state.plinko):
                case Ok(session):
                    let settings = persistence.with_balance(state.settings, session.game.balance)
                    return save_settings(with_plinko(rebuild(state, state.screen, state.game, state.selected_bet, settings, "Plinko batch saved", "", false, true, state.next_step, state.saved_round), session, state.plinko_stage, state.plinko_next_step), settings)
                case Err(error):
                    return with_error(state, error)
        return with_plinko(state, state.plinko, state.plinko_stage + 1, now + 0.08)
    if phase == 2:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(plinko_view.next_rect(width, height), mouse_x, mouse_y):
            match plinko_api.with_next_round(state.plinko):
                case Ok(session):
                    return with_plinko(state, session, 0, 0.0)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(plinko_view.lobby_rect(width, height), mouse_x, mouse_y):
            return plinko_return_to_lobby(state)
    return state

fn chicken_cycle_risk(state: State) -> State:
    var code = chicken_api.risk_code(state.chicken) + 1
    if code > 2:
        code = 0
    match chicken_api.with_risk_code(state.chicken, code):
        case Ok(session):
            return with_chicken(state, session)
        case Err(error):
            return with_error(state, error)

fn chicken_configure_bet(state: State, delta: Int) -> State:
    var bet = state.chicken.game.bet + delta
    if bet < 5:
        bet = 5
    if bet > 1000:
        bet = 1000
    match chicken_api.with_bet(state.chicken, bet):
        case Ok(session):
            return with_chicken(state, session)
        case Err(error):
            return with_error(state, error)

fn chicken_save_settlement(state: State, session: chicken_api.Session, animation_end: Float) -> State:
    let settings = persistence.with_balance(state.settings, session.game.balance)
    return save_settings(with_chicken(rebuild(state, state.screen, state.game, state.selected_bet, settings, "Coop Climb result saved", "", false, true, animation_end, state.saved_round), session), settings)

fn chicken_start(state: State, animation_end: Float) -> State:
    match chicken_api.with_start(state.chicken):
        case Ok(session):
            return with_chicken(rebuild(state, state.screen, state.game, state.selected_bet, state.settings, state.notice, "", state.exit_prompt, state.running, animation_end, state.saved_round), session)
        case Err(error):
            return with_error(state, error)

fn chicken_advance(state: State, animation_end: Float) -> State:
    match chicken_api.with_advance(state.chicken):
        case Ok(session):
            if chicken_api.phase_code(session) == 2:
                return chicken_save_settlement(state, session, animation_end)
            return with_chicken(rebuild(state, state.screen, state.game, state.selected_bet, state.settings, state.notice, "", state.exit_prompt, state.running, animation_end, state.saved_round), session)
        case Err(error):
            return with_error(state, error)

fn chicken_cash_out(state: State, animation_end: Float) -> State:
    match chicken_api.with_cash_out(state.chicken):
        case Ok(session):
            return chicken_save_settlement(state, session, animation_end)
        case Err(error):
            return with_error(state, error)

fn chicken_return_to_lobby(state: State) -> State:
    if chicken_api.phase_code(state.chicken) == 1:
        return with_error(state, "Cash out or finish the active Coop Climb round")
    let settings = persistence.with_balance(state.settings, state.chicken.game.balance)
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "Coop Climb progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn update_chicken(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    let animation_end = rocket_raylib.elapsed_time(window) + 0.32
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()) or clicked and components.contains(chicken_view.help_rect(width, height), mouse_x, mouse_y):
        return chicken_help(state, not state.chicken_help)
    if state.chicken_help:
        return state
    let phase = chicken_api.phase_code(state.chicken)
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_tab()) or clicked and components.contains(chicken_view.risk_rect(width, height), mouse_x, mouse_y):
            return chicken_cycle_risk(state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()) or clicked and components.contains(chicken_view.bet_minus_rect(width, height), mouse_x, mouse_y):
            return chicken_configure_bet(state, -5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()) or clicked and components.contains(chicken_view.bet_plus_rect(width, height), mouse_x, mouse_y):
            return chicken_configure_bet(state, 5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(chicken_view.start_rect(width, height), mouse_x, mouse_y):
            return chicken_start(state, animation_end)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(chicken_view.lobby_rect(width, height), mouse_x, mouse_y):
            return chicken_return_to_lobby(state)
    if phase == 1:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(chicken_view.advance_rect(width, height), mouse_x, mouse_y):
            return chicken_advance(state, animation_end)
        if state.chicken.game.survived_depth > 0 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()) or clicked and components.contains(chicken_view.cash_out_rect(width, height), mouse_x, mouse_y)):
            return chicken_cash_out(state, animation_end)
    if phase == 2:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(chicken_view.next_rect(width, height), mouse_x, mouse_y):
            match chicken_api.with_next_round(state.chicken):
                case Ok(session):
                    return with_chicken(rebuild(state, state.screen, state.game, state.selected_bet, state.settings, state.notice, "", state.exit_prompt, state.running, 0.0, state.saved_round), session)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(chicken_view.lobby_rect(width, height), mouse_x, mouse_y):
            return chicken_return_to_lobby(state)
    return state

fn crossing_configure_bet(state: State, delta: Int) -> State:
    var bet = state.crossing.game.bet + delta
    if bet < 5:
        bet = 5
    if bet > 1000:
        bet = 1000
    match crossing_api.with_bet(state.crossing, bet):
        case Ok(session):
            return with_crossing(state, session, state.crossing_accumulator)
        case Err(error):
            return with_error(state, error)

fn crossing_save_settlement(state: State, session: crossing_api.Session) -> State:
    let settings = persistence.with_balance(state.settings, session.game.balance)
    return save_settings(with_crossing(rebuild(state, state.screen, state.game, state.selected_bet, settings, "Midnight Crossing result saved", "", false, true, state.next_step, state.saved_round), session, 0.0), settings)

fn crossing_start(state: State) -> State:
    match crossing_api.with_start(state.crossing):
        case Ok(session):
            return with_crossing(state, session, 0.0)
        case Err(error):
            return with_error(state, error)

fn crossing_move(state: State, horizontal: Int, vertical: Int) -> State:
    match crossing_api.with_move(state.crossing, horizontal, vertical):
        case Ok(session):
            if crossing_api.phase_code(session) == 2:
                return crossing_save_settlement(state, session)
            return with_crossing(state, session, state.crossing_accumulator)
        case Err(error):
            return with_error(state, error)

fn crossing_cash_out(state: State) -> State:
    match crossing_api.with_cash_out(state.crossing):
        case Ok(session):
            return crossing_save_settlement(state, session)
        case Err(error):
            return with_error(state, error)

fn crossing_toggle_help(state: State) -> State:
    let visible = not state.crossing_help
    if crossing_api.phase_code(state.crossing) == 1:
        match crossing_api.with_pause(state.crossing):
            case Ok(session):
                return with_crossing(crossing_help(state, visible), session, state.crossing_accumulator)
            case Err(error):
                return with_error(state, error)
    return crossing_help(state, visible)

fn crossing_return_to_lobby(state: State) -> State:
    if crossing_api.phase_code(state.crossing) == 1:
        return with_error(state, "Finish or cash out the active Midnight Crossing run")
    let settings = persistence.with_balance(state.settings, state.crossing.game.balance)
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "Midnight Crossing progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn crossing_ticks(state: State, window: rocket_raylib.Window) -> State:
    var accumulator = state.crossing_accumulator + rocket_raylib.frame_time(window)
    var ticks = 0
    while accumulator >= 0.05 and ticks < 8:
        accumulator = accumulator - 0.05
        ticks = ticks + 1
    if ticks >= 8 and accumulator >= 0.05:
        accumulator = 0.0
    if ticks == 0:
        return with_crossing(state, state.crossing, accumulator)
    match crossing_api.with_ticks(state.crossing, ticks):
        case Ok(session):
            if crossing_api.phase_code(session) == 2:
                return crossing_save_settlement(state, session)
            return with_crossing(state, session, accumulator)
        case Err(error):
            return with_error(state, error)

fn update_crossing(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()) or clicked and(components.contains(crossing_view.help_rect(width, height), mouse_x, mouse_y) or crossing_api.phase_code(state.crossing) == 1 and components.contains(crossing_view.pause_rect(width, height), mouse_x, mouse_y)):
        return crossing_toggle_help(state)
    if state.crossing_help:
        return state
    let phase = crossing_api.phase_code(state.crossing)
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()) or clicked and components.contains(crossing_view.bet_minus_rect(width, height), mouse_x, mouse_y):
            return crossing_configure_bet(state, -5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()) or clicked and components.contains(crossing_view.bet_plus_rect(width, height), mouse_x, mouse_y):
            return crossing_configure_bet(state, 5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(crossing_view.start_rect(width, height), mouse_x, mouse_y):
            return crossing_start(state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(crossing_view.lobby_rect(width, height), mouse_x, mouse_y):
            return crossing_return_to_lobby(state)
    if phase == 1:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()) or clicked and components.contains(crossing_view.up_rect(width, height), mouse_x, mouse_y):
            return crossing_move(state, 0, 1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()) or clicked and components.contains(crossing_view.down_rect(width, height), mouse_x, mouse_y):
            return crossing_move(state, 0, -1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()) or clicked and components.contains(crossing_view.left_rect(width, height), mouse_x, mouse_y):
            return crossing_move(state, -1, 0)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()) or clicked and components.contains(crossing_view.right_rect(width, height), mouse_x, mouse_y):
            return crossing_move(state, 1, 0)
        if state.crossing.game.checkpoints > 0 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()) or clicked and components.contains(crossing_view.cash_out_rect(width, height), mouse_x, mouse_y)):
            return crossing_cash_out(state)
        return crossing_ticks(state, window)
    if phase == 2:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(crossing_view.next_rect(width, height), mouse_x, mouse_y):
            match crossing_api.with_next_round(state.crossing):
                case Ok(session):
                    return with_crossing(state, session, 0.0)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(crossing_view.lobby_rect(width, height), mouse_x, mouse_y):
            return crossing_return_to_lobby(state)
    return state

fn holdem_target_for(session: holdem_api.Session, requested: Int) -> Int:
    if not holdem_api.human_turn(session):
        return 10
    let minimum = holdem_api.minimum_target(session)
    let maximum = holdem_api.maximum_target(session)
    var target = requested
    if target < minimum:
        target = minimum
    if target > maximum:
        target = maximum
    return target

fn holdem_save_settlement(state: State, session: holdem_api.Session, animation_end: Float) -> State:
    let settings = persistence.with_balance(state.settings, holdem_api.human_balance(session))
    return save_settings(with_holdem(state, session, holdem_target_for(session, state.holdem_target), animation_end), settings)

fn holdem_deal(state: State, now: Float) -> State:
    match holdem_api.with_deal(state.holdem):
        case Ok(session):
            return with_holdem(state, session, holdem_target_for(session, 20), now + 0.33)
        case Err(error):
            return with_error(state, error)

fn holdem_action(state: State, action: Int, now: Float) -> State:
    var target = 0
    if action == 3:
        target = state.holdem_target
    match holdem_api.with_human_action(state.holdem, action, target):
        case Ok(session):
            if holdem_api.phase_code(session) == 2:
                return holdem_save_settlement(state, session, now + 0.33)
            return with_holdem(state, session, holdem_target_for(session, state.holdem_target), now + 0.33)
        case Err(error):
            return with_error(state, error)

fn holdem_change_target(state: State, delta: Int) -> State:
    return with_holdem(state, state.holdem, holdem_target_for(state.holdem, state.holdem_target + delta), state.next_step)

fn holdem_reset(state: State, now: Float) -> State:
    match holdem_api.with_reset_table(state.holdem):
        case Ok(session):
            let settings = persistence.with_balance(state.settings, holdem_api.human_balance(session))
            return save_settings(with_holdem(state, session, 10, now + 0.33), settings)
        case Err(error):
            return with_error(state, error)

fn holdem_next(state: State, now: Float) -> State:
    match holdem_api.with_next_hand(state.holdem):
        case Ok(session):
            if holdem_api.phase_code(session) == 2:
                return holdem_save_settlement(state, session, now + 0.33)
            return with_holdem(state, session, holdem_target_for(session, 20), now + 0.33)
        case Err(error):
            return with_error(state, error)

fn holdem_return_to_lobby(state: State) -> State:
    if holdem_api.phase_code(state.holdem) == 1:
        return with_error(state, "Finish the active Hold'em hand before returning")
    let settings = persistence.with_balance(state.settings, holdem_api.human_balance(state.holdem))
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "Hold'em progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn update_holdem(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    let now = rocket_raylib.elapsed_time(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()) or clicked and components.contains(holdem_view.help_rect(width, height), mouse_x, mouse_y):
        return holdem_help(state, not state.holdem_help)
    if state.holdem_help:
        return state
    let phase = holdem_api.phase_code(state.holdem)
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(holdem_view.deal_rect(width, height), mouse_x, mouse_y):
            return holdem_deal(state, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()) or clicked and components.contains(holdem_view.reset_rect(width, height), mouse_x, mouse_y):
            return holdem_reset(state, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(holdem_view.lobby_rect(width, height), mouse_x, mouse_y):
            return holdem_return_to_lobby(state)
    if phase == 1 and holdem_api.human_turn(state.holdem):
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()) or clicked and components.contains(holdem_view.target_minus_rect(width, height), mouse_x, mouse_y):
            return holdem_change_target(state, -10)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()) or clicked and components.contains(holdem_view.target_plus_rect(width, height), mouse_x, mouse_y):
            return holdem_change_target(state, 10)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_d()) or clicked and components.contains(holdem_view.fold_rect(width, height), mouse_x, mouse_y):
            return holdem_action(state, 0, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(holdem_view.call_rect(width, height), mouse_x, mouse_y):
            if holdem_api.call_amount(state.holdem) > 0:
                return holdem_action(state, 2, now)
            return holdem_action(state, 1, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()) or clicked and components.contains(holdem_view.raise_rect(width, height), mouse_x, mouse_y):
            return holdem_action(state, 3, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_h()) or clicked and components.contains(holdem_view.all_in_rect(width, height), mouse_x, mouse_y):
            return holdem_action(state, 4, now)
    if phase == 2:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(holdem_view.next_rect(width, height), mouse_x, mouse_y):
            return holdem_next(state, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()) or clicked and components.contains(holdem_view.reset_rect(width, height), mouse_x, mouse_y):
            return holdem_reset(state, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(holdem_view.lobby_rect(width, height), mouse_x, mouse_y):
            return holdem_return_to_lobby(state)
    return state

fn mines_configure_bet(state: State, delta: Int) -> State:
    var bet = state.mines.game.bet + delta
    if bet < 5:
        bet = 5
    if bet > 1000:
        bet = 1000
    match mines_api.with_bet(state.mines, bet):
        case Ok(session):
            return with_mines(state, session, state.mines_selected, state.mines_animation_end)
        case Err(error):
            return with_error(state, error)

fn mines_configure_count(state: State, delta: Int) -> State:
    var count = state.mines.game.mine_count + delta
    if count < 1:
        count = 1
    if count > 24:
        count = 24
    match mines_api.with_mine_count(state.mines, count):
        case Ok(session):
            return with_mines(state, session, state.mines_selected, state.mines_animation_end)
        case Err(error):
            return with_error(state, error)

fn mines_start(state: State) -> State:
    match mines_api.with_start(state.mines):
        case Ok(session):
            return with_mines(state, session, 0, 0.0)
        case Err(error):
            return with_error(state, error)

fn mines_save_settlement(state: State, session: mines_api.Session, animation_end: Float) -> State:
    let settings = persistence.with_balance(state.settings, session.game.balance)
    return save_settings(with_mines(rebuild(state, state.screen, state.game, state.selected_bet, settings, "Mines result saved", "", false, true, state.next_step, state.saved_round), session, state.mines_selected, animation_end), settings)

fn mines_reveal(state: State, tile: Int, now: Float) -> State:
    match mines_api.with_reveal(state.mines, tile):
        case Ok(session):
            if mines_api.phase_code(session) == 2:
                return mines_save_settlement(state, session, now + 0.24)
            return with_mines(state, session, tile, now + 0.18)
        case Err(error):
            return with_error(state, error)

fn mines_cash_out(state: State, now: Float) -> State:
    match mines_api.with_cash_out(state.mines):
        case Ok(session):
            return mines_save_settlement(state, session, now + 0.24)
        case Err(error):
            return with_error(state, error)

fn mines_return_to_lobby(state: State) -> State:
    if mines_api.phase_code(state.mines) == 1:
        return with_error(state, "Cash out or finish the active Mines round")
    let settings = persistence.with_balance(state.settings, state.mines.game.balance)
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "Mines progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn mines_restart(state: State) -> State:
    match mines_api.with_restart(state.mines):
        case Ok(session):
            return with_mines(state, session, 0, 0.0)
        case Err(error):
            return with_error(state, error)

fn mines_move_selection(state: State, delta: Int) -> State:
    var selected = state.mines_selected + delta
    if selected < 0:
        selected = 0
    if selected > 24:
        selected = 24
    return with_mines(state, state.mines, selected, state.mines_animation_end)

fn update_mines(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int, now: Float) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()) or clicked and components.contains(mines_view.help_rect(width, height), mouse_x, mouse_y):
        return mines_help(state, not state.mines_help)
    if state.mines_help:
        return state
    if now < state.mines_animation_end:
        return state
    let phase = mines_api.phase_code(state.mines)
    if phase != 1 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()) or clicked and components.contains(mines_view.restart_rect(width, height), mouse_x, mouse_y)):
        return mines_restart(state)
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()) or clicked and components.contains(mines_view.bet_minus_rect(width, height), mouse_x, mouse_y):
            return mines_configure_bet(state, -5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()) or clicked and components.contains(mines_view.bet_plus_rect(width, height), mouse_x, mouse_y):
            return mines_configure_bet(state, 5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()) or clicked and components.contains(mines_view.mines_minus_rect(width, height), mouse_x, mouse_y):
            return mines_configure_count(state, -1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()) or clicked and components.contains(mines_view.mines_plus_rect(width, height), mouse_x, mouse_y):
            return mines_configure_count(state, 1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(mines_view.start_rect(width, height), mouse_x, mouse_y):
            return mines_start(state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(mines_view.lobby_rect(width, height), mouse_x, mouse_y):
            return mines_return_to_lobby(state)
    if phase == 1:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()):
            return mines_move_selection(state, -1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()):
            return mines_move_selection(state, 1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()):
            return mines_move_selection(state, -5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()):
            return mines_move_selection(state, 5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()):
            return mines_reveal(state, state.mines_selected, now)
        if state.mines.game.safe_reveals > 0 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()) or clicked and components.contains(mines_view.cash_out_rect(width, height), mouse_x, mouse_y)):
            return mines_cash_out(state, now)
        if clicked:
            var tile = 0
            while tile < 25:
                if components.contains(mines_view.tile_rect(tile, width, height), mouse_x, mouse_y):
                    return mines_reveal(state, tile, now)
                tile = tile + 1
    if phase == 2:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(mines_view.next_rect(width, height), mouse_x, mouse_y):
            match mines_api.with_next_round(state.mines):
                case Ok(session):
                    return with_mines(state, session, 0, 0.0)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(mines_view.lobby_rect(width, height), mouse_x, mouse_y):
            return mines_return_to_lobby(state)
    return state

fn dice_configure_target(state: State, delta: Int) -> State:
    var target = state.dice.game.target + delta
    if target < 1:
        target = 1
    if target > 9999:
        target = 9999
    match dice_api.with_target(state.dice, target):
        case Ok(session):
            return with_dice(state, session, state.dice_animation_end)
        case Err(error):
            return with_error(state, error)

fn dice_toggle_direction(state: State) -> State:
    var code = dice_rules.direction_code(state.dice.game.direction) + 1
    if code > 1:
        code = 0
    match dice_api.with_direction_code(state.dice, code):
        case Ok(session):
            return with_dice(state, session, state.dice_animation_end)
        case Err(error):
            return with_error(state, error)

fn dice_configure_bet(state: State, delta: Int) -> State:
    var bet = state.dice.game.bet + delta
    if bet < 5:
        bet = 5
    if bet > 1000:
        bet = 1000
    match dice_api.with_bet(state.dice, bet):
        case Ok(session):
            return with_dice(state, session, state.dice_animation_end)
        case Err(error):
            return with_error(state, error)

fn dice_configure_auto(state: State, kind: Int) -> State:
    var count = state.dice.game.auto_count
    var wins = state.dice.game.stop_wins
    var losses = state.dice.game.stop_losses
    if kind == 0:
        count = count + 1
        if count > 20:
            count = 1
    if kind == 1:
        wins = wins + 1
        if wins > 20:
            wins = 0
    if kind == 2:
        losses = losses + 1
        if losses > 20:
            losses = 0
    match dice_api.with_auto(state.dice, count, wins, losses):
        case Ok(session):
            return with_dice(state, session, state.dice_animation_end)
        case Err(error):
            return with_error(state, error)

fn dice_save_settlement(state: State, session: dice_api.Session, animation_end: Float) -> State:
    let settings = persistence.with_balance(state.settings, session.game.balance)
    return save_settings(with_dice(rebuild(state, state.screen, state.game, state.selected_bet, settings, "Dice result saved", "", false, true, state.next_step, state.saved_round), session, animation_end), settings)

fn dice_manual_roll(state: State, now: Float) -> State:
    match dice_api.with_roll(state.dice):
        case Ok(session):
            return dice_save_settlement(state, session, now + 0.22)
        case Err(error):
            return with_error(state, error)

fn dice_start_auto(state: State, now: Float) -> State:
    match dice_api.with_start_auto(state.dice):
        case Ok(session):
            return with_dice(state, session, now)
        case Err(error):
            return with_error(state, error)

fn dice_auto_step(state: State, now: Float) -> State:
    match dice_api.with_auto_step(state.dice):
        case Ok(session):
            if dice_api.phase_code(session) == 2:
                return dice_save_settlement(state, session, now + 0.14)
            return with_dice(state, session, now + 0.14)
        case Err(error):
            return with_error(state, error)

fn dice_stop_auto(state: State, now: Float) -> State:
    match dice_api.with_stop_auto(state.dice):
        case Ok(session):
            return dice_save_settlement(state, session, now + 0.10)
        case Err(error):
            return with_error(state, error)

fn dice_next(state: State) -> State:
    match dice_api.with_next_round(state.dice):
        case Ok(session):
            return with_dice(state, session, 0.0)
        case Err(error):
            return with_error(state, error)

fn dice_restart(state: State) -> State:
    match dice_api.with_restart(state.dice):
        case Ok(session):
            return with_dice(state, session, 0.0)
        case Err(error):
            return with_error(state, error)

fn dice_return_to_lobby(state: State) -> State:
    if dice_api.phase_code(state.dice) == 1:
        return with_error(state, "Stop the active finite Dice auto-roll before leaving")
    let settings = persistence.with_balance(state.settings, state.dice.game.balance)
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "Dice progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn update_dice(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int, now: Float) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()) or clicked and components.contains(dice_view.help_rect(width, height), mouse_x, mouse_y):
        return dice_help(state, not state.dice_help)
    if state.dice_help:
        return state
    let phase = dice_api.phase_code(state.dice)
    if phase == 1:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()) or clicked and components.contains(dice_view.auto_rect(width, height), mouse_x, mouse_y):
            return dice_stop_auto(state, now)
        if now >= state.dice_animation_end:
            return dice_auto_step(state, now)
        return state
    if now < state.dice_animation_end:
        return state
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_tab()) or clicked and components.contains(dice_view.direction_rect(width, height), mouse_x, mouse_y):
            return dice_toggle_direction(state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()) or clicked and components.contains(dice_view.target_minus_rect(width, height), mouse_x, mouse_y):
            return dice_configure_target(state, -100)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()) or clicked and components.contains(dice_view.target_plus_rect(width, height), mouse_x, mouse_y):
            return dice_configure_target(state, 100)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()) or clicked and components.contains(dice_view.bet_minus_rect(width, height), mouse_x, mouse_y):
            return dice_configure_bet(state, -5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()) or clicked and components.contains(dice_view.bet_plus_rect(width, height), mouse_x, mouse_y):
            return dice_configure_bet(state, 5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_m()) or clicked and components.contains(dice_view.auto_count_rect(width, height), mouse_x, mouse_y):
            return dice_configure_auto(state, 0)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_h()) or clicked and components.contains(dice_view.win_stop_rect(width, height), mouse_x, mouse_y):
            return dice_configure_auto(state, 1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_d()) or clicked and components.contains(dice_view.loss_stop_rect(width, height), mouse_x, mouse_y):
            return dice_configure_auto(state, 2)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(dice_view.roll_rect(width, height), mouse_x, mouse_y):
            return dice_manual_roll(state, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()) or clicked and components.contains(dice_view.auto_rect(width, height), mouse_x, mouse_y):
            return dice_start_auto(state, now)
    if phase == 2 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(dice_view.next_rect(width, height), mouse_x, mouse_y)):
        return dice_next(state)
    if phase != 1 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()) or clicked and components.contains(dice_view.restart_rect(width, height), mouse_x, mouse_y)):
        return dice_restart(state)
    if phase != 1 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(dice_view.lobby_rect(width, height), mouse_x, mouse_y)):
        return dice_return_to_lobby(state)
    return state

fn hilo_configure_bet(state: State, delta: Int) -> State:
    var bet = state.hilo.game.bet + delta
    if bet < 5:
        bet = 5
    if bet > 1000:
        bet = 1000
    match hilo_api.with_bet(state.hilo, bet):
        case Ok(session):
            return with_hilo(state, session, state.hilo_animation_end)
        case Err(error):
            return with_error(state, error)

fn hilo_start(state: State, now: Float) -> State:
    let expected = now
    match hilo_api.with_start(state.hilo):
        case Ok(session):
            return with_hilo(state, session, 0.0)
        case Err(error):
            return with_error(state, error)

fn hilo_save_settlement(state: State, session: hilo_api.Session, animation_end: Float) -> State:
    let settings = persistence.with_balance(state.settings, session.game.balance)
    return save_settings(with_hilo(rebuild(state, state.screen, state.game, state.selected_bet, settings, "HiLo result saved", "", false, true, state.next_step, state.saved_round), session, animation_end), settings)

fn hilo_predict(state: State, code: Int, now: Float) -> State:
    match hilo_api.with_prediction_code(state.hilo, code):
        case Ok(session):
            if hilo_api.phase_code(session) == 2:
                return hilo_save_settlement(state, session, now + 0.22)
            return with_hilo(state, session, now + 0.22)
        case Err(error):
            return with_error(state, error)

fn hilo_cash_out(state: State, now: Float) -> State:
    match hilo_api.with_cash_out(state.hilo):
        case Ok(session):
            return hilo_save_settlement(state, session, now + 0.16)
        case Err(error):
            return with_error(state, error)

fn hilo_next(state: State) -> State:
    match hilo_api.with_next_round(state.hilo):
        case Ok(session):
            return with_hilo(state, session, 0.0)
        case Err(error):
            return with_error(state, error)

fn hilo_restart(state: State) -> State:
    match hilo_api.with_restart(state.hilo):
        case Ok(session):
            return with_hilo(state, session, 0.0)
        case Err(error):
            return with_error(state, error)

fn hilo_return_to_lobby(state: State) -> State:
    if hilo_api.phase_code(state.hilo) == 1:
        return with_error(state, "Finish or cash out the active HiLo round before leaving")
    let settings = persistence.with_balance(state.settings, state.hilo.game.balance)
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "HiLo progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn update_hilo(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int, now: Float) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()) or clicked and components.contains(hilo_view.help_rect(width, height), mouse_x, mouse_y):
        return hilo_help(state, not state.hilo_help)
    if state.hilo_help:
        return state
    if now < state.hilo_animation_end:
        return state
    let phase = hilo_api.phase_code(state.hilo)
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()) or clicked and components.contains(hilo_view.bet_minus_rect(width, height), mouse_x, mouse_y):
            return hilo_configure_bet(state, -5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()) or clicked and components.contains(hilo_view.bet_plus_rect(width, height), mouse_x, mouse_y):
            return hilo_configure_bet(state, 5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(hilo_view.start_rect(width, height), mouse_x, mouse_y):
            return hilo_start(state, now)
    if phase == 1:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_l()) or clicked and components.contains(hilo_view.lower_rect(width, height), mouse_x, mouse_y):
            return hilo_predict(state, 0, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_h()) or clicked and components.contains(hilo_view.higher_rect(width, height), mouse_x, mouse_y):
            return hilo_predict(state, 1, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()) or clicked and components.contains(hilo_view.cash_out_rect(width, height), mouse_x, mouse_y):
            return hilo_cash_out(state, now)
    if phase == 2 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(hilo_view.next_rect(width, height), mouse_x, mouse_y)):
        return hilo_next(state)
    if phase != 1 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()) or clicked and components.contains(hilo_view.restart_rect(width, height), mouse_x, mouse_y)):
        return hilo_restart(state)
    if phase != 1 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(hilo_view.lobby_rect(width, height), mouse_x, mouse_y)):
        return hilo_return_to_lobby(state)
    return state

fn crash_configure_bet(state: State, delta: Int) -> State:
    var bet = state.crash.game.bet + delta
    if bet < 5:
        bet = 5
    if bet > 1000:
        bet = 1000
    match crash_api.with_bet(state.crash, bet):
        case Ok(session):
            return with_crash(state, session, state.crash_accumulator)
        case Err(error):
            return with_error(state, error)

fn crash_configure_auto(state: State, delta: Int, toggle: Bool) -> State:
    var target = state.crash.game.auto_cash_out_basis_points
    if toggle:
        if target == 0:
            target = 15000
        else:
            target = 0
    if not toggle and target > 0:
        target = target + delta
        if target < 10100:
            target = 10100
        if target > 1000000:
            target = 1000000
    match crash_api.with_auto_cash_out(state.crash, target):
        case Ok(session):
            return with_crash(state, session, state.crash_accumulator)
        case Err(error):
            return with_error(state, error)

fn crash_save_settlement(state: State, session: crash_api.Session) -> State:
    let settings = persistence.with_balance(state.settings, session.game.balance)
    return save_settings(with_crash(rebuild(state, state.screen, state.game, state.selected_bet, settings, "Crash result saved", "", false, true, state.next_step, state.saved_round), session, 0.0), settings)

fn crash_start(state: State) -> State:
    match crash_api.with_start(state.crash):
        case Ok(session):
            if crash_api.phase_code(session) == 2:
                return crash_save_settlement(state, session)
            return with_crash(state, session, 0.0)
        case Err(error):
            return with_error(state, error)

fn crash_cash_out(state: State) -> State:
    match crash_api.with_cash_out(state.crash):
        case Ok(session):
            return crash_save_settlement(state, session)
        case Err(error):
            return with_error(state, error)

fn crash_ticks(state: State, window: rocket_raylib.Window) -> State:
    var accumulator = state.crash_accumulator + rocket_raylib.frame_time(window)
    var ticks = 0
    while accumulator >= 0.05 and ticks < 8:
        accumulator = accumulator - 0.05
        ticks = ticks + 1
    if ticks >= 8 and accumulator >= 0.05:
        accumulator = 0.0
    if ticks == 0:
        return with_crash(state, state.crash, accumulator)
    match crash_api.with_ticks(state.crash, ticks):
        case Ok(session):
            if crash_api.phase_code(session) == 2:
                return crash_save_settlement(state, session)
            return with_crash(state, session, accumulator)
        case Err(error):
            return with_error(state, error)

fn crash_next(state: State) -> State:
    match crash_api.with_next_round(state.crash):
        case Ok(session):
            return with_crash(state, session, 0.0)
        case Err(error):
            return with_error(state, error)

fn crash_restart(state: State) -> State:
    match crash_api.with_restart(state.crash):
        case Ok(session):
            return with_crash(state, session, 0.0)
        case Err(error):
            return with_error(state, error)

fn crash_return_to_lobby(state: State) -> State:
    if crash_api.phase_code(state.crash) == 1:
        return with_error(state, "Cash out or reach the committed Crash point before leaving")
    let settings = persistence.with_balance(state.settings, state.crash.game.balance)
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "Crash progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn update_crash(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()) or clicked and components.contains(crash_view.help_rect(width, height), mouse_x, mouse_y):
        return crash_help(state, not state.crash_help)
    if state.crash_help:
        return state
    let phase = crash_api.phase_code(state.crash)
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()) or clicked and components.contains(crash_view.bet_minus_rect(width, height), mouse_x, mouse_y):
            return crash_configure_bet(state, -5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()) or clicked and components.contains(crash_view.bet_plus_rect(width, height), mouse_x, mouse_y):
            return crash_configure_bet(state, 5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_tab()) or clicked and components.contains(crash_view.auto_toggle_rect(width, height), mouse_x, mouse_y):
            return crash_configure_auto(state, 0, true)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()) or clicked and components.contains(crash_view.auto_minus_rect(width, height), mouse_x, mouse_y):
            return crash_configure_auto(state, -100, false)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()) or clicked and components.contains(crash_view.auto_plus_rect(width, height), mouse_x, mouse_y):
            return crash_configure_auto(state, 100, false)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(crash_view.start_rect(width, height), mouse_x, mouse_y):
            return crash_start(state)
    if phase == 1:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()) or clicked and components.contains(crash_view.cash_out_rect(width, height), mouse_x, mouse_y):
            return crash_cash_out(state)
        return crash_ticks(state, window)
    if phase == 2 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(crash_view.next_rect(width, height), mouse_x, mouse_y)):
        return crash_next(state)
    if phase != 1 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()) or clicked and components.contains(crash_view.restart_rect(width, height), mouse_x, mouse_y)):
        return crash_restart(state)
    if phase != 1 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(crash_view.lobby_rect(width, height), mouse_x, mouse_y)):
        return crash_return_to_lobby(state)
    return state

fn slots_step_seconds(game: slots_api.Session) -> Float:
    if game.game.turbo:
        return 0.035
    return 0.12

fn slots_configure_bet(state: State, delta: Int) -> State:
    var bet = state.slots.game.bet_per_line + delta
    if bet < 1:
        bet = 1
    if bet > 20:
        bet = 20
    match slots_api.with_bet_per_line(state.slots, bet):
        case Ok(session):
            return with_slots(state, session, state.slots_reel_stage, state.slots_animation_end)
        case Err(error):
            return with_error(state, error)

fn slots_configure_turbo(state: State) -> State:
    match slots_api.with_turbo(state.slots, not state.slots.game.turbo):
        case Ok(session):
            return with_slots(state, session, state.slots_reel_stage, state.slots_animation_end)
        case Err(error):
            return with_error(state, error)

fn slots_configure_auto_count(state: State) -> State:
    var count = state.slots.game.auto_count + 1
    if count > 10:
        count = 1
    match slots_api.with_auto_count(state.slots, count):
        case Ok(session):
            return with_slots(state, session, state.slots_reel_stage, state.slots_animation_end)
        case Err(error):
            return with_error(state, error)

fn slots_begin(state: State, session: slots_api.Session, now: Float) -> State:
    return with_slots(state, session, 0, now + slots_step_seconds(session))

fn slots_spin(state: State, now: Float) -> State:
    match slots_api.with_spin(state.slots):
        case Ok(session):
            return slots_begin(state, session, now)
        case Err(error):
            return with_error(state, error)

fn slots_start_auto(state: State, now: Float) -> State:
    match slots_api.with_start_auto(state.slots):
        case Ok(session):
            return slots_begin(state, session, now)
        case Err(error):
            return with_error(state, error)

fn slots_stop_auto(state: State) -> State:
    match slots_api.with_stop_auto(state.slots):
        case Ok(session):
            return with_slots(state, session, state.slots_reel_stage, state.slots_animation_end)
        case Err(error):
            return with_error(state, error)

fn slots_save_settlement(state: State, session: slots_api.Session) -> State:
    let settings = persistence.with_balance(state.settings, session.game.balance)
    return save_settings(with_slots(rebuild(state, state.screen, state.game, state.selected_bet, settings, "Slot round saved", "", false, true, state.next_step, state.saved_round), session, 5, 0.0), settings)

fn slots_advance_presentation(state: State, now: Float) -> State:
    if now < state.slots_animation_end:
        return state
    if state.slots_reel_stage < 5:
        return with_slots(state, state.slots, state.slots_reel_stage + 1, now + slots_step_seconds(state.slots))
    match slots_api.with_finish_presentation(state.slots):
        case Ok(session):
            if slots_api.phase_code(session) == 1:
                return slots_begin(state, session, now)
            return slots_save_settlement(state, session)
        case Err(error):
            return with_error(state, error)

fn slots_auto_next(state: State, now: Float) -> State:
    match slots_api.with_auto_next(state.slots):
        case Ok(session):
            return slots_begin(state, session, now)
        case Err(error):
            return with_error(state, error)

fn slots_next(state: State) -> State:
    match slots_api.with_next_round(state.slots):
        case Ok(session):
            return with_slots(state, session, 5, 0.0)
        case Err(error):
            return with_error(state, error)

fn slots_restart(state: State) -> State:
    match slots_api.with_restart(state.slots):
        case Ok(session):
            return with_slots(state, session, 5, 0.0)
        case Err(error):
            return with_error(state, error)

fn slots_return_to_lobby(state: State) -> State:
    if slots_api.phase_code(state.slots) == 1 or state.slots.game.auto_active:
        return with_error(state, "Finish the committed Slot spin and stop finite Auto before leaving")
    let settings = persistence.with_balance(state.settings, state.slots.game.balance)
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "Slot progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn update_slots(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int, now: Float) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()) or clicked and components.contains(slots_view.help_rect(width, height), mouse_x, mouse_y):
        return slots_help(state, not state.slots_help)
    if state.slots_help:
        return state
    if state.slots.game.auto_active and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()) or clicked and components.contains(slots_view.auto_rect(width, height), mouse_x, mouse_y)):
        return slots_stop_auto(state)
    let phase = slots_api.phase_code(state.slots)
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()) or clicked and components.contains(slots_view.bet_minus_rect(width, height), mouse_x, mouse_y):
            return slots_configure_bet(state, -1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()) or clicked and components.contains(slots_view.bet_plus_rect(width, height), mouse_x, mouse_y):
            return slots_configure_bet(state, 1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_d()) or clicked and components.contains(slots_view.turbo_rect(width, height), mouse_x, mouse_y):
            return slots_configure_turbo(state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_m()) or clicked and components.contains(slots_view.auto_count_rect(width, height), mouse_x, mouse_y):
            return slots_configure_auto_count(state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(slots_view.spin_rect(width, height), mouse_x, mouse_y):
            return slots_spin(state, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_h()) or clicked and components.contains(slots_view.auto_rect(width, height), mouse_x, mouse_y):
            return slots_start_auto(state, now)
    if phase == 1:
        return slots_advance_presentation(state, now)
    if phase == 2 and state.slots.game.auto_active:
        return slots_auto_next(state, now)
    if phase == 2 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(slots_view.next_rect(width, height), mouse_x, mouse_y)):
        return slots_next(state)
    if phase != 1 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()) or clicked and components.contains(slots_view.restart_rect(width, height), mouse_x, mouse_y)):
        return slots_restart(state)
    if phase != 1 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(slots_view.lobby_rect(width, height), mouse_x, mouse_y)):
        return slots_return_to_lobby(state)
    return state

fn request_back(state: State) -> State:
    if shell_view.is_help_screen(state.screen):
        return rebuild(state, shell_view.help_source(state.screen), state.game, state.selected_bet, state.settings, "Guide closed", "", false, true, state.next_step, state.saved_round)
    if shell_view.is_lobby_screen(state.screen):
        return state
    if state.screen == 3:
        return rebuild(state, 1, state.game, state.selected_bet, state.settings, "Settings saved locally", "", false, true, state.next_step, state.saved_round)
    if state.screen == 2:
        let phase = blackjack_engine.phase_code(state.game.phase)
        if phase == 0 or phase == 3:
            return return_to_lobby(state)
        return with_error(state, "Finish the active Blackjack hand before returning to All games")
    if state.screen == 4:
        if state.roulette_help:
            return roulette_help(state, false)
        return roulette_return_to_lobby(state)
    if state.screen == 5:
        if state.plinko_help:
            return plinko_help(state, false)
        return plinko_return_to_lobby(state)
    if state.screen == 6:
        if state.chicken_help:
            return chicken_help(state, false)
        return chicken_return_to_lobby(state)
    if state.screen == 7:
        if state.crossing_help:
            return crossing_help(state, false)
        return crossing_return_to_lobby(state)
    if state.screen == 8:
        if state.holdem_help:
            return holdem_help(state, false)
        return holdem_return_to_lobby(state)
    if state.screen == 9:
        if state.mines_help:
            return mines_help(state, false)
        return mines_return_to_lobby(state)
    if state.screen == 10:
        if state.dice_help:
            return dice_help(state, false)
        return dice_return_to_lobby(state)
    if state.screen == 11:
        if state.hilo_help:
            return hilo_help(state, false)
        return hilo_return_to_lobby(state)
    if state.screen == 12:
        if state.crash_help:
            return crash_help(state, false)
        return crash_return_to_lobby(state)
    if state.screen == 13:
        if state.slots_help:
            return slots_help(state, false)
        return slots_return_to_lobby(state)
    return with_error(state, "This screen cannot be left until its current operation finishes")

fn request_settings(state: State) -> State:
    var source = state
    if shell_view.is_help_screen(source.screen):
        source = rebuild(source, shell_view.help_source(source.screen), source.game, source.selected_bet, source.settings, source.notice, "", false, true, source.next_step, source.saved_round)
    if shell_view.is_lobby_screen(source.screen):
        return rebuild(source, 3, source.game, source.selected_bet, source.settings, "Settings", "", false, true, source.next_step, source.saved_round)
    if source.screen == 3:
        return source
    let backed = request_back(source)
    if shell_view.is_lobby_screen(backed.screen):
        return rebuild(backed, 3, backed.game, backed.selected_bet, backed.settings, "Settings", "", false, true, backed.next_step, backed.saved_round)
    return backed

fn visible_balance(state: State) -> Int:
    var screen = state.screen
    if shell_view.is_help_screen(screen):
        screen = shell_view.help_source(screen)
    if screen == 2:
        return state.game.players[0].balance
    if screen == 4:
        return state.roulette.game.balance
    if screen == 5:
        return state.plinko.game.balance
    if screen == 6:
        return state.chicken.game.balance
    if screen == 7:
        return state.crossing.game.balance
    if screen == 8:
        return holdem_api.human_balance(state.holdem)
    if screen == 9:
        return state.mines.game.balance
    if screen == 10:
        return state.dice.game.balance
    if screen == 11:
        return state.hilo.game.balance
    if screen == 12:
        return state.crash.game.balance
    if screen == 13:
        return state.slots.game.balance
    return state.settings.play_balance

fn update(state: State, window: rocket_raylib.Window) -> State:
    let clicked = rocket_raylib.is_mouse_pressed(window, rocket_raylib.mouse_left())
    let mouse_x = rocket_raylib.mouse_x(window)
    let mouse_y = rocket_raylib.mouse_y(window)
    if state.error != "":
        let width = rocket_raylib.window_width(window)
        let height = rocket_raylib.window_height(window)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(components.modal_primary_rect(width, height, false), mouse_x, mouse_y):
            return rebuild(state, state.screen, state.game, state.selected_bet, state.settings, state.notice, "", state.exit_prompt, state.running, state.next_step, state.saved_round)
        return state
    if state.exit_prompt:
        let width = rocket_raylib.window_width(window)
        let height = rocket_raylib.window_height(window)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(components.modal_primary_rect(width, height, true), mouse_x, mouse_y):
            return rebuild(state, state.screen, state.game, state.selected_bet, state.settings, state.notice, "", false, false, state.next_step, state.saved_round)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(components.modal_secondary_rect(width, height), mouse_x, mouse_y):
            return rebuild(state, state.screen, state.game, state.selected_bet, state.settings, state.notice, "", false, true, state.next_step, state.saved_round)
        return state
    let now = rocket_raylib.elapsed_time(window)
    if state.screen == 0:
        var duration = theme.startup_seconds()
        if state.settings.reduced_motion:
            duration = 0.18
        if now >= duration or rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_space()):
            return rebuild(state, 1, state.game, state.selected_bet, state.settings, "Choose a game", "", false, true, state.next_step, state.saved_round)
        return state
    let width = rocket_raylib.window_width(window)
    let shell_back = not shell_view.is_lobby_screen(state.screen) and(clicked and components.contains(shell_view.back_rect(width), mouse_x, mouse_y) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()))
    if shell_back:
        return request_back(state)
    if clicked and components.contains(shell_view.theme_rect(width), mouse_x, mouse_y) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_t()):
        return settings_theme(state)
    if clicked and components.contains(shell_view.help_rect(width), mouse_x, mouse_y):
        if shell_view.is_help_screen(state.screen):
            return state
        return rebuild(state, shell_view.help_screen(state.screen), state.game, state.selected_bet, state.settings, "Guide opened", "", false, true, state.next_step, state.saved_round)
    if clicked and components.contains(shell_view.settings_rect(width), mouse_x, mouse_y):
        return request_settings(state)
    if shell_view.is_help_screen(state.screen):
        return state
    if shell_view.is_lobby_screen(state.screen):
        return update_lobby(state, window, clicked, mouse_x, mouse_y)
    if state.screen == 2:
        return update_game(state, window, clicked, mouse_x, mouse_y, now)
    if state.screen == 4:
        return update_roulette(state, window, clicked, mouse_x, mouse_y, now)
    if state.screen == 5:
        return update_plinko(state, window, clicked, mouse_x, mouse_y, now)
    if state.screen == 6:
        return update_chicken(state, window, clicked, mouse_x, mouse_y)
    if state.screen == 7:
        return update_crossing(state, window, clicked, mouse_x, mouse_y)
    if state.screen == 8:
        return update_holdem(state, window, clicked, mouse_x, mouse_y)
    if state.screen == 9:
        return update_mines(state, window, clicked, mouse_x, mouse_y, now)
    if state.screen == 10:
        return update_dice(state, window, clicked, mouse_x, mouse_y, now)
    if state.screen == 11:
        return update_hilo(state, window, clicked, mouse_x, mouse_y, now)
    if state.screen == 12:
        return update_crash(state, window, clicked, mouse_x, mouse_y)
    if state.screen == 13:
        return update_slots(state, window, clicked, mouse_x, mouse_y, now)
    return update_settings(state, window, clicked, mouse_x, mouse_y)

fn draw(window: rocket_raylib.Window, state: State, resources: ui_resources.UiResources) -> Result[Bool, String]:
    let mouse_x = rocket_raylib.mouse_x(window)
    let mouse_y = rocket_raylib.mouse_y(window)
    let frame = rocket_raylib.begin_frame(window)?
    rocket_raylib.clear(frame, theme.canvas(state.settings.light_mode))?
    if state.screen == 0:
        shell_view.draw_startup(window, frame, resources, state.settings.light_mode, state.settings.reduced_motion, rocket_raylib.elapsed_time(window))?
    if shell_view.is_lobby_screen(state.screen):
        shell_view.draw_lobby(window, frame, resources, shell_view.lobby_focus(state.screen), state.notice, state.settings.light_mode, mouse_x, mouse_y)?
    if state.screen == 2:
        blackjack_view.draw(window, frame, resources, state.game, state.selected_bet, state.settings.light_mode, state.settings.reduced_motion, rocket_raylib.elapsed_time(window), state.next_step, mouse_x, mouse_y)?
    if state.screen == 3:
        shell_view.draw_settings(window, frame, resources, state.settings, state.settings.light_mode, mouse_x, mouse_y)?
    if state.screen == 4:
        roulette_view.draw(window, frame, resources, state.roulette.game, state.roulette_kind, state.roulette_target, state.roulette_help, state.settings.light_mode, state.settings.reduced_motion, rocket_raylib.elapsed_time(window), state.roulette_spin_end, mouse_x, mouse_y)?
    if state.screen == 5:
        plinko_view.draw(window, frame, resources, state.plinko.game, state.plinko_stage, state.plinko_help, state.settings.light_mode, state.settings.reduced_motion, rocket_raylib.elapsed_time(window), state.plinko_next_step, mouse_x, mouse_y)?
    if state.screen == 6:
        chicken_view.draw(window, frame, resources, state.chicken.game, state.chicken_help, state.settings.light_mode, state.settings.reduced_motion, rocket_raylib.elapsed_time(window), state.next_step, mouse_x, mouse_y)?
    if state.screen == 7:
        crossing_view.draw(window, frame, resources, state.crossing.game, state.crossing_help, state.settings.light_mode, state.settings.reduced_motion, rocket_raylib.elapsed_time(window), mouse_x, mouse_y)?
    if state.screen == 8:
        let table = holdem_api.public_table(state.holdem)
        let can_fold = holdem_api.can_action(state.holdem, 0, 0)
        let can_call_check = holdem_api.can_action(state.holdem, 1, 0) or holdem_api.can_action(state.holdem, 2, 0)
        let can_raise = holdem_api.can_action(state.holdem, 3, state.holdem_target)
        let can_all_in = holdem_api.can_action(state.holdem, 4, 0)
        holdem_view.draw(window, frame, resources, table, state.holdem_target, can_fold, can_call_check, can_raise, can_all_in, state.holdem_help, state.settings.light_mode, state.settings.reduced_motion, rocket_raylib.elapsed_time(window), state.next_step, mouse_x, mouse_y)?
    if state.screen == 9:
        mines_view.draw(window, frame, resources, state.mines, state.mines_selected, state.mines_help, state.settings.light_mode, state.settings.reduced_motion, rocket_raylib.elapsed_time(window), state.mines_animation_end, mouse_x, mouse_y)?
    if state.screen == 10:
        dice_view.draw(window, frame, resources, state.dice, state.dice_help, state.settings.light_mode, state.settings.reduced_motion, rocket_raylib.elapsed_time(window), state.dice_animation_end, mouse_x, mouse_y)?
    if state.screen == 11:
        let table = hilo_api.public_table(state.hilo)?
        hilo_view.draw(window, frame, resources, table, state.hilo_help, state.settings.light_mode, state.settings.reduced_motion, rocket_raylib.elapsed_time(window), state.hilo_animation_end, mouse_x, mouse_y)?
    if state.screen == 12:
        let table = crash_api.public_table(state.crash)
        crash_view.draw(window, frame, resources, table, state.crash_help, state.settings.light_mode, state.settings.reduced_motion, rocket_raylib.elapsed_time(window), mouse_x, mouse_y)?
    if state.screen == 13:
        slots_view.draw(window, frame, resources, state.slots, state.slots_help, state.slots_reel_stage, state.settings.light_mode, state.settings.reduced_motion, rocket_raylib.elapsed_time(window), state.slots_animation_end, mouse_x, mouse_y)?
    if shell_view.is_help_screen(state.screen):
        shell_view.draw_help(window, frame, resources, shell_view.help_source(state.screen), state.settings.light_mode)?
    if state.screen != 0:
        shell_view.draw_shell(window, frame, resources, shell_view.screen_title(state.screen), visible_balance(state), not shell_view.is_lobby_screen(state.screen), state.settings.light_mode, mouse_x, mouse_y)?
    if state.error != "":
        components.modern_modal(window, frame, resources, "Something needs attention", state.error, false, state.settings.light_mode, mouse_x, mouse_y)?
    if state.exit_prompt:
        components.modern_modal(window, frame, resources, "Leave Scroll2Roll?", "Your local settings and settled progress are saved", true, state.settings.light_mode, mouse_x, mouse_y)?
    rocket_raylib.end_frame(frame)?
    return Ok(true)

pub fn initial_for_test(save_path: String) -> Result[State, String]:
    return initial(persistence.defaults(), save_path, "Deterministic test session")

pub fn step_for_test(state: State, window: rocket_raylib.Window) -> State:
    return update(state, window)

pub fn draw_for_test(window: rocket_raylib.Window, state: State) -> Result[Bool, String]:
    return draw(window, state, ui_resources.empty())

pub fn draw_with_resources_for_test(window: rocket_raylib.Window, state: State, resources: ui_resources.UiResources) -> Result[Bool, String]:
    return draw(window, state, resources)

fn volume_value(percent: Int) -> Float:
    if percent <= 0:
        return 0.0
    if percent <= 25:
        return 0.25
    if percent <= 50:
        return 0.5
    if percent <= 75:
        return 0.75
    return 1.0

fn event_sound(previous: State, current: State, sound: rocket_raylib.Sound, audio_ready: Bool) -> Bool:
    let blackjack_changed = previous.game.message != current.game.message
    let roulette_changed = previous.roulette.game.message != current.roulette.game.message
    let plinko_changed = previous.plinko.game.message != current.plinko.game.message
    let chicken_changed = previous.chicken.game.message != current.chicken.game.message
    let crossing_changed = previous.crossing.game.message != current.crossing.game.message
    let holdem_changed = previous.holdem.game.message != current.holdem.game.message
    let mines_changed = previous.mines.game.message != current.mines.game.message
    let dice_changed = previous.dice.game.message != current.dice.game.message
    let hilo_changed = previous.hilo.game.message != current.hilo.game.message
    let crash_changed = previous.crash.game.message != current.crash.game.message
    let slots_changed = previous.slots.game.message != current.slots.game.message
    if audio_ready and current.settings.audio_enabled and(blackjack_changed or roulette_changed or plinko_changed or chicken_changed or crossing_changed or holdem_changed or mines_changed or dice_changed or hilo_changed or crash_changed or slots_changed):
        let volume = rocket_raylib.set_sound_volume(sound, volume_value(current.settings.volume_percent))
        let played = rocket_raylib.play_sound(sound)
    return true

fn loop(window: rocket_raylib.Window, initial_state: State, resources: ui_resources.UiResources, sound: rocket_raylib.Sound, audio_ready: Bool) -> Int:
    var state = initial_state
    while state.running and not rocket_raylib.window_should_close(window):
        let previous = state
        state = update(state, window)
        let sounded = event_sound(previous, state, sound, audio_ready)
        match draw(window, state, resources):
            case Ok(drawn):
                let expected = drawn
            case Err(error):
                print(error)
                return 21
    return 0

fn run_silent(window: rocket_raylib.Window, state: State, resources: ui_resources.UiResources) -> Int:
    let status = loop(window, state, resources, rocket_raylib.Sound(0), false)
    match ui_resources.unload(resources):
        case Ok(unloaded):
            let expected = unloaded
        case Err(error):
            print(error)
            let closed = rocket_raylib.close_window(window)
            return 22
    let closed = rocket_raylib.close_window(window)
    return status

fn run_with_audio(window: rocket_raylib.Window, state: State, resources: ui_resources.UiResources, audio: rocket_raylib.AudioDevice, sound: rocket_raylib.Sound) -> Int:
    let status = loop(window, state, resources, sound, true)
    let stopped = rocket_raylib.stop_sound(sound)
    let sound_closed = rocket_raylib.unload_sound(sound)
    let audio_closed = rocket_raylib.close_audio(audio)
    match ui_resources.unload(resources):
        case Ok(unloaded):
            let expected = unloaded
        case Err(error):
            print(error)
            let window_closed = rocket_raylib.close_window(window)
            return 22
    let window_closed = rocket_raylib.close_window(window)
    return status

pub fn run() -> Int:
    var save_path = "settings.s2r"
    var loaded = persistence.LoadResult(persistence.defaults(), true, "Using fallback local settings path")
    match persistence.default_path():
        case Ok(path):
            save_path = path
            loaded = persistence.load(path)
        case Err(error):
            let expected = error
    match initial(loaded.settings, save_path, loaded.message):
        case Ok(state):
            match rocket_raylib.open_window(state.settings.window_width, state.settings.window_height, "Scroll2Roll"):
                case Ok(window):
                    let fps = rocket_raylib.set_target_fps(window, 60)
                    let resources = ui_resources.load(window)
                    match rocket_raylib.open_audio():
                        case Ok(audio):
                            match rocket_raylib.create_tone(audio, 523.25, 0.08):
                                case Ok(sound):
                                    return run_with_audio(window, state, resources, audio, sound)
                                case Err(error):
                                    let audio_closed = rocket_raylib.close_audio(audio)
                                    return run_silent(window, state, resources)
                        case Err(error):
                            return run_silent(window, state, resources)
                case Err(error):
                    print(error)
                    return 11
        case Err(error):
            print(error)
            return 12
