fn with_error(state: State, error: String) -> State:
    return rebuild(state, state.screen, state.game, state.selected_bet, state.settings, state.notice, error, state.exit_prompt, state.running, state.next_step, state.saved_round)

fn enter_game(state: State, seed: Int) -> State:
    match new_table(state.settings, seed):
        case Ok(game):
            return rebuild(state, 2, game, game.rules.minimum_bet, state.settings, "Blackjack table ready", "", false, true, 0.0, 0)
        case Err(error):
            return with_error(state, error)

fn enter_roulette(state: State, seed: Int) -> State:
    match roulette_api.new_session(state.settings.play_balance, seed):
        case Ok(session):
            let entered = rebuild(state, 4, state.game, state.selected_bet, state.settings, "European Roulette table ready", "", false, true, state.next_step, state.saved_round)
            return with_roulette(roulette_focus(entered, 0, 0), session, 0.0)
        case Err(error):
            return with_error(state, error)

fn enter_plinko(state: State, seed: Int) -> State:
    match plinko_api.new_session(state.settings.play_balance, seed):
        case Ok(session):
            let entered = rebuild(state, 5, state.game, state.selected_bet, state.settings, "Plinko board ready", "", false, true, state.next_step, state.saved_round)
            return with_plinko(entered, session, 0, 0.0)
        case Err(error):
            return with_error(state, error)

fn enter_chicken(state: State, seed: Int) -> State:
    match chicken_api.new_session(state.settings.play_balance, seed):
        case Ok(session):
            let entered = rebuild(state, 6, state.game, state.selected_bet, state.settings, "Coop Climb observatory ready", "", false, true, state.next_step, state.saved_round)
            return with_chicken(entered, session)
        case Err(error):
            return with_error(state, error)

fn enter_crossing(state: State, seed: Int) -> State:
    match crossing_api.new_session(state.settings.play_balance, seed):
        case Ok(session):
            let entered = rebuild(state, 7, state.game, state.selected_bet, state.settings, "Midnight Crossing ready", "", false, true, state.next_step, state.saved_round)
            return with_crossing(entered, session, 0.0)
        case Err(error):
            return with_error(state, error)

fn enter_holdem(state: State, seed: Int) -> State:
    match holdem_api.new_session(state.settings.play_balance, holdem_ai_count(state.settings), seed):
        case Ok(session):
            let entered = rebuild(state, 8, state.game, state.selected_bet, state.settings, "No-Limit Hold'em table ready", "", false, true, state.next_step, state.saved_round)
            return with_holdem(entered, session, 10)
        case Err(error):
            return with_error(state, error)

fn enter_mines(state: State, seed: Int) -> State:
    match mines_api.new_session(state.settings.play_balance, seed):
        case Ok(session):
            let entered = rebuild(state, 9, state.game, state.selected_bet, state.settings, "Mines gem grid ready", "", false, true, state.next_step, state.saved_round)
            return with_mines(entered, session, 0, 0.0)
        case Err(error):
            return with_error(state, error)

fn enter_dice(state: State, seed: Int) -> State:
    match dice_api.new_session(state.settings.play_balance, seed):
        case Ok(session):
            let entered = rebuild(state, 10, state.game, state.selected_bet, state.settings, "Dice signal chamber ready", "", false, true, state.next_step, state.saved_round)
            return with_dice(entered, session, 0.0)
        case Err(error):
            return with_error(state, error)

fn enter_hilo(state: State, seed: Int) -> State:
    match hilo_api.new_session(state.settings.play_balance, seed):
        case Ok(session):
            let entered = rebuild(state, 11, state.game, state.selected_bet, state.settings, "HiLo prediction table ready", "", false, true, state.next_step, state.saved_round)
            return with_hilo(entered, session, 0.0)
        case Err(error):
            return with_error(state, error)

fn route_game(state: State, index: Int) -> State:
    if index == 0 and registry.available(index):
        return enter_game(state, 20260808 + index)
    if index == 1 and registry.available(index):
        return enter_roulette(state, 20260808 + index)
    if index == 2 and registry.available(index):
        return enter_plinko(state, 20260808 + index)
    if index == 3 and registry.available(index):
        return enter_chicken(state, 20260808 + index)
    if index == 4 and registry.available(index):
        return enter_crossing(state, 20260808 + index)
    if index == 5 and registry.available(index):
        return enter_holdem(state, 20260808 + index)
    if index == 6 and registry.available(index):
        return enter_mines(state, 20260808 + index)
    if index == 7 and registry.available(index):
        return enter_dice(state, 20260808 + index)
    if index == 8 and registry.available(index):
        return enter_hilo(state, 20260808 + index)
    return rebuild(state, state.screen, state.game, state.selected_bet, state.settings, "That game is a future placeholder", "", state.exit_prompt, state.running, state.next_step, state.saved_round)

fn change_bet(state: State, delta: Int) -> State:
    let player = state.game.players[0]
    let available = player.balance + player.pending_bet
    var amount = state.selected_bet + delta
    if amount < state.game.rules.minimum_bet:
        amount = state.game.rules.minimum_bet
    if amount > state.game.rules.maximum_bet:
        amount = state.game.rules.maximum_bet
    if amount > available:
        amount = available / state.game.rules.bet_unit * state.game.rules.bet_unit
    match blackjack_engine.set_bet(state.game, 0, amount):
        case Ok(game):
            return rebuild(state, state.screen, game, amount, state.settings, "Bet changed", "", state.exit_prompt, state.running, state.next_step, state.saved_round)
        case Err(error):
            return with_error(state, error)

fn deal(state: State, now: Float) -> State:
    match blackjack_engine.place_ai_bets(state.game):
        case Ok(with_ai_bets):
            match blackjack_engine.start_round(with_ai_bets):
                case Ok(game):
                    return with_game(state, game, now + theme.turn_delay_seconds())
                case Err(error):
                    return with_error(state, error)
        case Err(error):
            return with_error(state, error)

fn apply_action_code(state: State, code: Int, now: Float) -> State:
    let actions = blackjack_engine.available_actions(state.game)
    var index = 0
    while index < actions.length():
        if blackjack_engine.action_code(actions[index]) == code:
            match blackjack_engine.apply_action(state.game, actions[index]):
                case Ok(game):
                    return with_game(state, game, now + theme.turn_delay_seconds())
                case Err(error):
                    return with_error(state, error)
        index = index + 1
    return with_error(state, "That action is not legal for the active hand")

fn next_round(state: State) -> State:
    match blackjack_engine.begin_next_round(state.game):
        case Ok(game):
            match blackjack_engine.set_bet(game, 0, game.rules.minimum_bet):
                case Ok(with_bet):
                    return rebuild(state, 2, with_bet, with_bet.rules.minimum_bet, state.settings, "New round ready", "", false, true, 0.0, state.saved_round)
                case Err(error):
                    return with_error(state, error)
        case Err(error):
            return with_error(state, error)

fn restart_table(state: State) -> State:
    let current_balance = state.game.players[0].balance + state.game.players[0].pending_bet
    let settings = persistence.with_balance(state.settings, current_balance)
    match new_table(settings, state.game.seed + state.game.round_number * 104729):
        case Ok(game):
            return save_settings(rebuild(state, 2, game, game.rules.minimum_bet, settings, "Table restarted", "", false, true, 0.0, state.saved_round), settings)
        case Err(error):
            return with_error(state, error)

fn return_to_lobby(state: State) -> State:
    let balance = state.game.players[0].balance + state.game.players[0].pending_bet
    let settings = persistence.with_balance(state.settings, balance)
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "Progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn settings_audio(state: State) -> State:
    return save_settings(state, persistence.with_audio(state.settings, not state.settings.audio_enabled))

fn settings_volume(state: State, delta: Int) -> State:
    return save_settings(state, persistence.with_volume(state.settings, state.settings.volume_percent + delta))

fn settings_ai(state: State, delta: Int) -> State:
    return save_settings(state, persistence.with_ai_count(state.settings, state.settings.ai_count + delta))

fn lobby_tile(index: Int, width: Int) -> components.Rect:
    let compact_width =(width - 528) / 2
    if index == 7:
        return components.rect(300, 62, compact_width, 40)
    if index == 8:
        return components.rect(308 + compact_width, 62, compact_width, 40)
    if index == 6:
        return components.rect(300, 112, compact_width, 46)
    let tile_width =(width - 128) / 3
    let row = index / 3
    let column = index - row * 3
    return components.rect(32 + column *(tile_width + 32), 170 + row * 180, tile_width, 155)

fn settings_button(width: Int) -> components.Rect:
    return components.rect(width - 190, 32, 158, 44)

fn exit_button(height: Int) -> components.Rect:
    return components.rect(32, height - 76, 140, 44)

fn setting_row_button(row: Int, side: Int, width: Int) -> components.Rect:
    let x = width / 2 + 110 + side * 64
    return components.rect(x, 210 + row * 92, 54, 44)

fn update_lobby(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_l()):
        return route_game(state, 0)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()) or clicked and components.contains(settings_button(width), mouse_x, mouse_y):
        return rebuild(state, 3, state.game, state.selected_bet, state.settings, "Settings", "", false, true, state.next_step, state.saved_round)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(exit_button(height), mouse_x, mouse_y):
        return rebuild(state, state.screen, state.game, state.selected_bet, state.settings, state.notice, "", true, state.running, state.next_step, state.saved_round)
    if clicked:
        var index = 0
        while index < registry.game_count():
            if components.contains(lobby_tile(index, width), mouse_x, mouse_y):
                return route_game(state, index)
            index = index + 1
    return state

fn update_settings(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int) -> State:
    let width = rocket_raylib.window_width(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()):
        return rebuild(state, 1, state.game, state.selected_bet, state.settings, "Settings saved locally", "", false, true, state.next_step, state.saved_round)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_m()):
        return settings_audio(state)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()):
        return settings_volume(state, -10)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()):
        return settings_volume(state, 10)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()):
        return settings_ai(state, -1)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()):
        return settings_ai(state, 1)
    if clicked:
        if components.contains(setting_row_button(0, 0, width), mouse_x, mouse_y):
            return settings_audio(state)
        if components.contains(setting_row_button(1, 0, width), mouse_x, mouse_y):
            return settings_volume(state, -10)
        if components.contains(setting_row_button(1, 1, width), mouse_x, mouse_y):
            return settings_volume(state, 10)
        if components.contains(setting_row_button(2, 0, width), mouse_x, mouse_y):
            return settings_ai(state, -1)
        if components.contains(setting_row_button(2, 1, width), mouse_x, mouse_y):
            return settings_ai(state, 1)
    return state

fn update_game(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int, now: Float) -> State:
    let phase = blackjack_engine.phase_code(state.game.phase)
    let height = rocket_raylib.window_height(window)
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()) or clicked and components.contains(blackjack_view.bet_minus_rect(height), mouse_x, mouse_y):
            return change_bet(state, 10 - 20)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()) or clicked and components.contains(blackjack_view.bet_plus_rect(height), mouse_x, mouse_y):
            return change_bet(state, 10)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(blackjack_view.deal_rect(height), mouse_x, mouse_y):
            return deal(state, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()):
            return return_to_lobby(state)
    if phase == 1 and blackjack_engine.active_player_is_human(state.game):
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_h()):
            return apply_action_code(state, 0, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()):
            return apply_action_code(state, 1, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_d()):
            return apply_action_code(state, 2, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()):
            return apply_action_code(state, 3, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()):
            return apply_action_code(state, 4, now)
        if clicked:
            var code = 0
            while code < 5:
                if components.contains(blackjack_view.action_rect(code, height), mouse_x, mouse_y):
                    return apply_action_code(state, code, now)
                code = code + 1
    if phase == 1 and not blackjack_engine.active_player_is_human(state.game) and now >= state.next_step:
        match blackjack_engine.ai_step(state.game):
            case Ok(game):
                return with_game(state, game, now + theme.turn_delay_seconds())
            case Err(error):
                return with_error(state, error)
    if phase == 2 and now >= state.next_step:
        match blackjack_engine.dealer_step(state.game):
            case Ok(game):
                return with_game(state, game, now + theme.turn_delay_seconds())
            case Err(error):
                return with_error(state, error)
    if phase == 3:
        var settled_state = state
        if state.saved_round != state.game.round_number:
            let settings = persistence.with_balance(state.settings, state.game.players[0].balance)
            settled_state = save_settings(rebuild(state, state.screen, state.game, state.selected_bet, settings, "Round progress saved", "", state.exit_prompt, state.running, state.next_step, state.game.round_number), settings)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(blackjack_view.next_rect(height), mouse_x, mouse_y):
            return next_round(settled_state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()):
            return restart_table(settled_state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(blackjack_view.lobby_rect(height), mouse_x, mouse_y):
            return return_to_lobby(settled_state)
        return settled_state
    return state

fn roulette_chip(current: Int, direction: Int) -> Int:
    let values = [5, 10, 25, 50, 100, 500]
    var index = 0
    while index < collections.length(values):
        if values[index] == current:
            var next = index + direction
            if next < 0:
                next = collections.length(values) - 1
            if next >= collections.length(values):
                next = 0
            return values[next]
        index = index + 1
    return 10

fn roulette_select_chip(state: State, amount: Int) -> State:
    match roulette_api.with_selected_chip(state.roulette, amount):
        case Ok(session):
            return with_roulette(state, session, state.roulette_spin_end)
        case Err(error):
            return with_error(state, error)

fn roulette_change_focus(state: State, kind_delta: Int, target_delta: Int) -> State:
    var kind = state.roulette_kind + kind_delta
    if kind < 0:
        kind = 13
    if kind > 13:
        kind = 0
    var target = state.roulette_target
    if kind_delta != 0:
        target = 0
    else:
        target = target + target_delta
    let count = roulette_view.focus_count(kind)
    if target < 0:
        target = count - 1
    if target >= count:
        target = 0
    return roulette_focus(state, kind, target)

fn roulette_place_focus(state: State) -> State:
    match roulette_view.focus_bet(state.roulette_kind, state.roulette_target, state.roulette.game.selected_chip):
        case Ok(bet):
            match roulette_api.with_bet(state.roulette, bet):
                case Ok(session):
                    return with_roulette(state, session, state.roulette_spin_end)
                case Err(error):
                    return with_error(state, error)
        case Err(error):
            return with_error(state, error)

fn roulette_place_mouse(state: State, mouse_x: Int, mouse_y: Int, width: Int) -> State:
    match roulette_view.mouse_bet(mouse_x, mouse_y, width, state.roulette.game.selected_chip):
        case Ok(bet):
            match roulette_api.with_bet(state.roulette, bet):
                case Ok(session):
                    return with_roulette(state, session, state.roulette_spin_end)
                case Err(error):
                    return with_error(state, error)
        case Err(error):
            return state

fn roulette_return_to_lobby(state: State) -> State:
    if roulette_api.phase_code(state.roulette.game) == 1 or roulette_api.phase_code(state.roulette.game) == 0 and collections.length(state.roulette.game.bets) > 0:
        return with_error(state, "Settle the spin or clear live Roulette bets before leaving")
    let settings = persistence.with_balance(state.settings, state.roulette.game.balance)
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "Roulette progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn update_roulette(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int, now: Float) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()) or clicked and components.contains(roulette_view.help_rect(width), mouse_x, mouse_y):
        return roulette_help(state, not state.roulette_help)
    if state.roulette_help:
        return state
    let phase = roulette_api.phase_code(state.roulette.game)
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_tab()):
            return roulette_change_focus(state, 1, 0)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()):
            return roulette_change_focus(state, 0, -1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()):
            return roulette_change_focus(state, 0, 1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()):
            return roulette_select_chip(state, roulette_chip(state.roulette.game.selected_chip, 1))
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()):
            return roulette_select_chip(state, roulette_chip(state.roulette.game.selected_chip, -1))
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()):
            return roulette_place_focus(state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_h()) or clicked and components.contains(roulette_view.undo_rect(height), mouse_x, mouse_y):
            match roulette_api.with_undo(state.roulette):
                case Ok(session):
                    return with_roulette(state, session, state.roulette_spin_end)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_d()) or clicked and components.contains(roulette_view.clear_rect(height), mouse_x, mouse_y):
            match roulette_api.with_clear(state.roulette):
                case Ok(session):
                    return with_roulette(state, session, state.roulette_spin_end)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()) or clicked and components.contains(roulette_view.repeat_rect(height), mouse_x, mouse_y):
            match roulette_api.with_repeat(state.roulette):
                case Ok(session):
                    return with_roulette(state, session, state.roulette_spin_end)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()) or clicked and components.contains(roulette_view.spin_rect(height), mouse_x, mouse_y):
            match roulette_api.with_spin(state.roulette):
                case Ok(session):
                    return with_roulette(state, session, now + 2.0)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()):
            return roulette_return_to_lobby(state)
        if clicked:
            var chip_index = 0
            while chip_index < 6:
                if components.contains(roulette_view.chip_rect(chip_index, width), mouse_x, mouse_y):
                    return roulette_select_chip(state, roulette_view.chip_value(chip_index))
                chip_index = chip_index + 1
            if roulette_view.is_bet_target(mouse_x, mouse_y, width):
                return roulette_place_mouse(state, mouse_x, mouse_y, width)
    if phase == 1 and now >= state.roulette_spin_end:
        match roulette_api.with_settlement(state.roulette):
            case Ok(session):
                let settings = persistence.with_balance(state.settings, session.game.balance)
                return save_settings(with_roulette(rebuild(state, state.screen, state.game, state.selected_bet, settings, "Roulette spin saved", "", false, true, state.next_step, state.saved_round), session, state.roulette_spin_end), settings)
            case Err(error):
                return with_error(state, error)
    if phase == 2:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(roulette_view.next_rect(height), mouse_x, mouse_y):
            match roulette_api.with_next_round(state.roulette):
                case Ok(session):
                    return with_roulette(state, session, 0.0)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()) or clicked and components.contains(roulette_view.rebet_rect(height), mouse_x, mouse_y):
            match roulette_api.with_rebet(state.roulette):
                case Ok(session):
                    return with_roulette(state, session, 0.0)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or clicked and components.contains(roulette_view.lobby_rect(height), mouse_x, mouse_y) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()):
            return roulette_return_to_lobby(state)
    return state

fn plinko_configure_rows(state: State, delta: Int) -> State:
    var rows = state.plinko.game.rows + delta
    if rows < 8:
        rows = 16
    if rows > 16:
        rows = 8
    match plinko_api.with_rows(state.plinko, rows):
        case Ok(session):
            return with_plinko(state, session, state.plinko_stage, state.plinko_next_step)
        case Err(error):
            return with_error(state, error)

fn plinko_cycle_risk(state: State) -> State:
    var code = plinko_api.risk_code(state.plinko) + 1
    if code > 2:
        code = 0
    match plinko_api.with_risk_code(state.plinko, code):
        case Ok(session):
            return with_plinko(state, session, state.plinko_stage, state.plinko_next_step)
        case Err(error):
            return with_error(state, error)

fn plinko_configure_bet(state: State, delta: Int) -> State:
    var bet = state.plinko.game.bet + delta
    if bet < 5:
        bet = 5
    if bet > 1000:
        bet = 1000
    match plinko_api.with_bet(state.plinko, bet):
        case Ok(session):
            return with_plinko(state, session, state.plinko_stage, state.plinko_next_step)
        case Err(error):
            return with_error(state, error)

fn plinko_configure_batch(state: State, delta: Int) -> State:
    var count = state.plinko.game.batch_count + delta
    if count < 1:
        count = 10
    if count > 10:
        count = 1
    match plinko_api.with_batch(state.plinko, count):
        case Ok(session):
            return with_plinko(state, session, state.plinko_stage, state.plinko_next_step)
        case Err(error):
            return with_error(state, error)

fn plinko_start(state: State, now: Float) -> State:
    match plinko_api.with_drop(state.plinko):
        case Ok(session):
            return with_plinko(state, session, 0, now + 0.08)
        case Err(error):
            return with_error(state, error)

fn plinko_return_to_lobby(state: State) -> State:
    if plinko_engine_phase(state) == 1:
        return with_error(state, "Finish the bounded Plinko animation before leaving")
    let settings = persistence.with_balance(state.settings, state.plinko.game.balance)
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "Plinko progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn plinko_engine_phase(state: State) -> Int:
    return plinko_api.phase_code(state.plinko)

fn update_plinko(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int, now: Float) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()) or clicked and components.contains(plinko_view.help_rect(width), mouse_x, mouse_y):
        return plinko_help(state, not state.plinko_help)
    if state.plinko_help:
        return state
    let phase = plinko_engine_phase(state)
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()) or clicked and components.contains(plinko_view.rows_minus_rect(width), mouse_x, mouse_y):
            return plinko_configure_rows(state, -1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()) or clicked and components.contains(plinko_view.rows_plus_rect(width), mouse_x, mouse_y):
            return plinko_configure_rows(state, 1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_tab()) or clicked and components.contains(plinko_view.risk_rect(width), mouse_x, mouse_y):
            return plinko_cycle_risk(state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()) or clicked and components.contains(plinko_view.bet_minus_rect(width), mouse_x, mouse_y):
            return plinko_configure_bet(state, -5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()) or clicked and components.contains(plinko_view.bet_plus_rect(width), mouse_x, mouse_y):
            return plinko_configure_bet(state, 5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_m()):
            return plinko_configure_batch(state, 1)
        if clicked and components.contains(plinko_view.batch_minus_rect(width), mouse_x, mouse_y):
            return plinko_configure_batch(state, -1)
        if clicked and components.contains(plinko_view.batch_plus_rect(width), mouse_x, mouse_y):
            return plinko_configure_batch(state, 1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(plinko_view.drop_rect(width), mouse_x, mouse_y):
            return plinko_start(state, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()):
            return plinko_return_to_lobby(state)
    if phase == 1 and now >= state.plinko_next_step:
        let final_stage = state.plinko.game.rows +(state.plinko.game.batch_count - 1) * 2
        if state.plinko_stage >= final_stage:
            match plinko_api.with_settlement(state.plinko):
                case Ok(session):
                    let settings = persistence.with_balance(state.settings, session.game.balance)
                    return save_settings(with_plinko(rebuild(state, state.screen, state.game, state.selected_bet, settings, "Plinko batch saved", "", false, true, state.next_step, state.saved_round), session, state.plinko_stage, state.plinko_next_step), settings)
                case Err(error):
                    return with_error(state, error)
        return with_plinko(state, state.plinko, state.plinko_stage + 1, now + 0.08)
    if phase == 2:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(plinko_view.next_rect(height), mouse_x, mouse_y):
            match plinko_api.with_next_round(state.plinko):
                case Ok(session):
                    return with_plinko(state, session, 0, 0.0)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(plinko_view.lobby_rect(height), mouse_x, mouse_y):
            return plinko_return_to_lobby(state)
    return state

fn chicken_cycle_risk(state: State) -> State:
    var code = chicken_api.risk_code(state.chicken) + 1
    if code > 2:
        code = 0
    match chicken_api.with_risk_code(state.chicken, code):
        case Ok(session):
            return with_chicken(state, session)
        case Err(error):
            return with_error(state, error)

fn chicken_configure_bet(state: State, delta: Int) -> State:
    var bet = state.chicken.game.bet + delta
    if bet < 5:
        bet = 5
    if bet > 1000:
        bet = 1000
    match chicken_api.with_bet(state.chicken, bet):
        case Ok(session):
            return with_chicken(state, session)
        case Err(error):
            return with_error(state, error)

fn chicken_save_settlement(state: State, session: chicken_api.Session) -> State:
    let settings = persistence.with_balance(state.settings, session.game.balance)
    return save_settings(with_chicken(rebuild(state, state.screen, state.game, state.selected_bet, settings, "Coop Climb result saved", "", false, true, state.next_step, state.saved_round), session), settings)

fn chicken_start(state: State) -> State:
    match chicken_api.with_start(state.chicken):
        case Ok(session):
            return with_chicken(state, session)
        case Err(error):
            return with_error(state, error)

fn chicken_advance(state: State) -> State:
    match chicken_api.with_advance(state.chicken):
        case Ok(session):
            if chicken_api.phase_code(session) == 2:
                return chicken_save_settlement(state, session)
            return with_chicken(state, session)
        case Err(error):
            return with_error(state, error)

fn chicken_cash_out(state: State) -> State:
    match chicken_api.with_cash_out(state.chicken):
        case Ok(session):
            return chicken_save_settlement(state, session)
        case Err(error):
            return with_error(state, error)

fn chicken_return_to_lobby(state: State) -> State:
    if chicken_api.phase_code(state.chicken) == 1:
        return with_error(state, "Cash out or finish the active Coop Climb round")
    let settings = persistence.with_balance(state.settings, state.chicken.game.balance)
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "Coop Climb progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn update_chicken(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()) or clicked and components.contains(chicken_view.help_rect(width), mouse_x, mouse_y):
        return chicken_help(state, not state.chicken_help)
    if state.chicken_help:
        return state
    let phase = chicken_api.phase_code(state.chicken)
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_tab()) or clicked and components.contains(chicken_view.risk_rect(width), mouse_x, mouse_y):
            return chicken_cycle_risk(state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()) or clicked and components.contains(chicken_view.bet_minus_rect(width), mouse_x, mouse_y):
            return chicken_configure_bet(state, -5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()) or clicked and components.contains(chicken_view.bet_plus_rect(width), mouse_x, mouse_y):
            return chicken_configure_bet(state, 5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(chicken_view.start_rect(width), mouse_x, mouse_y):
            return chicken_start(state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(chicken_view.lobby_rect(height), mouse_x, mouse_y):
            return chicken_return_to_lobby(state)
    if phase == 1:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(chicken_view.advance_rect(width), mouse_x, mouse_y):
            return chicken_advance(state)
        if state.chicken.game.survived_depth > 0 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()) or clicked and components.contains(chicken_view.cash_out_rect(width), mouse_x, mouse_y)):
            return chicken_cash_out(state)
    if phase == 2:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(chicken_view.next_rect(height), mouse_x, mouse_y):
            match chicken_api.with_next_round(state.chicken):
                case Ok(session):
                    return with_chicken(state, session)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(chicken_view.lobby_rect(height), mouse_x, mouse_y):
            return chicken_return_to_lobby(state)
    return state

fn crossing_configure_bet(state: State, delta: Int) -> State:
    var bet = state.crossing.game.bet + delta
    if bet < 5:
        bet = 5
    if bet > 1000:
        bet = 1000
    match crossing_api.with_bet(state.crossing, bet):
        case Ok(session):
            return with_crossing(state, session, state.crossing_accumulator)
        case Err(error):
            return with_error(state, error)

fn crossing_save_settlement(state: State, session: crossing_api.Session) -> State:
    let settings = persistence.with_balance(state.settings, session.game.balance)
    return save_settings(with_crossing(rebuild(state, state.screen, state.game, state.selected_bet, settings, "Midnight Crossing result saved", "", false, true, state.next_step, state.saved_round), session, 0.0), settings)

fn crossing_start(state: State) -> State:
    match crossing_api.with_start(state.crossing):
        case Ok(session):
            return with_crossing(state, session, 0.0)
        case Err(error):
            return with_error(state, error)

fn crossing_move(state: State, horizontal: Int, vertical: Int) -> State:
    match crossing_api.with_move(state.crossing, horizontal, vertical):
        case Ok(session):
            if crossing_api.phase_code(session) == 2:
                return crossing_save_settlement(state, session)
            return with_crossing(state, session, state.crossing_accumulator)
        case Err(error):
            return with_error(state, error)

fn crossing_cash_out(state: State) -> State:
    match crossing_api.with_cash_out(state.crossing):
        case Ok(session):
            return crossing_save_settlement(state, session)
        case Err(error):
            return with_error(state, error)

fn crossing_toggle_help(state: State) -> State:
    let visible = not state.crossing_help
    if crossing_api.phase_code(state.crossing) == 1:
        match crossing_api.with_pause(state.crossing):
            case Ok(session):
                return with_crossing(crossing_help(state, visible), session, state.crossing_accumulator)
            case Err(error):
                return with_error(state, error)
    return crossing_help(state, visible)

fn crossing_return_to_lobby(state: State) -> State:
    if crossing_api.phase_code(state.crossing) == 1:
        return with_error(state, "Finish or cash out the active Midnight Crossing run")
    let settings = persistence.with_balance(state.settings, state.crossing.game.balance)
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "Midnight Crossing progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn crossing_ticks(state: State, window: rocket_raylib.Window) -> State:
    var accumulator = state.crossing_accumulator + rocket_raylib.frame_time(window)
    var ticks = 0
    while accumulator >= 0.05 and ticks < 8:
        accumulator = accumulator - 0.05
        ticks = ticks + 1
    if ticks >= 8 and accumulator >= 0.05:
        accumulator = 0.0
    if ticks == 0:
        return with_crossing(state, state.crossing, accumulator)
    match crossing_api.with_ticks(state.crossing, ticks):
        case Ok(session):
            if crossing_api.phase_code(session) == 2:
                return crossing_save_settlement(state, session)
            return with_crossing(state, session, accumulator)
        case Err(error):
            return with_error(state, error)

fn update_crossing(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()) or clicked and(components.contains(crossing_view.help_rect(width), mouse_x, mouse_y) or crossing_api.phase_code(state.crossing) == 1 and components.contains(crossing_view.pause_rect(width), mouse_x, mouse_y)):
        return crossing_toggle_help(state)
    if state.crossing_help:
        return state
    let phase = crossing_api.phase_code(state.crossing)
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()) or clicked and components.contains(crossing_view.bet_minus_rect(width), mouse_x, mouse_y):
            return crossing_configure_bet(state, -5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()) or clicked and components.contains(crossing_view.bet_plus_rect(width), mouse_x, mouse_y):
            return crossing_configure_bet(state, 5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(crossing_view.start_rect(width), mouse_x, mouse_y):
            return crossing_start(state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(crossing_view.lobby_rect(height), mouse_x, mouse_y):
            return crossing_return_to_lobby(state)
    if phase == 1:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()) or clicked and components.contains(crossing_view.up_rect(width), mouse_x, mouse_y):
            return crossing_move(state, 0, 1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()) or clicked and components.contains(crossing_view.down_rect(width), mouse_x, mouse_y):
            return crossing_move(state, 0, -1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()) or clicked and components.contains(crossing_view.left_rect(width), mouse_x, mouse_y):
            return crossing_move(state, -1, 0)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()) or clicked and components.contains(crossing_view.right_rect(width), mouse_x, mouse_y):
            return crossing_move(state, 1, 0)
        if state.crossing.game.checkpoints > 0 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()) or clicked and components.contains(crossing_view.cash_out_rect(width), mouse_x, mouse_y)):
            return crossing_cash_out(state)
        return crossing_ticks(state, window)
    if phase == 2:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(crossing_view.next_rect(height), mouse_x, mouse_y):
            match crossing_api.with_next_round(state.crossing):
                case Ok(session):
                    return with_crossing(state, session, 0.0)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(crossing_view.lobby_rect(height), mouse_x, mouse_y):
            return crossing_return_to_lobby(state)
    return state

fn holdem_target_for(session: holdem_api.Session, requested: Int) -> Int:
    if not holdem_api.human_turn(session):
        return 10
    let minimum = holdem_api.minimum_target(session)
    let maximum = holdem_api.maximum_target(session)
    var target = requested
    if target < minimum:
        target = minimum
    if target > maximum:
        target = maximum
    return target

fn holdem_save_settlement(state: State, session: holdem_api.Session) -> State:
    let settings = persistence.with_balance(state.settings, holdem_api.human_balance(session))
    return save_settings(with_holdem(state, session, holdem_target_for(session, state.holdem_target)), settings)

fn holdem_deal(state: State) -> State:
    match holdem_api.with_deal(state.holdem):
        case Ok(session):
            return with_holdem(state, session, holdem_target_for(session, 20))
        case Err(error):
            return with_error(state, error)

fn holdem_action(state: State, action: Int) -> State:
    var target = 0
    if action == 3:
        target = state.holdem_target
    match holdem_api.with_human_action(state.holdem, action, target):
        case Ok(session):
            if holdem_api.phase_code(session) == 2:
                return holdem_save_settlement(state, session)
            return with_holdem(state, session, holdem_target_for(session, state.holdem_target))
        case Err(error):
            return with_error(state, error)

fn holdem_change_target(state: State, delta: Int) -> State:
    return with_holdem(state, state.holdem, holdem_target_for(state.holdem, state.holdem_target + delta))

fn holdem_reset(state: State) -> State:
    match holdem_api.with_reset_table(state.holdem):
        case Ok(session):
            let settings = persistence.with_balance(state.settings, holdem_api.human_balance(session))
            return save_settings(with_holdem(state, session, 10), settings)
        case Err(error):
            return with_error(state, error)

fn holdem_next(state: State) -> State:
    match holdem_api.with_next_hand(state.holdem):
        case Ok(session):
            if holdem_api.phase_code(session) == 2:
                return holdem_save_settlement(state, session)
            return with_holdem(state, session, holdem_target_for(session, 20))
        case Err(error):
            return with_error(state, error)

fn holdem_return_to_lobby(state: State) -> State:
    if holdem_api.phase_code(state.holdem) == 1:
        return with_error(state, "Finish the active Hold'em hand before returning")
    let settings = persistence.with_balance(state.settings, holdem_api.human_balance(state.holdem))
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "Hold'em progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn update_holdem(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()) or clicked and components.contains(holdem_view.help_rect(width), mouse_x, mouse_y):
        return holdem_help(state, not state.holdem_help)
    if state.holdem_help:
        return state
    let phase = holdem_api.phase_code(state.holdem)
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(holdem_view.deal_rect(width), mouse_x, mouse_y):
            return holdem_deal(state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()) or clicked and components.contains(holdem_view.reset_rect(width), mouse_x, mouse_y):
            return holdem_reset(state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(holdem_view.lobby_rect(height), mouse_x, mouse_y):
            return holdem_return_to_lobby(state)
    if phase == 1 and holdem_api.human_turn(state.holdem):
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()) or clicked and components.contains(holdem_view.target_minus_rect(width), mouse_x, mouse_y):
            return holdem_change_target(state, -10)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()) or clicked and components.contains(holdem_view.target_plus_rect(width), mouse_x, mouse_y):
            return holdem_change_target(state, 10)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_d()) or clicked and components.contains(holdem_view.fold_rect(width), mouse_x, mouse_y):
            return holdem_action(state, 0)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(holdem_view.call_rect(width), mouse_x, mouse_y):
            if holdem_api.call_amount(state.holdem) > 0:
                return holdem_action(state, 2)
            return holdem_action(state, 1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()) or clicked and components.contains(holdem_view.raise_rect(width), mouse_x, mouse_y):
            return holdem_action(state, 3)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_h()) or clicked and components.contains(holdem_view.all_in_rect(width), mouse_x, mouse_y):
            return holdem_action(state, 4)
    if phase == 2:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(holdem_view.next_rect(height), mouse_x, mouse_y):
            return holdem_next(state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()) or clicked and components.contains(holdem_view.reset_rect(width), mouse_x, mouse_y):
            return holdem_reset(state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(holdem_view.lobby_rect(height), mouse_x, mouse_y):
            return holdem_return_to_lobby(state)
    return state

fn mines_configure_bet(state: State, delta: Int) -> State:
    var bet = state.mines.game.bet + delta
    if bet < 5:
        bet = 5
    if bet > 1000:
        bet = 1000
    match mines_api.with_bet(state.mines, bet):
        case Ok(session):
            return with_mines(state, session, state.mines_selected, state.mines_animation_end)
        case Err(error):
            return with_error(state, error)

fn mines_configure_count(state: State, delta: Int) -> State:
    var count = state.mines.game.mine_count + delta
    if count < 1:
        count = 1
    if count > 24:
        count = 24
    match mines_api.with_mine_count(state.mines, count):
        case Ok(session):
            return with_mines(state, session, state.mines_selected, state.mines_animation_end)
        case Err(error):
            return with_error(state, error)

fn mines_start(state: State) -> State:
    match mines_api.with_start(state.mines):
        case Ok(session):
            return with_mines(state, session, 0, 0.0)
        case Err(error):
            return with_error(state, error)

fn mines_save_settlement(state: State, session: mines_api.Session, animation_end: Float) -> State:
    let settings = persistence.with_balance(state.settings, session.game.balance)
    return save_settings(with_mines(rebuild(state, state.screen, state.game, state.selected_bet, settings, "Mines result saved", "", false, true, state.next_step, state.saved_round), session, state.mines_selected, animation_end), settings)

fn mines_reveal(state: State, tile: Int, now: Float) -> State:
    match mines_api.with_reveal(state.mines, tile):
        case Ok(session):
            if mines_api.phase_code(session) == 2:
                return mines_save_settlement(state, session, now + 0.24)
            return with_mines(state, session, tile, now + 0.18)
        case Err(error):
            return with_error(state, error)

fn mines_cash_out(state: State, now: Float) -> State:
    match mines_api.with_cash_out(state.mines):
        case Ok(session):
            return mines_save_settlement(state, session, now + 0.24)
        case Err(error):
            return with_error(state, error)

fn mines_return_to_lobby(state: State) -> State:
    if mines_api.phase_code(state.mines) == 1:
        return with_error(state, "Cash out or finish the active Mines round")
    let settings = persistence.with_balance(state.settings, state.mines.game.balance)
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "Mines progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn mines_restart(state: State) -> State:
    match mines_api.with_restart(state.mines):
        case Ok(session):
            return with_mines(state, session, 0, 0.0)
        case Err(error):
            return with_error(state, error)

fn mines_move_selection(state: State, delta: Int) -> State:
    var selected = state.mines_selected + delta
    if selected < 0:
        selected = 0
    if selected > 24:
        selected = 24
    return with_mines(state, state.mines, selected, state.mines_animation_end)

fn update_mines(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int, now: Float) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()) or clicked and components.contains(mines_view.help_rect(width), mouse_x, mouse_y):
        return mines_help(state, not state.mines_help)
    if state.mines_help:
        return state
    if now < state.mines_animation_end:
        return state
    let phase = mines_api.phase_code(state.mines)
    if phase != 1 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()) or clicked and components.contains(mines_view.restart_rect(height), mouse_x, mouse_y)):
        return mines_restart(state)
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()) or clicked and components.contains(mines_view.bet_minus_rect(width), mouse_x, mouse_y):
            return mines_configure_bet(state, -5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()) or clicked and components.contains(mines_view.bet_plus_rect(width), mouse_x, mouse_y):
            return mines_configure_bet(state, 5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()) or clicked and components.contains(mines_view.mines_minus_rect(width), mouse_x, mouse_y):
            return mines_configure_count(state, -1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()) or clicked and components.contains(mines_view.mines_plus_rect(width), mouse_x, mouse_y):
            return mines_configure_count(state, 1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(mines_view.start_rect(width), mouse_x, mouse_y):
            return mines_start(state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(mines_view.lobby_rect(height), mouse_x, mouse_y):
            return mines_return_to_lobby(state)
    if phase == 1:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()):
            return mines_move_selection(state, -1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()):
            return mines_move_selection(state, 1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()):
            return mines_move_selection(state, -5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()):
            return mines_move_selection(state, 5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()):
            return mines_reveal(state, state.mines_selected, now)
        if state.mines.game.safe_reveals > 0 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()) or clicked and components.contains(mines_view.cash_out_rect(width), mouse_x, mouse_y)):
            return mines_cash_out(state, now)
        if clicked:
            var tile = 0
            while tile < 25:
                if components.contains(mines_view.tile_rect(tile), mouse_x, mouse_y):
                    return mines_reveal(state, tile, now)
                tile = tile + 1
    if phase == 2:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(mines_view.next_rect(height), mouse_x, mouse_y):
            match mines_api.with_next_round(state.mines):
                case Ok(session):
                    return with_mines(state, session, 0, 0.0)
                case Err(error):
                    return with_error(state, error)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(mines_view.lobby_rect(height), mouse_x, mouse_y):
            return mines_return_to_lobby(state)
    return state

fn dice_configure_target(state: State, delta: Int) -> State:
    var target = state.dice.game.target + delta
    if target < 1:
        target = 1
    if target > 9999:
        target = 9999
    match dice_api.with_target(state.dice, target):
        case Ok(session):
            return with_dice(state, session, state.dice_animation_end)
        case Err(error):
            return with_error(state, error)

fn dice_toggle_direction(state: State) -> State:
    var code = dice_rules.direction_code(state.dice.game.direction) + 1
    if code > 1:
        code = 0
    match dice_api.with_direction_code(state.dice, code):
        case Ok(session):
            return with_dice(state, session, state.dice_animation_end)
        case Err(error):
            return with_error(state, error)

fn dice_configure_bet(state: State, delta: Int) -> State:
    var bet = state.dice.game.bet + delta
    if bet < 5:
        bet = 5
    if bet > 1000:
        bet = 1000
    match dice_api.with_bet(state.dice, bet):
        case Ok(session):
            return with_dice(state, session, state.dice_animation_end)
        case Err(error):
            return with_error(state, error)

fn dice_configure_auto(state: State, kind: Int) -> State:
    var count = state.dice.game.auto_count
    var wins = state.dice.game.stop_wins
    var losses = state.dice.game.stop_losses
    if kind == 0:
        count = count + 1
        if count > 20:
            count = 1
    if kind == 1:
        wins = wins + 1
        if wins > 20:
            wins = 0
    if kind == 2:
        losses = losses + 1
        if losses > 20:
            losses = 0
    match dice_api.with_auto(state.dice, count, wins, losses):
        case Ok(session):
            return with_dice(state, session, state.dice_animation_end)
        case Err(error):
            return with_error(state, error)

fn dice_save_settlement(state: State, session: dice_api.Session, animation_end: Float) -> State:
    let settings = persistence.with_balance(state.settings, session.game.balance)
    return save_settings(with_dice(rebuild(state, state.screen, state.game, state.selected_bet, settings, "Dice result saved", "", false, true, state.next_step, state.saved_round), session, animation_end), settings)

fn dice_manual_roll(state: State, now: Float) -> State:
    match dice_api.with_roll(state.dice):
        case Ok(session):
            return dice_save_settlement(state, session, now + 0.22)
        case Err(error):
            return with_error(state, error)

fn dice_start_auto(state: State, now: Float) -> State:
    match dice_api.with_start_auto(state.dice):
        case Ok(session):
            return with_dice(state, session, now)
        case Err(error):
            return with_error(state, error)

fn dice_auto_step(state: State, now: Float) -> State:
    match dice_api.with_auto_step(state.dice):
        case Ok(session):
            if dice_api.phase_code(session) == 2:
                return dice_save_settlement(state, session, now + 0.14)
            return with_dice(state, session, now + 0.14)
        case Err(error):
            return with_error(state, error)

fn dice_stop_auto(state: State, now: Float) -> State:
    match dice_api.with_stop_auto(state.dice):
        case Ok(session):
            return dice_save_settlement(state, session, now + 0.10)
        case Err(error):
            return with_error(state, error)

fn dice_next(state: State) -> State:
    match dice_api.with_next_round(state.dice):
        case Ok(session):
            return with_dice(state, session, 0.0)
        case Err(error):
            return with_error(state, error)

fn dice_restart(state: State) -> State:
    match dice_api.with_restart(state.dice):
        case Ok(session):
            return with_dice(state, session, 0.0)
        case Err(error):
            return with_error(state, error)

fn dice_return_to_lobby(state: State) -> State:
    if dice_api.phase_code(state.dice) == 1:
        return with_error(state, "Stop the active finite Dice auto-roll before leaving")
    let settings = persistence.with_balance(state.settings, state.dice.game.balance)
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "Dice progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn update_dice(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int, now: Float) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()) or clicked and components.contains(dice_view.help_rect(width), mouse_x, mouse_y):
        return dice_help(state, not state.dice_help)
    if state.dice_help:
        return state
    let phase = dice_api.phase_code(state.dice)
    if phase == 1:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()) or clicked and components.contains(dice_view.auto_rect(width), mouse_x, mouse_y):
            return dice_stop_auto(state, now)
        if now >= state.dice_animation_end:
            return dice_auto_step(state, now)
        return state
    if now < state.dice_animation_end:
        return state
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_tab()) or clicked and components.contains(dice_view.direction_rect(width), mouse_x, mouse_y):
            return dice_toggle_direction(state)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()) or clicked and components.contains(dice_view.target_minus_rect(width), mouse_x, mouse_y):
            return dice_configure_target(state, -100)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()) or clicked and components.contains(dice_view.target_plus_rect(width), mouse_x, mouse_y):
            return dice_configure_target(state, 100)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()) or clicked and components.contains(dice_view.bet_minus_rect(width), mouse_x, mouse_y):
            return dice_configure_bet(state, -5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()) or clicked and components.contains(dice_view.bet_plus_rect(width), mouse_x, mouse_y):
            return dice_configure_bet(state, 5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_m()) or clicked and components.contains(dice_view.auto_count_rect(width), mouse_x, mouse_y):
            return dice_configure_auto(state, 0)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_h()) or clicked and components.contains(dice_view.win_stop_rect(width), mouse_x, mouse_y):
            return dice_configure_auto(state, 1)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_d()) or clicked and components.contains(dice_view.loss_stop_rect(width), mouse_x, mouse_y):
            return dice_configure_auto(state, 2)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(dice_view.roll_rect(width), mouse_x, mouse_y):
            return dice_manual_roll(state, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()) or clicked and components.contains(dice_view.auto_rect(width), mouse_x, mouse_y):
            return dice_start_auto(state, now)
    if phase == 2 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(dice_view.next_rect(height), mouse_x, mouse_y)):
        return dice_next(state)
    if phase != 1 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()) or clicked and components.contains(dice_view.restart_rect(height), mouse_x, mouse_y)):
        return dice_restart(state)
    if phase != 1 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(dice_view.lobby_rect(height), mouse_x, mouse_y)):
        return dice_return_to_lobby(state)
    return state

fn hilo_configure_bet(state: State, delta: Int) -> State:
    var bet = state.hilo.game.bet + delta
    if bet < 5:
        bet = 5
    if bet > 1000:
        bet = 1000
    match hilo_api.with_bet(state.hilo, bet):
        case Ok(session):
            return with_hilo(state, session, state.hilo_animation_end)
        case Err(error):
            return with_error(state, error)

fn hilo_start(state: State) -> State:
    match hilo_api.with_start(state.hilo):
        case Ok(session):
            return with_hilo(state, session, 0.0)
        case Err(error):
            return with_error(state, error)

fn hilo_save_settlement(state: State, session: hilo_api.Session, animation_end: Float) -> State:
    let settings = persistence.with_balance(state.settings, session.game.balance)
    return save_settings(with_hilo(rebuild(state, state.screen, state.game, state.selected_bet, settings, "HiLo result saved", "", false, true, state.next_step, state.saved_round), session, animation_end), settings)

fn hilo_predict(state: State, code: Int, now: Float) -> State:
    match hilo_api.with_prediction_code(state.hilo, code):
        case Ok(session):
            if hilo_api.phase_code(session) == 2:
                return hilo_save_settlement(state, session, now + 0.22)
            return with_hilo(state, session, now + 0.22)
        case Err(error):
            return with_error(state, error)

fn hilo_cash_out(state: State, now: Float) -> State:
    match hilo_api.with_cash_out(state.hilo):
        case Ok(session):
            return hilo_save_settlement(state, session, now + 0.16)
        case Err(error):
            return with_error(state, error)

fn hilo_next(state: State) -> State:
    match hilo_api.with_next_round(state.hilo):
        case Ok(session):
            return with_hilo(state, session, 0.0)
        case Err(error):
            return with_error(state, error)

fn hilo_restart(state: State) -> State:
    match hilo_api.with_restart(state.hilo):
        case Ok(session):
            return with_hilo(state, session, 0.0)
        case Err(error):
            return with_error(state, error)

fn hilo_return_to_lobby(state: State) -> State:
    if hilo_api.phase_code(state.hilo) == 1:
        return with_error(state, "Finish or cash out the active HiLo round before leaving")
    let settings = persistence.with_balance(state.settings, state.hilo.game.balance)
    return save_settings(rebuild(state, 1, state.game, state.selected_bet, settings, "HiLo progress saved; welcome back", "", false, true, state.next_step, state.saved_round), settings)

fn update_hilo(state: State, window: rocket_raylib.Window, clicked: Bool, mouse_x: Int, mouse_y: Int, now: Float) -> State:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    if rocket_raylib.is_key_pressed(window, rocket_raylib.key_p()) or clicked and components.contains(hilo_view.help_rect(width), mouse_x, mouse_y):
        return hilo_help(state, not state.hilo_help)
    if state.hilo_help:
        return state
    if now < state.hilo_animation_end:
        return state
    let phase = hilo_api.phase_code(state.hilo)
    if phase == 0:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_down()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_left()) or clicked and components.contains(hilo_view.bet_minus_rect(width), mouse_x, mouse_y):
            return hilo_configure_bet(state, -5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_up()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_right()) or clicked and components.contains(hilo_view.bet_plus_rect(width), mouse_x, mouse_y):
            return hilo_configure_bet(state, 5)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or clicked and components.contains(hilo_view.start_rect(width), mouse_x, mouse_y):
            return hilo_start(state)
    if phase == 1:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_l()) or clicked and components.contains(hilo_view.lower_rect(), mouse_x, mouse_y):
            return hilo_predict(state, 0, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_h()) or clicked and components.contains(hilo_view.higher_rect(), mouse_x, mouse_y):
            return hilo_predict(state, 1, now)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_s()) or clicked and components.contains(hilo_view.cash_out_rect(width), mouse_x, mouse_y):
            return hilo_cash_out(state, now)
    if phase == 2 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_n()) or clicked and components.contains(hilo_view.next_rect(height), mouse_x, mouse_y)):
        return hilo_next(state)
    if phase != 1 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_r()) or clicked and components.contains(hilo_view.restart_rect(height), mouse_x, mouse_y)):
        return hilo_restart(state)
    if phase != 1 and(rocket_raylib.is_key_pressed(window, rocket_raylib.key_b()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked and components.contains(hilo_view.lobby_rect(height), mouse_x, mouse_y)):
        return hilo_return_to_lobby(state)
    return state

fn update(state: State, window: rocket_raylib.Window) -> State:
    let clicked = rocket_raylib.is_mouse_pressed(window, rocket_raylib.mouse_left())
    let mouse_x = rocket_raylib.mouse_x(window)
    let mouse_y = rocket_raylib.mouse_y(window)
    if state.error != "":
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()) or clicked:
            return rebuild(state, state.screen, state.game, state.selected_bet, state.settings, state.notice, "", state.exit_prompt, state.running, state.next_step, state.saved_round)
        return state
    if state.exit_prompt:
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()):
            return rebuild(state, state.screen, state.game, state.selected_bet, state.settings, state.notice, "", false, false, state.next_step, state.saved_round)
        if rocket_raylib.is_key_pressed(window, rocket_raylib.key_escape()):
            return rebuild(state, state.screen, state.game, state.selected_bet, state.settings, state.notice, "", false, true, state.next_step, state.saved_round)
        return state
    let now = rocket_raylib.elapsed_time(window)
    if state.screen == 0:
        if now >= theme.startup_seconds() or rocket_raylib.is_key_pressed(window, rocket_raylib.key_enter()) or rocket_raylib.is_key_pressed(window, rocket_raylib.key_space()):
            return rebuild(state, 1, state.game, state.selected_bet, state.settings, "Choose a game", "", false, true, state.next_step, state.saved_round)
        return state
    if state.screen == 1:
        return update_lobby(state, window, clicked, mouse_x, mouse_y)
    if state.screen == 2:
        return update_game(state, window, clicked, mouse_x, mouse_y, now)
    if state.screen == 4:
        return update_roulette(state, window, clicked, mouse_x, mouse_y, now)
    if state.screen == 5:
        return update_plinko(state, window, clicked, mouse_x, mouse_y, now)
    if state.screen == 6:
        return update_chicken(state, window, clicked, mouse_x, mouse_y)
    if state.screen == 7:
        return update_crossing(state, window, clicked, mouse_x, mouse_y)
    if state.screen == 8:
        return update_holdem(state, window, clicked, mouse_x, mouse_y)
    if state.screen == 9:
        return update_mines(state, window, clicked, mouse_x, mouse_y, now)
    if state.screen == 10:
        return update_dice(state, window, clicked, mouse_x, mouse_y, now)
    if state.screen == 11:
        return update_hilo(state, window, clicked, mouse_x, mouse_y, now)
    return update_settings(state, window, clicked, mouse_x, mouse_y)

fn draw_startup(window: rocket_raylib.Window, frame: rocket_raylib.Frame) -> Result[Bool, String]:
    let height = rocket_raylib.window_height(window)
    components.centered_label(window, frame, "SCROLL2ROLL", height / 2 - 70, theme.title_size(), theme.gold())?
    components.centered_label(window, frame, "A local play-money casino", height / 2, theme.body_size(), theme.text())?
    return components.centered_label(window, frame, "Loading the tables...", height / 2 + 46, theme.small_size(), theme.muted())

fn draw_lobby(window: rocket_raylib.Window, frame: rocket_raylib.Frame, state: State, mouse_x: Int, mouse_y: Int) -> Result[Bool, String]:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    rocket_raylib.draw_text(frame, "SCROLL2ROLL", 32, 34, theme.heading_size(), theme.gold())?
    rocket_raylib.draw_text(frame, string.concat("Play credits ", string.from_int(state.settings.play_balance)), 32, 96, theme.body_size(), theme.emerald())?
    rocket_raylib.draw_text(frame, "Choose a table", 32, 158, theme.heading_size(), theme.text())?
    let settings = settings_button(width)
    components.button(window, frame, settings, "Settings [S]", true, components.contains(settings, mouse_x, mouse_y), false)?
    var index = 0
    while index < registry.game_count():
        let tile = lobby_tile(index, width)
        components.panel(frame, tile)?
        var status = "Coming later"
        var ink = theme.muted()
        if registry.available(index):
            status = "Play now"
            ink = theme.gold()
        if index >= 6:
            rocket_raylib.draw_text(frame, registry.name(index), tile.x + 10, tile.y + 11, theme.body_size(), theme.text())?
            rocket_raylib.draw_text(frame, status, tile.x + tile.width - 64, tile.y + 14, theme.small_size(), ink)?
        if index < 6:
            rocket_raylib.draw_text(frame, registry.name(index), tile.x + 22, tile.y + 26, theme.heading_size(), theme.text())?
            rocket_raylib.draw_text(frame, registry.description(index), tile.x + 22, tile.y + 84, theme.small_size(), theme.muted())?
            rocket_raylib.draw_text(frame, status, tile.x + 22, tile.y + 126, theme.body_size(), ink)?
        index = index + 1
    let exit = exit_button(height)
    components.button(window, frame, exit, "Exit", true, components.contains(exit, mouse_x, mouse_y), false)?
    rocket_raylib.draw_text(frame, state.notice, 196, height - 62, theme.small_size(), theme.muted())?
    return rocket_raylib.draw_text(frame, "Local, account-free, play-money entertainment", width - 416, height - 62, theme.small_size(), theme.muted())

fn draw_settings(window: rocket_raylib.Window, frame: rocket_raylib.Frame, state: State, mouse_x: Int, mouse_y: Int) -> Result[Bool, String]:
    let width = rocket_raylib.window_width(window)
    rocket_raylib.draw_text(frame, "SETTINGS", 32, 34, theme.heading_size(), theme.gold())?
    components.panel(frame, components.rect(width / 2 - 330, 150, 660, 350))?
    rocket_raylib.draw_text(frame, "Audio [M]", width / 2 - 280, 218, theme.body_size(), theme.text())?
    var audio = "On"
    if not state.settings.audio_enabled:
        audio = "Off"
    rocket_raylib.draw_text(frame, audio, width / 2 + 20, 218, theme.body_size(), theme.emerald())?
    rocket_raylib.draw_text(frame, "Volume [Left/Right]", width / 2 - 280, 310, theme.body_size(), theme.text())?
    rocket_raylib.draw_text(frame, string.concat(string.from_int(state.settings.volume_percent), "%"), width / 2 + 20, 310, theme.body_size(), theme.emerald())?
    rocket_raylib.draw_text(frame, "AI players [Down/Up]", width / 2 - 280, 402, theme.body_size(), theme.text())?
    rocket_raylib.draw_text(frame, string.from_int(state.settings.ai_count), width / 2 + 20, 402, theme.body_size(), theme.emerald())?
    var row = 0
    while row < 3:
        let minus = setting_row_button(row, 0, width)
        components.button(window, frame, minus, "-", true, components.contains(minus, mouse_x, mouse_y), false)?
        if row > 0:
            let plus = setting_row_button(row, 1, width)
            components.button(window, frame, plus, "+", true, components.contains(plus, mouse_x, mouse_y), false)?
        row = row + 1
    return rocket_raylib.draw_text(frame, "Escape or B returns to the lobby", 32, 540, theme.body_size(), theme.muted())

fn draw(window: rocket_raylib.Window, state: State) -> Result[Bool, String]:
    let mouse_x = rocket_raylib.mouse_x(window)
    let mouse_y = rocket_raylib.mouse_y(window)
    let frame = rocket_raylib.begin_frame(window)?
    rocket_raylib.clear(frame, theme.background())?
    if state.screen == 0:
        draw_startup(window, frame)?
    if state.screen == 1:
        draw_lobby(window, frame, state, mouse_x, mouse_y)?
    if state.screen == 2:
        blackjack_view.draw(window, frame, state.game, state.selected_bet, mouse_x, mouse_y)?
    if state.screen == 3:
        draw_settings(window, frame, state, mouse_x, mouse_y)?
    if state.screen == 4:
        roulette_view.draw(window, frame, state.roulette.game, state.roulette_kind, state.roulette_target, state.roulette_help, mouse_x, mouse_y)?
    if state.screen == 5:
        plinko_view.draw(window, frame, state.plinko.game, state.plinko_stage, state.plinko_help, mouse_x, mouse_y)?
    if state.screen == 6:
        chicken_view.draw(window, frame, state.chicken.game, state.chicken_help, mouse_x, mouse_y)?
    if state.screen == 7:
        crossing_view.draw(window, frame, state.crossing.game, state.crossing_help, mouse_x, mouse_y)?
    if state.screen == 8:
        let table = holdem_api.public_table(state.holdem)
        let can_fold = holdem_api.can_action(state.holdem, 0, 0)
        let can_call_check = holdem_api.can_action(state.holdem, 1, 0) or holdem_api.can_action(state.holdem, 2, 0)
        let can_raise = holdem_api.can_action(state.holdem, 3, state.holdem_target)
        let can_all_in = holdem_api.can_action(state.holdem, 4, 0)
        holdem_view.draw(window, frame, table, state.holdem_target, can_fold, can_call_check, can_raise, can_all_in, state.holdem_help, mouse_x, mouse_y)?
    if state.screen == 9:
        mines_view.draw(window, frame, state.mines, state.mines_selected, state.mines_help, mouse_x, mouse_y)?
    if state.screen == 10:
        dice_view.draw(window, frame, state.dice, state.dice_help, mouse_x, mouse_y)?
    if state.screen == 11:
        let table = hilo_api.public_table(state.hilo)?
        hilo_view.draw(window, frame, table, state.hilo_help, mouse_x, mouse_y)?
    if state.error != "":
        components.modal(window, frame, "Something needs attention", state.error)?
    if state.exit_prompt:
        components.modal(window, frame, "Leave Scroll2Roll?", "Your local settings and settled progress are saved")?
    rocket_raylib.end_frame(frame)?
    return Ok(true)

pub fn initial_for_test(save_path: String) -> Result[State, String]:
    return initial(persistence.defaults(), save_path, "Deterministic test session")

pub fn step_for_test(state: State, window: rocket_raylib.Window) -> State:
    return update(state, window)

pub fn draw_for_test(window: rocket_raylib.Window, state: State) -> Result[Bool, String]:
    return draw(window, state)

fn volume_value(percent: Int) -> Float:
    if percent <= 0:
        return 0.0
    if percent <= 25:
        return 0.25
    if percent <= 50:
        return 0.5
    if percent <= 75:
        return 0.75
    return 1.0

fn event_sound(previous: State, current: State, sound: rocket_raylib.Sound, audio_ready: Bool) -> Bool:
    let blackjack_changed = previous.game.message != current.game.message
    let roulette_changed = previous.roulette.game.message != current.roulette.game.message
    let plinko_changed = previous.plinko.game.message != current.plinko.game.message
    let chicken_changed = previous.chicken.game.message != current.chicken.game.message
    let crossing_changed = previous.crossing.game.message != current.crossing.game.message
    let holdem_changed = previous.holdem.game.message != current.holdem.game.message
    let mines_changed = previous.mines.game.message != current.mines.game.message
    let dice_changed = previous.dice.game.message != current.dice.game.message
    let hilo_changed = previous.hilo.game.message != current.hilo.game.message
    if audio_ready and current.settings.audio_enabled and(blackjack_changed or roulette_changed or plinko_changed or chicken_changed or crossing_changed or holdem_changed or mines_changed or dice_changed or hilo_changed):
        let volume = rocket_raylib.set_sound_volume(sound, volume_value(current.settings.volume_percent))
        let played = rocket_raylib.play_sound(sound)
    return true

fn loop(window: rocket_raylib.Window, initial_state: State, sound: rocket_raylib.Sound, audio_ready: Bool) -> Int:
    var state = initial_state
    while state.running and not rocket_raylib.window_should_close(window):
        let previous = state
        state = update(state, window)
        let sounded = event_sound(previous, state, sound, audio_ready)
        match draw(window, state):
            case Ok(drawn):
                let expected = drawn
            case Err(error):
                print(error)
                return 21
    return 0

fn run_silent(window: rocket_raylib.Window, state: State) -> Int:
    let status = loop(window, state, rocket_raylib.Sound(0), false)
    let closed = rocket_raylib.close_window(window)
    return status

fn run_with_audio(window: rocket_raylib.Window, state: State, audio: rocket_raylib.AudioDevice, sound: rocket_raylib.Sound) -> Int:
    let status = loop(window, state, sound, true)
    let stopped = rocket_raylib.stop_sound(sound)
    let sound_closed = rocket_raylib.unload_sound(sound)
    let audio_closed = rocket_raylib.close_audio(audio)
    let window_closed = rocket_raylib.close_window(window)
    return status

pub fn run() -> Int:
    var save_path = "settings.s2r"
    var loaded = persistence.LoadResult(persistence.defaults(), true, "Using fallback local settings path")
    match persistence.default_path():
        case Ok(path):
            save_path = path
            loaded = persistence.load(path)
        case Err(error):
            let expected = error
    match initial(loaded.settings, save_path, loaded.message):
        case Ok(state):
            match rocket_raylib.open_window(state.settings.window_width, state.settings.window_height, "Scroll2Roll"):
                case Ok(window):
                    let fps = rocket_raylib.set_target_fps(window, 60)
                    match rocket_raylib.open_audio():
                        case Ok(audio):
                            match rocket_raylib.create_tone(audio, 523.25, 0.08):
                                case Ok(sound):
                                    return run_with_audio(window, state, audio, sound)
                                case Err(error):
                                    let audio_closed = rocket_raylib.close_audio(audio)
                                    return run_silent(window, state)
                        case Err(error):
                            return run_silent(window, state)
                case Err(error):
                    print(error)
                    return 11
        case Err(error):
            print(error)
            return 12
