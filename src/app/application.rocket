pub struct State:
    screen: Int
    game: blackjack_model.Game
    roulette: roulette_api.Session
    selected_bet: Int
    settings: persistence.Settings
    save_path: String
    notice: String
    error: String
    exit_prompt: Bool
    running: Bool
    next_step: Float
    saved_round: Int
    roulette_kind: Int
    roulette_target: Int
    roulette_help: Bool
    roulette_spin_end: Float
    plinko: plinko_api.Session
    plinko_help: Bool
    plinko_stage: Int
    plinko_next_step: Float
    chicken: chicken_api.Session
    chicken_help: Bool
    crossing: crossing_api.Session
    crossing_help: Bool
    crossing_accumulator: Float
    holdem: holdem_api.Session
