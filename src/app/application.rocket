fn slots_help(state: State, visible: Bool) -> State:
    return State(state.screen, state.game, state.roulette, state.selected_bet, state.settings, state.save_path, state.notice, state.error, state.exit_prompt, state.running, state.next_step, state.saved_round, state.roulette_kind, state.roulette_target, state.roulette_help, state.roulette_spin_end, state.plinko, state.plinko_help, state.plinko_stage, state.plinko_next_step, state.chicken, state.chicken_help, state.crossing, state.crossing_help, state.crossing_accumulator, state.holdem, state.holdem_help, state.holdem_target, state.mines, state.mines_help, state.mines_selected, state.mines_animation_end, state.dice, state.dice_help, state.dice_animation_end, state.hilo, state.hilo_help, state.hilo_animation_end, state.crash, state.crash_help, state.crash_accumulator, state.slots, visible, state.slots_reel_stage, state.slots_animation_end)

fn with_error(state: State, error: String) -> State:
    return rebuild(state, state.screen, state.game, state.selected_bet, state.settings, state.notice, error, state.exit_prompt, state.running, state.next_step, state.saved_round)

fn enter_game(state: State, seed: Int) -> State:
    match new_table(state.settings, seed):
        case Ok(game):
            return rebuild(state, 2, game, game.rules.minimum_bet, state.settings, "Blackjack table ready", "", false, true, 0.0, 0)
        case Err(error):
            return with_error(state, error)

fn enter_roulette(state: State, seed: Int) -> State:
    match roulette_api.new_session(state.settings.play_balance, seed):
        case Ok(session):
            let entered = rebuild(state, 4, state.game, state.selected_bet, state.settings, "European Roulette table ready", "", false, true, state.next_step, state.saved_round)
            return with_roulette(roulette_focus(entered, 0, 0), session, 0.0)
        case Err(error):
            return with_error(state, error)

