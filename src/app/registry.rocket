pub fn game_count() -> Int:
    return 10

pub fn name(index: Int) -> String:
    if index == 0:
        return "Blackjack"
    if index == 1:
        return "Roulette"
    if index == 2:
        return "Plinko"
    if index == 3:
        return "Coop Climb"
    if index == 4:
        return "Midnight Crossing"
    if index == 5:
        return "Hold'em"
    if index == 6:
        return "Mines"
    if index == 7:
        return "Dice"
    if index == 8:
        return "HiLo"
    return "Crash"

pub fn description(index: Int) -> String:
    if index == 0:
        return "Full rules and AI rivals"
    if index == 1:
        return "Single-zero complete table"
    if index == 2:
        return "Audited 8-16-row boards"
    if index == 3:
        return "Hidden-rung cash-out climb"
    if index == 4:
        return "Real-time traffic and canals"
    if index == 5:
        return "No-limit table with 1-5 rivals"
    if index == 6:
        return "5x5 committed gem grid"
    if index == 7:
        return "Exact under-over signals"
    if index == 8:
        return "Private-deck prediction"
    return "Precommitted local curve"

pub fn available(index: Int) -> Bool:
    return index >= 0 and index <= 9
