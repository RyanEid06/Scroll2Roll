    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 16, value.dock.y + value.dock.height - 60, 144, 48)
    return components.rect(value.rail.x + 16, value.rail.y + 402, value.rail.width / 2 - 20, 44)

pub fn loss_stop_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 170, value.dock.y + value.dock.height - 60, 144, 48)
    return components.rect(value.rail.x + value.rail.width / 2 + 4, value.rail.y + 402, value.rail.width / 2 - 20, 44)

pub fn roll_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 324, value.dock.y + value.dock.height - 60, 204, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 128, value.rail.width / 2 - 20, 50)

