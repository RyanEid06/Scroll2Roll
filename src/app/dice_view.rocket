fn interior(width: Int, height: Int) -> game_layout.Interior:
    return game_layout.interior(width, height)

pub fn direction_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 16, value.dock.y + 12, 116, 44)
    return components.rect(value.rail.x + 16, value.rail.y + 170, value.rail.width - 32, 46)

pub fn target_minus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 146, value.dock.y + 12, 44, 44)
    return components.rect(value.rail.x + 16, value.rail.y + 230, 48, 44)

pub fn target_plus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 266, value.dock.y + 12, 44, 44)
    return components.rect(value.rail.x + value.rail.width - 64, value.rail.y + 230, 48, 44)

