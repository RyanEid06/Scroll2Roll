    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 538, value.dock.y + value.dock.height - 60, value.dock.width - 554, 48)
    return components.rect(value.rail.x + value.rail.width / 2 + 4, value.rail.y + value.rail.height - 128, value.rail.width / 2 - 20, 50)

pub fn help_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    return components.rect(value.stage.x + value.stage.width - 88, value.stage.y + 6, 76, 44)

pub fn next_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 16, value.dock.y + value.dock.height - 60, value.dock.width / 2 - 24, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 128, value.rail.width - 32, 50)

pub fn restart_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + value.dock.width / 2, value.dock.y + value.dock.height - 60, value.dock.width / 2 - 16, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 68, value.rail.width - 32, 50)

pub fn lobby_rect(width: Int, height: Int) -> components.Rect:
    let expected = height
    return shell_view.back_rect(width)

fn percent_label(outcomes: Int) -> String:
    let whole = outcomes / 100
    let hundredths = outcomes - whole * 100
    var fraction = string.from_int(hundredths)
    if hundredths < 10:
        fraction = string.concat("0", fraction)
    return string.concat(string.from_int(whole), string.concat(".", string.concat(fraction, "%")))

fn multiplier_label(value: Int) -> String:
    let whole = value / 10000
    let hundredths =(value - whole * 10000) / 100
    var fraction = string.from_int(hundredths)
    if hundredths < 10:
        fraction = string.concat("0", fraction)
    return string.concat(string.from_int(whole), string.concat(".", string.concat(fraction, "x")))

fn four_digits(value: Int) -> String:
    if value < 0:
        return "----"
    if value < 10:
        return string.concat("000", string.from_int(value))
    if value < 100:
        return string.concat("00", string.from_int(value))
    if value < 1000:
        return string.concat("0", string.from_int(value))
    return string.from_int(value)

fn phase_name(code: Int) -> String:
    if code == 0:
        return "SIGNAL READY"
    if code == 1:
        return "AUTO RUNNING"
    return "BATCH SETTLED"

fn draw_stage_background(frame: rocket_raylib.Frame, resources: ui_resources.UiResources, value: components.Rect, light_mode: Bool) -> Result[Bool, String]:
    if not resources.group_four.dice_vault_ready:
        return game_components.ambient_stage(frame, resources, value, 7, light_mode)
    rocket_raylib.draw_rounded_rectangle(frame, value.x, value.y, value.width, value.height, 0.04, 12, theme.surface(light_mode))?
    rocket_raylib.begin_scissor(frame, value.x, value.y, value.width, value.height)?
    game_components.texture_cover(frame, resources.group_four.dice_vault, value, 244)?
    var veil = rocket_raylib.color(2, 6, 22, 104)
    if light_mode:
        veil = rocket_raylib.color(236, 241, 250, 136)
    rocket_raylib.draw_rectangle(frame, value.x, value.y, value.width, value.height, veil)?
    rocket_raylib.end_scissor(frame)?
    return rocket_raylib.draw_rounded_rectangle_lines(frame, value.x, value.y, value.width, value.height, 0.04, 12, 1.0, theme.subtle_border(light_mode))

fn draw_probability_band(frame: rocket_raylib.Frame, box: components.Rect, target: Int, under: Bool, light_mode: Bool) -> Result[Bool, String]:
    rocket_raylib.draw_rounded_rectangle(frame, box.x, box.y, box.width, box.height, 0.2, 8, rocket_raylib.color(9, 21, 48, 230))?
    var split = box.x + box.width * target / 10000
    if split < box.x + 4:
        split = box.x + 4
    if split > box.x + box.width - 4:
        split = box.x + box.width - 4
    var win_x = box.x
    var win_width = split - box.x
    if not under:
        win_x = split
        win_width = box.x + box.width - split
    rocket_raylib.draw_rounded_rectangle(frame, win_x, box.y, win_width, box.height, 0.2, 8, theme.success(light_mode))?
    rocket_raylib.draw_line(frame, split, box.y - 7, split, box.y + box.height + 7, 3.0, theme.highlight(light_mode))?
    return rocket_raylib.draw_rounded_rectangle_lines(frame, box.x, box.y, box.width, box.height, 0.2, 8, 1.0, theme.subtle_border(light_mode))

fn draw_display_frame(frame: rocket_raylib.Frame, resources: ui_resources.UiResources, box: components.Rect, light_mode: Bool) -> Result[Bool, String]:
    if resources.group_four.dice_signal_display_ready:
        return rocket_raylib.draw_texture_region(frame, resources.group_four.dice_signal_display, 32, 160, 1472, 704, box.x, box.y, box.width, box.height, rocket_raylib.color(255, 255, 255, 255))
    rocket_raylib.draw_rounded_rectangle(frame, box.x + 6, box.y + 8, box.width, box.height, 0.12, 10, rocket_raylib.color(2, 5, 20, 120))?
    rocket_raylib.draw_rounded_rectangle(frame, box.x, box.y, box.width, box.height, 0.12, 10, theme.elevated(light_mode))?
    rocket_raylib.draw_rounded_rectangle_lines(frame, box.x, box.y, box.width, box.height, 0.12, 10, 3.0, theme.highlight(light_mode))?
    var index = 0
    while index < 4:
        let cell_width = box.width * 17 / 100
        let cell = components.rect(box.x + box.width * 14 / 100 + index * box.width * 19 / 100, box.y + box.height * 25 / 100, cell_width, box.height * 52 / 100)
        rocket_raylib.draw_rounded_rectangle(frame, cell.x, cell.y, cell.width, cell.height, 0.12, 8, rocket_raylib.color(4, 20, 36, 235))?
        rocket_raylib.draw_rounded_rectangle_lines(frame, cell.x, cell.y, cell.width, cell.height, 0.12, 8, 2.0, theme.cyan(light_mode))?
        index = index + 1
    return Ok(true)

fn draw_committed_digits(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, box: components.Rect, digits: String, streak: Int, light_mode: Bool) -> Result[Bool, String]:
    var index = 0
    while index < 4:
        let cell = components.rect(box.x + box.width * 14 / 100 + index * box.width * 19 / 100, box.y + box.height * 24 / 100, box.width * 17 / 100, box.height * 54 / 100)
        let digit = string.slice(digits, index, index + 1)
        if streak > 0:
            components.type_centered(window, frame, resources, digit, components.rect(cell.x, cell.y - streak, cell.width, cell.height), components.type_display(), rocket_raylib.color(74, 228, 255, 70))?
            components.type_centered(window, frame, resources, digit, components.rect(cell.x, cell.y + streak, cell.width, cell.height), components.type_display(), rocket_raylib.color(180, 120, 255, 52))?
        components.type_centered(window, frame, resources, digit, cell, components.type_display(), theme.primary_text(light_mode))?
        index = index + 1
    return Ok(true)

fn draw_history(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, session: dice_api.Session, box: components.Rect, light_mode: Bool) -> Result[Bool, String]:
    components.type_text(window, frame, resources, "RECENT EXACT SIGNALS", box.x, box.y, components.type_caption(), theme.secondary_text(light_mode))?
    var index = 0
    while index < collections.length(session.game.history) and index < 5:
        let result = session.game.history[index]
        var mark = "LOSS"
        var ink = theme.destructive(light_mode)
        if result.won:
            mark = "WIN"
            ink = theme.success(light_mode)
        let label = string.concat(string.concat(four_digits(result.roll), string.concat("  ", mark)), string.concat("  RETURN ", string.from_int(result.payout)))
        components.type_text(window, frame, resources, label, box.x, box.y + 26 + index * 24, components.type_caption(), ink)?
        index = index + 1
    return Ok(true)

fn draw_chamber(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, session: dice_api.Session, value: game_layout.Interior, light_mode: Bool, reduced_motion: Bool, now: Float, animation_end: Float) -> Result[Bool, String]:
    let game = session.game
    let stage = game_layout.inset(value.stage, 16)
    let offset = game_components.motion_offset(now, animation_end, reduced_motion, 22)
    var display_width = stage.width * 70 / 100
    if display_width > 700:
        display_width = 700
    if display_width < 420:
        display_width = 420
    var display_height = display_width * 704 / 1472
    if display_height > stage.height * 54 / 100:
        display_height = stage.height * 54 / 100
        display_width = display_height * 1472 / 704
    let display_y = stage.y + 46 + offset / 4
    let display = components.rect(stage.x +(stage.width - display_width) / 2, display_y, display_width, display_height)
    let digits = four_digits(game.last_roll)
    draw_display_frame(frame, resources, display, light_mode)?
    draw_committed_digits(window, frame, resources, display, digits, offset, light_mode)?
    components.type_centered(window, frame, resources, string.concat("COMMITTED SIGNAL  ", digits), components.rect(stage.x, display_y - 38, stage.width, 30), components.type_heading(), theme.highlight(light_mode))?
    if game.last_roll >= 0 and collections.length(game.history) > 0:
        var outcome = "LOSS"
        var outcome_ink = theme.destructive(light_mode)
        if game.history[0].won:
            outcome = "WIN"
            outcome_ink = theme.success(light_mode)
        let outcome_box = components.rect(display.x + display.width - 124, display.y + 8, 116, 32)
        rocket_raylib.draw_rounded_rectangle(frame, outcome_box.x, outcome_box.y, outcome_box.width, outcome_box.height, 0.35, 8, rocket_raylib.color(3, 7, 20, 224))?
        components.type_centered(window, frame, resources, outcome, outcome_box, components.type_caption(), outcome_ink)?
        rocket_raylib.draw_rounded_rectangle_lines(frame, outcome_box.x, outcome_box.y, outcome_box.width, outcome_box.height, 0.35, 8, 2.0, outcome_ink)?
    let band = components.rect(stage.x + 24, display.y + display.height + 22, stage.width - 48, 24)
    draw_probability_band(frame, band, game.target, dice_rules.direction_name(game.direction) == "Under", light_mode)?
    components.type_text(window, frame, resources, "0000", band.x, band.y + 34, components.type_caption(), theme.secondary_text(light_mode))?
    components.type_text(window, frame, resources, "9999", band.x + band.width - 34, band.y + 34, components.type_caption(), theme.secondary_text(light_mode))?
    let outcomes = dice_rules.win_outcomes(game.target, game.direction)?
    let boundary = string.concat(dice_rules.direction_name(game.direction), string.concat("  ", four_digits(game.target)))
    components.type_centered(window, frame, resources, string.concat(boundary, string.concat("  /  WIN ", percent_label(outcomes))), components.rect(band.x + 48, band.y + 30, band.width - 96, 24), components.type_caption(), theme.primary_text(light_mode))?
    let history_y = band.y + 76
    if history_y + 130 < stage.y + stage.height:
        draw_history(window, frame, resources, session, components.rect(stage.x + 24, history_y, stage.width - 48, 130), light_mode)?
    components.type_text(window, frame, resources, "LOCKED 0-9999 SIGNAL VAULT", value.stage.x + 16, value.stage.y + 14, components.type_caption(), rocket_raylib.color(255, 255, 255, 140))?
    return Ok(true)

fn draw_controls(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, session: dice_api.Session, value: game_layout.Interior, mouse_x: Int, mouse_y: Int, light_mode: Bool) -> Result[Bool, String]:
    let game = session.game
    let phase = dice_api.phase_code(session)
    let ready = phase == 0
    let outcomes = dice_rules.win_outcomes(game.target, game.direction)?
    let multiplier = dice_rules.multiplier_basis_points(game.target, game.direction)?
    components.modern_panel(frame, value.rail, light_mode, true)?
    if value.compact:
        if ready:
            components.type_centered(window, frame, resources, percent_label(game.target), components.rect(value.dock.x + 190, value.dock.y + 12, 76, 44), components.type_caption(), theme.primary_text(light_mode))?
            components.type_centered(window, frame, resources, string.from_int(game.bet), components.rect(value.dock.x + 368, value.dock.y + 12, 76, 44), components.type_caption(), theme.primary_text(light_mode))?
        else:
            components.badge(window, frame, resources, components.rect(value.dock.x + 16, value.dock.y + 14, 138, 28), phase_name(phase), light_mode)?
            game_components.metric(window, frame, resources, "ROLLS", string.from_int(game.batch_rolls), value.dock.x + 170, value.dock.y + 10, 70, false, light_mode)?
            game_components.metric(window, frame, resources, "WINS", string.from_int(game.batch_wins), value.dock.x + 252, value.dock.y + 10, 64, true, light_mode)?
            game_components.metric(window, frame, resources, "LOSSES", string.from_int(game.batch_losses), value.dock.x + 330, value.dock.y + 10, 68, false, light_mode)?
    else:
        components.badge(window, frame, resources, components.rect(value.rail.x + 16, value.rail.y + 16, 142, 28), phase_name(phase), light_mode)?
        game_components.status_banner(window, frame, resources, components.rect(value.rail.x + 16, value.rail.y + 56, value.rail.width - 32, 54), game.message, light_mode)?
        game_components.metric(window, frame, resources, "CHANCE", percent_label(outcomes), value.rail.x + 16, value.rail.y + 118, 94, false, light_mode)?
        game_components.metric(window, frame, resources, "MULTIPLIER", multiplier_label(multiplier), value.rail.x + 126, value.rail.y + 118, 108, true, light_mode)?
    let direction = direction_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
    let target_minus = target_minus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
    let target_plus = target_plus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
    let bet_minus = bet_minus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
    let bet_plus = bet_plus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
    let auto_count = auto_count_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
    let win_stop = win_stop_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
    let loss_stop = loss_stop_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
    if ready:
        components.modern_button(window, frame, resources, direction, dice_rules.direction_name(game.direction), components.button_secondary(), true, components.contains(direction, mouse_x, mouse_y), false, light_mode)?
        components.modern_button(window, frame, resources, target_minus, "-", components.button_secondary(), true, components.contains(target_minus, mouse_x, mouse_y), false, light_mode)?
        components.modern_button(window, frame, resources, target_plus, "+", components.button_secondary(), true, components.contains(target_plus, mouse_x, mouse_y), false, light_mode)?
        components.modern_button(window, frame, resources, bet_minus, "-", components.button_secondary(), true, components.contains(bet_minus, mouse_x, mouse_y), false, light_mode)?
        components.modern_button(window, frame, resources, bet_plus, "+", components.button_secondary(), true, components.contains(bet_plus, mouse_x, mouse_y), false, light_mode)?
        if not value.compact:
            components.type_centered(window, frame, resources, string.concat("TARGET  ", percent_label(game.target)), components.rect(target_minus.x + 48, target_minus.y, target_plus.x - target_minus.x - 48, 44), components.type_label(), theme.primary_text(light_mode))?
            components.type_centered(window, frame, resources, string.concat("WAGER  ", string.from_int(game.bet)), components.rect(bet_minus.x + 48, bet_minus.y, bet_plus.x - bet_minus.x - 48, 44), components.type_label(), theme.primary_text(light_mode))?
        components.modern_button(window, frame, resources, auto_count, string.concat("AUTO  ", string.from_int(game.auto_count)), components.button_secondary(), true, components.contains(auto_count, mouse_x, mouse_y), false, light_mode)?
        components.modern_button(window, frame, resources, win_stop, string.concat("WINS  ", string.from_int(game.stop_wins)), components.button_secondary(), true, components.contains(win_stop, mouse_x, mouse_y), false, light_mode)?
        components.modern_button(window, frame, resources, loss_stop, string.concat("LOSSES  ", string.from_int(game.stop_losses)), components.button_secondary(), true, components.contains(loss_stop, mouse_x, mouse_y), false, light_mode)?
        let roll = roll_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        components.modern_button(window, frame, resources, roll, "ROLL [ENTER]", components.button_primary(), game.bet <= game.balance, components.contains(roll, mouse_x, mouse_y), true, light_mode)?
    let automatic = auto_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
    var auto_label = "AUTO [S]"
    if phase == 1:
        auto_label = "STOP [S]"
    components.modern_button(window, frame, resources, automatic, auto_label, components.button_secondary(), phase == 1 or ready and game.bet <= game.balance, components.contains(automatic, mouse_x, mouse_y), false, light_mode)?
    if phase == 2:
        let next = next_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        components.modern_button(window, frame, resources, next, "NEXT SIGNAL [N]", components.button_primary(), true, components.contains(next, mouse_x, mouse_y), true, light_mode)?
        let restart = restart_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        components.modern_button(window, frame, resources, restart, "RESET [R]", components.button_secondary(), true, components.contains(restart, mouse_x, mouse_y), false, light_mode)?
    return Ok(true)

fn draw_help(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, light_mode: Bool) -> Result[Bool, String]:
    let lines = ["Every committed result is an integer from 0000 through 9999.", "Under wins roll < target; Over wins roll >= target.", "Win probability is exact winning outcomes / 10,000.", "Multiplier = floor(9600 x 10000 / winning outcomes) basis points.", "Payout floors wager x multiplier / 10000; return factor is 96%.", "Auto is explicitly finite: 1-20 rolls with optional win/loss stops.", "It also stops on insufficient credits and has no unbounded continuation.", "Tab direction, arrows target/bet, M count, H/D stops, Enter/S act.", "Finish or stop a live finite batch before returning to the lobby."]
    return game_components.help_overlay(window, frame, resources, "DICE  /  EXACT SIGNAL GUIDE", lines, -1, light_mode)

pub fn draw(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, session: dice_api.Session, help: Bool, light_mode: Bool, reduced_motion: Bool, now: Float, animation_end: Float, mouse_x: Int, mouse_y: Int) -> Result[Bool, String]:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    let value = interior(width, height)
    draw_stage_background(frame, resources, value.stage, light_mode)?
    draw_chamber(window, frame, resources, session, value, light_mode, reduced_motion, now, animation_end)?
    draw_controls(window, frame, resources, session, value, mouse_x, mouse_y, light_mode)?
    let rules = help_rect(width, height)
    components.modern_button(window, frame, resources, rules, "RULES", components.button_quiet(), true, components.contains(rules, mouse_x, mouse_y), false, light_mode)?
    if help:
        draw_help(window, frame, resources, light_mode)?
    return Ok(true)
