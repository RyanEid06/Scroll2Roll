import src.app.components
import src.app.game_components
import src.app.game_layout
import src.app.shell_view
import src.app.theme
import src.app.ui_resources
import src.holdem.holdem_cards
import src.holdem.holdem_model
import src.rocket_raylib
import std.collections
import std.string

fn interior(width: Int, height: Int) -> game_layout.Interior:
    return game_layout.interior(width, height)

fn table_rect(value: game_layout.Interior) -> components.Rect:
    var top = 42
    if value.compact:
        top = 28
    return components.rect(value.stage.x + 14, value.stage.y + top, value.stage.width - 28, value.stage.height - top - 10)

fn draw_lounge(frame: rocket_raylib.Frame, resources: ui_resources.UiResources, value: components.Rect, light_mode: Bool) -> Result[Bool, String]:
    if not resources.tables.holdem_lounge_ready:
        return game_components.ambient_stage(frame, resources, value, 5, light_mode)
    rocket_raylib.draw_rounded_rectangle(frame, value.x, value.y, value.width, value.height, 0.04, 12, theme.surface(light_mode))?
    rocket_raylib.begin_scissor(frame, value.x, value.y, value.width, value.height)?
    game_components.texture_cover(frame, resources.tables.holdem_lounge, value, 255)?
    var veil = rocket_raylib.color(3, 9, 16, 82)
    if light_mode:
        veil = rocket_raylib.color(240, 244, 248, 104)
    rocket_raylib.draw_rectangle(frame, value.x, value.y, value.width, value.height, veil)?
    rocket_raylib.end_scissor(frame)?
    return rocket_raylib.draw_rounded_rectangle_lines(frame, value.x, value.y, value.width, value.height, 0.04, 12, 1.0, theme.subtle_border(light_mode))

pub fn help_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    return components.rect(value.stage.x + value.stage.width - 88, value.stage.y + 6, 76, 44)

pub fn deal_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + value.dock.width - 318, value.dock.y + value.dock.height - 60, 188, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 124, value.rail.width - 32, 50)

pub fn target_minus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 16, value.dock.y + 20, 46, 44)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 310, 48, 44)

pub fn target_plus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 180, value.dock.y + 20, 46, 44)
    return components.rect(value.rail.x + value.rail.width - 64, value.rail.y + value.rail.height - 310, 48, 44)

pub fn fold_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 16, value.dock.y + value.dock.height - 60, 112, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 250,(value.rail.width - 40) / 2, 46)

pub fn call_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 136, value.dock.y + value.dock.height - 60, 160, 48)
    let fold = fold_rect(width, height)
    return components.rect(fold.x + fold.width + 8, fold.y, fold.width, fold.height)

pub fn raise_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 304, value.dock.y + value.dock.height - 60, 218, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 196, value.rail.width - 32, 46)

pub fn all_in_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 530, value.dock.y + value.dock.height - 60, value.dock.width - 546, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 142, value.rail.width - 32, 46)

pub fn reset_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + value.dock.width - 122, value.dock.y + value.dock.height - 60, 106, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 64, value.rail.width - 32, 44)

pub fn next_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + value.dock.width - 318, value.dock.y + value.dock.height - 60, 188, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 124, value.rail.width - 32, 50)

pub fn lobby_rect(width: Int, height: Int) -> components.Rect:
    let expected = height
    return shell_view.back_rect(width)

fn street_name(code: Int) -> String:
    if code == 0:
        return "PREFLOP"
    if code == 1:
        return "FLOP"
    if code == 2:
        return "TURN"
    if code == 3:
        return "RIVER"
    return "SHOWDOWN"

fn phase_name(code: Int) -> String:
    if code == 0:
        return "TABLE READY"
    if code == 1:
        return "BETTING"
    return "HAND SETTLED"

fn markers(player: holdem_model.PublicPlayer) -> String:
    var result = ""
    if player.dealer:
        result = "D"
    if player.small_blind:
        result = string.concat(result, " SB")
    if player.big_blind:
        result = string.concat(result, " BB")
    if player.all_in:
        result = string.concat(result, " ALL-IN")
    if player.folded:
        result = string.concat(result, " FOLD")
    return result

fn card_width(table: components.Rect) -> Int:
    var value = table.width / 14
    if value < 42:
        value = 42
    if value > 64:
        value = 64
    return value

fn card_height(width: Int) -> Int:
    return width * 7 / 5

fn chip_cell(index: Int) -> Int:
    return index - index / 3 * 3

fn draw_chip_prop(frame: rocket_raylib.Frame, resources: ui_resources.UiResources, index: Int, value: components.Rect, alpha: Int) -> Result[Bool, String]:
    if not resources.tables.holdem_props_ready:
        return Ok(false)
    return game_components.texture_cell(frame, resources.tables.holdem_props, 4, 2, chip_cell(index), value, alpha)

fn draw_marker_prop(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, player: holdem_model.PublicPlayer, x: Int, y: Int, light_mode: Bool) -> Result[Bool, String]:
    var label = ""
    var cell = 5
    if player.dealer:
        label = "D"
    else:
        if player.small_blind:
            label = "SB"
            cell = 6
        if player.big_blind:
            label = "BB"
            cell = 6
    if label == "":
        return Ok(true)
    let marker = components.rect(x, y, 28, 28)
    if resources.tables.holdem_props_ready:
        game_components.texture_cell(frame, resources.tables.holdem_props, 4, 2, cell, marker, 245)?
    else:
        rocket_raylib.draw_circle_pixels(frame, marker.x + 14, marker.y + 14, 13, theme.highlight(light_mode))?
    return components.type_centered(window, frame, resources, label, marker, components.type_caption(), rocket_raylib.color(6, 14, 24, 255))

fn draw_card(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, card: holdem_model.Card, value: components.Rect, hidden: Bool, active: Bool, light_mode: Bool) -> Result[Bool, String]:
    return game_components.playing_card(window, frame, resources, value, holdem_cards.rank_name(card.rank), card.suit, hidden, active, light_mode)

fn draw_hole_cards(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, player: holdem_model.PublicPlayer, x: Int, y: Int, width: Int, height: Int, offset: Int, light_mode: Bool) -> Result[Bool, String]:
    if player.card_count <= 0:
        return Ok(true)
    let exposed = collections.length(player.cards) == 2
    var index = 0
    while index < player.card_count and index < 2:
        var card = holdem_model.Card(1, 0)
        if exposed:
            card = player.cards[index]
        var card_y = y
        if index == 1:
            card_y = card_y - offset
        draw_card(window, frame, resources, card, components.rect(x + index *(width * 3 / 5), card_y, width, height), not exposed, player.active, light_mode)?
        index = index + 1
    return Ok(true)

fn seat_y(table: components.Rect, index: Int, count: Int) -> Int:
    if count <= 2:
        return table.y + 20
    if index == 1 or index == count:
        return table.y + 52
    return table.y + 18

fn draw_opponents(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, table_data: holdem_model.PublicTable, table: components.Rect, offset: Int, light_mode: Bool) -> Result[Bool, String]:
    let count = collections.length(table_data.players) - 1
    if count <= 0:
        return Ok(true)
    let gap = 8
    let available = table.width - 36
    let seat_width =(available -(count - 1) * gap) / count
    var index = 1
    while index <= count:
        let player = table_data.players[index]
        let x = table.x + 18 +(index - 1) *(seat_width + gap)
        let y = seat_y(table, index, count)
        var seat_height = 72
        if table.height >= 430:
            seat_height = 94
        var fill = rocket_raylib.color(7, 23, 35, 218)
        if light_mode:
            fill = rocket_raylib.color(236, 244, 242, 232)
        if player.folded:
            fill = rocket_raylib.color(32, 39, 50, 210)
        rocket_raylib.draw_rounded_rectangle(frame, x, y, seat_width, seat_height, 0.22, 10, fill)?
        var outline = rocket_raylib.color(245, 186, 71, 88)
        if player.active:
            outline = theme.cyan(light_mode)
            rocket_raylib.draw_rounded_rectangle_lines(frame, x - 3, y - 3, seat_width + 6, seat_height + 6, 0.22, 10, 2.0, outline)?
        rocket_raylib.draw_rounded_rectangle_lines(frame, x, y, seat_width, seat_height, 0.22, 10, 1.0, outline)?
        if player.active and resources.tables.holdem_props_ready:
            let active_ring = components.rect(x + 2, y + seat_height - 58, 44, 56)
            game_components.texture_cell(frame, resources.tables.holdem_props, 4, 2, 7, active_ring, 220)?
        components.type_text(window, frame, resources, player.name, x + 10, y + 8, components.type_caption(), theme.primary_text(light_mode))?
        components.type_text(window, frame, resources, string.concat("STACK  ", string.from_int(player.stack)), x + 10, y + 30, components.type_caption(), theme.highlight(light_mode))?
        let chip = components.rect(x + 6, y + seat_height - 48 + offset / 5, 34, 44)
        draw_chip_prop(frame, resources, index, chip, 245)?
        draw_marker_prop(window, frame, resources, player, x + 42, y + seat_height - 34, light_mode)?
        components.type_text(window, frame, resources, markers(player), x + 74, y + seat_height - 24, components.type_caption(), theme.secondary_text(light_mode))?
        var mini_width = 30
        if seat_width >= 138:
            mini_width = 36
        let mini_height = mini_width * 7 / 5
        draw_hole_cards(window, frame, resources, player, x + seat_width - mini_width * 8 / 5 - 8, y + seat_height - mini_height - 5, mini_width, mini_height, offset / 2, light_mode)?
        index = index + 1
    return Ok(true)

fn draw_community(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, table_data: holdem_model.PublicTable, table: components.Rect, card_w: Int, card_h: Int, offset: Int, light_mode: Bool) -> Result[Bool, String]:
    let count = collections.length(table_data.community)
    let total_width = card_w +(count - 1) *(card_w + 6)
    let x = table.x +(table.width - total_width) / 2
    let y = table.y +(table.height - card_h) / 2 - 4
    if count == 0:
        var index = 0
        while index < 5:
            rocket_raylib.draw_rounded_rectangle_lines(frame, table.x + table.width / 2 - card_w * 5 / 2 + index *(card_w + 5), y, card_w, card_h, 0.12, 10, 1.0, rocket_raylib.color(255, 255, 255, 56))?
            index = index + 1
        components.type_centered(window, frame, resources, "COMMUNITY", components.rect(table.x, y + card_h / 2 - 10, table.width, 24), components.type_caption(), rocket_raylib.color(255, 255, 255, 105))?
        return Ok(true)
    var index = 0
    while index < count:
        var card_y = y
        if index == count - 1:
            card_y = card_y - offset
        draw_card(window, frame, resources, table_data.community[index], components.rect(x + index *(card_w + 6), card_y, card_w, card_h), false, index == count - 1, light_mode)?
        index = index + 1
    return Ok(true)

fn draw_human(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, player: holdem_model.PublicPlayer, table: components.Rect, card_w: Int, card_h: Int, offset: Int, light_mode: Bool) -> Result[Bool, String]:
    var panel_width = table.width * 46 / 100
    if panel_width < 290:
        panel_width = 290
    var panel_height = card_h + 26
    if panel_height > table.height / 3:
        panel_height = table.height / 3
    let panel = components.rect(table.x +(table.width - panel_width) / 2, table.y + table.height - panel_height - 14, panel_width, panel_height)
    var fill = rocket_raylib.color(8, 26, 38, 232)
    if light_mode:
        fill = rocket_raylib.color(237, 246, 242, 242)
    rocket_raylib.draw_rounded_rectangle(frame, panel.x, panel.y, panel.width, panel.height, 0.22, 10, fill)?
    var outline = rocket_raylib.color(245, 186, 71, 125)
    if player.active:
        outline = theme.cyan(light_mode)
        rocket_raylib.draw_rounded_rectangle_lines(frame, panel.x - 3, panel.y - 3, panel.width + 6, panel.height + 6, 0.22, 10, 2.0, outline)?
    rocket_raylib.draw_rounded_rectangle_lines(frame, panel.x, panel.y, panel.width, panel.height, 0.22, 10, 1.0, outline)?
    components.type_text(window, frame, resources, player.name, panel.x + 16, panel.y + 12, components.type_label(), theme.primary_text(light_mode))?
    components.type_text(window, frame, resources, string.concat("STACK  ", string.from_int(player.stack)), panel.x + 16, panel.y + 42, components.type_caption(), theme.highlight(light_mode))?
    components.type_text(window, frame, resources, string.concat("IN POT  ", string.from_int(player.total_contribution)), panel.x + 16, panel.y + 64, components.type_caption(), theme.secondary_text(light_mode))?
    if player.active and resources.tables.holdem_props_ready:
        game_components.texture_cell(frame, resources.tables.holdem_props, 4, 2, 7, components.rect(panel.x + 104, panel.y + panel.height - 62, 48, 60), 220)?
    draw_chip_prop(frame, resources, 2, components.rect(panel.x + 111, panel.y + panel.height - 53 + offset / 5, 34, 44), 245)?
    draw_marker_prop(window, frame, resources, player, panel.x + 156, panel.y + panel.height - 38, light_mode)?
    components.type_text(window, frame, resources, markers(player), panel.x + 190, panel.y + panel.height - 24, components.type_caption(), theme.secondary_text(light_mode))?
    if player.last_action != "":
        components.type_text(window, frame, resources, player.last_action, panel.x + panel.width / 2 - 12, panel.y + 12, components.type_caption(), theme.highlight(light_mode))?
    draw_hole_cards(window, frame, resources, player, panel.x + panel.width - card_w * 8 / 5 - 14, panel.y + panel.height - card_h - 8, card_w, card_h, offset, light_mode)?
    return Ok(true)

fn draw_table(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, table_data: holdem_model.PublicTable, value: game_layout.Interior, offset: Int, light_mode: Bool) -> Result[Bool, String]:
    let table = table_rect(value)
    game_components.felt_table(frame, table, light_mode)?
    let card_w = card_width(table)
    let card_h = card_height(card_w)
    components.type_centered(window, frame, resources, "SCROLL2ROLL  /  NO-LIMIT HOLD'EM", components.rect(table.x, table.y + table.height / 2 - 64, table.width, 24), components.type_caption(), rocket_raylib.color(255, 255, 255, 88))?
    draw_opponents(window, frame, resources, table_data, table, offset, light_mode)?
    draw_community(window, frame, resources, table_data, table, card_w, card_h, offset, light_mode)?
    if resources.tables.holdem_props_ready:
        game_components.texture_cell(frame, resources.tables.holdem_props, 4, 2, 4, components.rect(table.x + table.width - 114, table.y + table.height / 2 - 52 - offset / 3, 98, 66), 245)?
    else:
        game_components.chip_stack(window, frame, resources, table.x + table.width - 86, table.y + table.height / 2 - 20, table_data.pot_total, theme.highlight(light_mode), light_mode)?
    components.badge(window, frame, resources, components.rect(table.x + table.width - 122, table.y + table.height / 2 + 18, 108, 28), string.concat("POT  ", string.from_int(table_data.pot_total)), light_mode)?
    draw_human(window, frame, resources, table_data.players[0], table, card_w, card_h, offset, light_mode)?
    return Ok(true)

fn draw_history(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, table: holdem_model.PublicTable, value: game_layout.Interior, light_mode: Bool) -> Result[Bool, String]:
    let length = collections.length(table.action_history)
    var first = length - 3
    if first < 0:
        first = 0
    components.type_text(window, frame, resources, "RECENT ACTION", value.rail.x + 16, value.rail.y + 178, components.type_caption(), theme.secondary_text(light_mode))?
    var index = first
    while index < length:
        components.type_text(window, frame, resources, table.action_history[index], value.rail.x + 16, value.rail.y + 204 +(index - first) * 24, components.type_caption(), theme.primary_text(light_mode))?
        index = index + 1
    return Ok(true)

fn draw_controls(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, table: holdem_model.PublicTable, target: Int, can_fold: Bool, can_call_check: Bool, can_raise: Bool, can_all_in: Bool, value: game_layout.Interior, mouse_x: Int, mouse_y: Int, light_mode: Bool) -> Result[Bool, String]:
    components.modern_panel(frame, value.rail, light_mode, true)?
    if value.compact:
        var badge_x = value.dock.x + 16
        var pot_x = value.dock.x + 256
        var bet_x = value.dock.x + 364
        var street_x = value.dock.x + 494
        if table.phase_code == 1:
            badge_x = value.dock.x + 250
            pot_x = value.dock.x + 380
            bet_x = value.dock.x + 474
            street_x = value.dock.x + 600
        components.badge(window, frame, resources, components.rect(badge_x, value.dock.y + 12, 112, 28), phase_name(table.phase_code), light_mode)?
        game_components.metric(window, frame, resources, "POT", string.from_int(table.pot_total), pot_x, value.dock.y + 8, 86, true, light_mode)?
        game_components.metric(window, frame, resources, "CURRENT BET", string.from_int(table.current_bet), bet_x, value.dock.y + 8, 112, false, light_mode)?
        game_components.metric(window, frame, resources, "STREET", street_name(table.street_code), street_x, value.dock.y + 8, 120, false, light_mode)?
    else:
        components.badge(window, frame, resources, components.rect(value.rail.x + 16, value.rail.y + 16, 132, 28), phase_name(table.phase_code), light_mode)?
        game_components.status_banner(window, frame, resources, components.rect(value.rail.x + 16, value.rail.y + 56, value.rail.width - 32, 54), table.message, light_mode)?
        game_components.metric(window, frame, resources, "POT", string.from_int(table.pot_total), value.rail.x + 16, value.rail.y + 124, 92, true, light_mode)?
        game_components.metric(window, frame, resources, "CURRENT BET", string.from_int(table.current_bet), value.rail.x + 118, value.rail.y + 124, 112, false, light_mode)?
        game_components.metric(window, frame, resources, "STREET", street_name(table.street_code), value.rail.x + 240, value.rail.y + 124, 110, false, light_mode)?
        draw_history(window, frame, resources, table, value, light_mode)?
    if table.phase_code == 0:
        let deal = deal_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let reset = reset_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        components.modern_button(window, frame, resources, deal, "DEAL [ENTER]", components.button_primary(), table.players[0].stack >= 10, components.contains(deal, mouse_x, mouse_y), true, light_mode)?
        components.modern_button(window, frame, resources, reset, "NEW TABLE [R]", components.button_secondary(), true, components.contains(reset, mouse_x, mouse_y), false, light_mode)?
    if table.phase_code == 1:
        let minus = target_minus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let plus = target_plus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let fold = fold_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let call = call_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let raise = raise_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let all_in = all_in_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        components.modern_button(window, frame, resources, minus, "-", components.button_secondary(), true, components.contains(minus, mouse_x, mouse_y), false, light_mode)?
        components.modern_button(window, frame, resources, plus, "+", components.button_secondary(), true, components.contains(plus, mouse_x, mouse_y), false, light_mode)?
        if value.compact:
            components.type_centered(window, frame, resources, string.concat("RAISE TO  ", string.from_int(target)), components.rect(minus.x + minus.width + 6, minus.y, 112, minus.height), components.type_label(), theme.primary_text(light_mode))?
        else:
            components.type_centered(window, frame, resources, string.concat("RAISE TO  ", string.from_int(target)), components.rect(minus.x + minus.width + 6, minus.y, plus.x - minus.x - minus.width - 12, minus.height), components.type_label(), theme.primary_text(light_mode))?
        components.modern_button(window, frame, resources, fold, "FOLD [D]", components.button_danger(), can_fold, components.contains(fold, mouse_x, mouse_y), false, light_mode)?
        var call_label = "CHECK [ENTER]"
        if table.current_bet > table.players[0].street_contribution:
            call_label = "CALL [ENTER]"
        components.modern_button(window, frame, resources, call, call_label, components.button_primary(), can_call_check, components.contains(call, mouse_x, mouse_y), true, light_mode)?
        components.modern_button(window, frame, resources, raise, "BET / RAISE [R]", components.button_secondary(), can_raise, components.contains(raise, mouse_x, mouse_y), false, light_mode)?
        components.modern_button(window, frame, resources, all_in, "ALL-IN [H]", components.button_secondary(), can_all_in, components.contains(all_in, mouse_x, mouse_y), false, light_mode)?
    if table.phase_code == 2:
        let next = next_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let reset = reset_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        components.modern_button(window, frame, resources, next, "NEXT HAND [N]", components.button_primary(), true, components.contains(next, mouse_x, mouse_y), true, light_mode)?
        components.modern_button(window, frame, resources, reset, "NEW TABLE [R]", components.button_secondary(), true, components.contains(reset, mouse_x, mouse_y), false, light_mode)?
    return Ok(true)

fn draw_help(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, light_mode: Bool) -> Result[Bool, String]:
    let lines = ["One human faces one to five deterministic recreational AI rivals.", "Blinds are 5 / 10; the best five-card poker hand wins each eligible pot.", "Use any five cards from your two private cards and the five-card board.", "Fold [D], check or call [Enter], raise-to [R], or move all-in [H].", "Left and Right change the raise-to target; unavailable actions stay disabled.", "Full raises reopen betting; a short all-in does not reopen prior action.", "Folded chips remain in contribution-tier side pots; folded cards stay hidden.", "Split pots divide equally; odd chips move clockwise left of the dealer.", "Finish an active hand before returning to the lobby; settled progress saves."]
    return game_components.help_overlay(window, frame, resources, "NO-LIMIT HOLD'EM GUIDE", lines, -1, light_mode)

pub fn draw(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, table: holdem_model.PublicTable, target: Int, can_fold: Bool, can_call_check: Bool, can_raise: Bool, can_all_in: Bool, help: Bool, light_mode: Bool, reduced_motion: Bool, now: Float, animation_end: Float, mouse_x: Int, mouse_y: Int) -> Result[Bool, String]:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    let value = interior(width, height)
    draw_lounge(frame, resources, value.stage, light_mode)?
    let offset = game_components.motion_offset(now, animation_end, reduced_motion, 22)
    draw_table(window, frame, resources, table, value, offset, light_mode)?
    draw_controls(window, frame, resources, table, target, can_fold, can_call_check, can_raise, can_all_in, value, mouse_x, mouse_y, light_mode)?
    let help_button = help_rect(width, height)
    components.modern_button(window, frame, resources, help_button, "RULES", components.button_quiet(), true, components.contains(help_button, mouse_x, mouse_y), false, light_mode)?
    if help:
        draw_help(window, frame, resources, light_mode)?
    return Ok(true)
