import src.app.components
import src.app.game_components
import src.app.game_layout
import src.app.shell_view
import src.app.theme
import src.app.ui_resources
import src.hilo.hilo_api
import src.hilo.hilo_cards
import src.hilo.hilo_model
import src.holdem.holdem_cards
import src.holdem.holdem_model
import src.rocket_raylib
import std.collections
import std.string

fn interior(width: Int, height: Int) -> game_layout.Interior:
    return game_layout.interior(width, height)

pub fn help_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    return components.rect(value.stage.x + value.stage.width - 88, value.stage.y + 6, 76, 44)

pub fn bet_minus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 16, value.dock.y + value.dock.height - 60, 48, 48)
    return components.rect(value.rail.x + 16, value.rail.y + 170, 48, 46)

pub fn bet_plus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 72, value.dock.y + value.dock.height - 60, 48, 48)
    return components.rect(value.rail.x + value.rail.width - 64, value.rail.y + 170, 48, 46)

pub fn start_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 136, value.dock.y + value.dock.height - 60, value.dock.width - 274, 48)
    return components.rect(value.rail.x + 16, value.rail.y + 232, value.rail.width - 32, 50)

pub fn lower_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 16, value.dock.y + value.dock.height - 60, 210, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 196,(value.rail.width - 40) / 2, 50)

pub fn higher_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 234, value.dock.y + value.dock.height - 60, 210, 48)
    let lower = lower_rect(width, height)
    return components.rect(lower.x + lower.width + 8, lower.y, lower.width, lower.height)

pub fn cash_out_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 452, value.dock.y + value.dock.height - 60, value.dock.width - 468, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 136, value.rail.width - 32, 50)

pub fn next_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + value.dock.width - 318, value.dock.y + value.dock.height - 60, 188, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 124, value.rail.width - 32, 50)

pub fn restart_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + value.dock.width - 122, value.dock.y + value.dock.height - 60, 106, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 64, value.rail.width - 32, 44)

pub fn lobby_rect(width: Int, height: Int) -> components.Rect:
    let expected = height
    return shell_view.back_rect(width)

fn phase_name(code: Int) -> String:
    if code == 0:
        return "ROUND READY"
    if code == 1:
        return "PREDICT"
    return "ROUND SETTLED"

fn multiplier_label(basis_points: Int) -> String:
    let whole = basis_points / 10000
    let hundredths =(basis_points - whole * 10000) / 100
    var fraction = string.from_int(hundredths)
    if hundredths < 10:
        fraction = string.concat("0", fraction)
    return string.concat(string.from_int(whole), string.concat(".", string.concat(fraction, "x")))

fn draw_stage_background(frame: rocket_raylib.Frame, resources: ui_resources.UiResources, value: components.Rect, light_mode: Bool) -> Result[Bool, String]:
    if not resources.group_four.hilo_room_ready:
        return game_components.ambient_stage(frame, resources, value, 8, light_mode)
    rocket_raylib.draw_rounded_rectangle(frame, value.x, value.y, value.width, value.height, 0.04, 12, theme.surface(light_mode))?
    rocket_raylib.begin_scissor(frame, value.x, value.y, value.width, value.height)?
    game_components.texture_cover(frame, resources.group_four.hilo_room, value, 246)?
    var veil = rocket_raylib.color(3, 4, 18, 118)
    if light_mode:
        veil = rocket_raylib.color(239, 240, 250, 146)
    rocket_raylib.draw_rectangle(frame, value.x, value.y, value.width, value.height, veil)?
    rocket_raylib.end_scissor(frame)?
    return rocket_raylib.draw_rounded_rectangle_lines(frame, value.x, value.y, value.width, value.height, 0.04, 12, 1.0, theme.subtle_border(light_mode))

fn draw_effect_cell(frame: rocket_raylib.Frame, resources: ui_resources.UiResources, cell: Int, value: components.Rect, alpha: Int) -> Result[Bool, String]:
    if not resources.group_four.hilo_effects_ready:
        return Ok(true)
    return rocket_raylib.draw_texture_region(frame, resources.group_four.hilo_effects, cell * 307, 256, 307, 512, value.x, value.y, value.width, value.height, rocket_raylib.color(255, 255, 255, alpha))

fn draw_direction_effects(frame: rocket_raylib.Frame, resources: ui_resources.UiResources, table: hilo_api.PublicTable, stage: components.Rect) -> Result[Bool, String]:
    if table.phase != 1:
        return Ok(true)
    var size = stage.height * 42 / 100
    if size > 250:
        size = 250
    if size < 126:
        size = 126
    var lower_alpha = 112
    var higher_alpha = 112
    if not table.can_lower:
        lower_alpha = 38
    if not table.can_higher:
        higher_alpha = 38
    draw_effect_cell(frame, resources, 0, components.rect(stage.x + stage.width * 22 / 100 - size / 2, stage.y + stage.height / 2 - size / 2, size, size), lower_alpha)?
    return draw_effect_cell(frame, resources, 1, components.rect(stage.x + stage.width * 55 / 100 - size / 2, stage.y + stage.height / 2 - size / 2, size, size), higher_alpha)

fn draw_deck(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, stage: components.Rect, light_mode: Bool) -> Result[Bool, String]:
    var width = stage.width / 9
    if width < 58:
        width = 58
    if width > 86:
        width = 86
    let height = width * 7 / 5
    let x = stage.x + stage.width / 8 - width / 2
    let y = stage.y + stage.height / 2 - height / 2 - 8
    if resources.group_four.hilo_card_tray_ready:
        let tray_width = width * 2
        let tray = components.rect(x + width / 2 - tray_width / 2, y + height / 2 - tray_width / 2, tray_width, tray_width)
        game_components.texture_full(frame, resources.group_four.hilo_card_tray, tray, 250)?
    else:
        var index = 3
        while index >= 0:
            game_components.playing_card(window, frame, resources, components.rect(x + index * 4, y - index * 4, width, height), "A", 0, true, false, light_mode)?
            index = index - 1
    components.type_centered(window, frame, resources, "FUTURE CARDS PRIVATE", components.rect(x - 58, y + height + 18, width + 124, 24), components.type_caption(), theme.secondary_text(light_mode))?
    return Ok(true)

fn draw_outcome_effect(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, table: hilo_api.PublicTable, stage: components.Rect, pulse: Int, light_mode: Bool) -> Result[Bool, String]:
    var cell = -1
    var label = ""
    var ink = theme.highlight(light_mode)
    if table.phase == 1 and table.correct_predictions > 0:
        cell = 3
        label = string.concat("CORRECT  x", string.from_int(table.correct_predictions))
        ink = theme.highlight(light_mode)
    if table.phase == 2:
        if table.last_tie:
            cell = 0
            label = "EQUAL RANK  /  LOSS"
            ink = theme.destructive(light_mode)
        else:
            if table.payout > 0:
                cell = 4
                label = string.concat("CASH OUT  /  RETURN ", string.from_int(table.payout))
                ink = theme.success(light_mode)
            else:
                cell = 2
                label = "PREDICTION MISSED  /  LOSS"
                ink = theme.destructive(light_mode)
    if cell < 0:
        return Ok(true)
    var size = stage.height * 38 / 100 + pulse
    if size > 240:
        size = 240
    let center_x = stage.x + stage.width * 46 / 100
    let center_y = stage.y + stage.height / 2
    draw_effect_cell(frame, resources, cell, components.rect(center_x - size / 2, center_y - size / 2, size, size), 176)?
    let label_box = components.rect(center_x - 126, stage.y + 54, 252, 34)
    rocket_raylib.draw_rounded_rectangle(frame, label_box.x, label_box.y, label_box.width, label_box.height, 0.4, 10, rocket_raylib.color(3, 7, 20, 218))?
    rocket_raylib.draw_rounded_rectangle_lines(frame, label_box.x, label_box.y, label_box.width, label_box.height, 0.4, 10, 2.0, ink)?
    return components.type_centered(window, frame, resources, label, label_box, components.type_caption(), ink)

fn draw_current(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, table: hilo_api.PublicTable, stage: components.Rect, offset: Int, light_mode: Bool) -> Result[Bool, String]:
    var width = stage.width / 7
    if width < 92:
        width = 92
    if width > 126:
        width = 126
    let height = width * 7 / 5
    let x = stage.x + stage.width * 46 / 100 - width / 2
    let y = stage.y + stage.height / 2 - height / 2 - 10 - offset
    if table.phase == 0:
        rocket_raylib.draw_rounded_rectangle_lines(frame, x, y, width, height, 0.12, 10, 2.0, rocket_raylib.color(255, 255, 255, 70))?
        components.type_centered(window, frame, resources, "?", components.rect(x, y + height / 2 - 22, width, 44), components.type_heading(), rocket_raylib.color(255, 255, 255, 130))?
        components.type_centered(window, frame, resources, "DEAL TO REVEAL", components.rect(x - 36, y + height + 14, width + 72, 24), components.type_caption(), theme.secondary_text(light_mode))?
        return Ok(true)
    game_components.playing_card(window, frame, resources, components.rect(x, y, width, height), holdem_cards.rank_name(table.current_card.rank), table.current_card.suit, false, true, light_mode)?
    components.badge(window, frame, resources, components.rect(x - 4, y + height + 14 + offset, width + 8, 28), "CURRENT CARD", light_mode)?
    return Ok(true)

fn draw_probability_bar(frame: rocket_raylib.Frame, value: components.Rect, table: hilo_api.PublicTable, light_mode: Bool) -> Result[Bool, String]:
    rocket_raylib.draw_rounded_rectangle(frame, value.x, value.y, value.width, value.height, 0.5, 10, theme.elevated(light_mode))?
    if table.remaining_cards <= 0:
        return Ok(true)
    let lower_width = value.width * table.lower_outcomes / table.remaining_cards
    let equal_width = value.width * table.equal_outcomes / table.remaining_cards
    rocket_raylib.draw_rounded_rectangle(frame, value.x, value.y, lower_width, value.height, 0.5, 10, theme.violet(light_mode))?
    rocket_raylib.draw_rectangle(frame, value.x + lower_width, value.y, equal_width, value.height, theme.destructive(light_mode))?
    return rocket_raylib.draw_rounded_rectangle(frame, value.x + lower_width + equal_width, value.y, value.width - lower_width - equal_width, value.height, 0.5, 10, theme.success(light_mode))

fn draw_odds(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, table: hilo_api.PublicTable, stage: components.Rect, light_mode: Bool) -> Result[Bool, String]:
    let panel = components.rect(stage.x + stage.width * 65 / 100, stage.y + 58, stage.width * 31 / 100, stage.height - 116)
    components.modern_panel(frame, panel, light_mode, true)?
    components.type_text(window, frame, resources, "CARDS REMAINING", panel.x + 18, panel.y + 16, components.type_caption(), theme.secondary_text(light_mode))?
    components.type_text(window, frame, resources, string.from_int(table.remaining_cards), panel.x + 18, panel.y + 38, components.type_numeric(), theme.primary_text(light_mode))?
    if table.phase == 1:
        game_components.metric(window, frame, resources, "LOWER", string.from_int(table.lower_outcomes), panel.x + 18, panel.y + 86, panel.width / 3, false, light_mode)?
        game_components.metric(window, frame, resources, "EQUAL", string.from_int(table.equal_outcomes), panel.x + panel.width / 3 + 6, panel.y + 86, panel.width / 3, false, light_mode)?
        game_components.metric(window, frame, resources, "HIGHER", string.from_int(table.higher_outcomes), panel.x + panel.width * 2 / 3, panel.y + 86, panel.width / 3, true, light_mode)?
        draw_probability_bar(frame, components.rect(panel.x + 18, panel.y + 140, panel.width - 36, 14), table, light_mode)?
        components.type_centered(window, frame, resources, "LOWER        EQUAL        HIGHER", components.rect(panel.x + 8, panel.y + 162, panel.width - 16, 22), components.type_caption(), theme.secondary_text(light_mode))?
    else:
        components.type_text(window, frame, resources, "Future cards stay private", panel.x + 18, panel.y + 96, components.type_caption(), theme.secondary_text(light_mode))?
        components.type_text(window, frame, resources, "Counts appear after the deal", panel.x + 18, panel.y + 124, components.type_caption(), theme.secondary_text(light_mode))?
    return Ok(true)

fn draw_sequence(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, table: hilo_api.PublicTable, stage: components.Rect, light_mode: Bool) -> Result[Bool, String]:
    let count = collections.length(table.sequence)
    if count <= 0:
        return Ok(true)
    var shown = count
    if shown > 7:
        shown = 7
    let width = 34
    let height = 48
    let first = count - shown
    let total_width = width +(shown - 1) * 24
    let x = stage.x + stage.width / 2 - total_width / 2
    let y = stage.y + stage.height - 62
    var index = 0
    while index < shown:
        let card = table.sequence[first + index]
        game_components.playing_card(window, frame, resources, components.rect(x + index * 24, y, width, height), holdem_cards.rank_name(card.rank), card.suit, false, index == shown - 1, light_mode)?
        index = index + 1
    components.type_text(window, frame, resources, "VISIBLE SEQUENCE", x - 118, y + 15, components.type_caption(), theme.secondary_text(light_mode))?
    return Ok(true)

fn result_label(result: hilo_model.RoundResult) -> String:
    if result.tie_loss:
        return string.concat(string.from_int(result.correct_predictions), " correct  /  EQUAL LOSS")
    if result.payout > 0:
        return string.concat(string.concat(string.from_int(result.correct_predictions), " correct  /  RETURN "), string.from_int(result.payout))
    return string.concat(string.from_int(result.correct_predictions), " correct  /  LOST")

fn draw_history(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, table: hilo_api.PublicTable, value: game_layout.Interior, light_mode: Bool) -> Result[Bool, String]:
    components.type_text(window, frame, resources, "RECENT ROUNDS", value.rail.x + 16, value.rail.y + 280, components.type_caption(), theme.secondary_text(light_mode))?
    var index = 0
    while index < collections.length(table.history) and index < 4:
        let result = table.history[index]
        var ink = theme.destructive(light_mode)
        if result.payout > 0:
            ink = theme.success(light_mode)
        components.type_text(window, frame, resources, result_label(result), value.rail.x + 16, value.rail.y + 306 + index * 25, components.type_caption(), ink)?
        index = index + 1
    return Ok(true)

fn draw_controls(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, table: hilo_api.PublicTable, value: game_layout.Interior, mouse_x: Int, mouse_y: Int, light_mode: Bool) -> Result[Bool, String]:
    components.modern_panel(frame, value.rail, light_mode, true)?
    if value.compact:
        components.badge(window, frame, resources, components.rect(value.dock.x + 16, value.dock.y + 12, 126, 28), phase_name(table.phase), light_mode)?
        game_components.metric(window, frame, resources, "WAGER", string.from_int(table.bet), value.dock.x + 176, value.dock.y + 8, 92, false, light_mode)?
        game_components.metric(window, frame, resources, "MULTIPLIER", multiplier_label(table.multiplier_basis_points), value.dock.x + 286, value.dock.y + 8, 116, false, light_mode)?
        game_components.metric(window, frame, resources, "POTENTIAL", string.from_int(table.potential_payout), value.dock.x + 420, value.dock.y + 8, 112, true, light_mode)?
        game_components.metric(window, frame, resources, "CORRECT", string.from_int(table.correct_predictions), value.dock.x + 550, value.dock.y + 8, 92, false, light_mode)?
    else:
        components.badge(window, frame, resources, components.rect(value.rail.x + 16, value.rail.y + 16, 142, 28), phase_name(table.phase), light_mode)?
        game_components.status_banner(window, frame, resources, components.rect(value.rail.x + 16, value.rail.y + 56, value.rail.width - 32, 54), table.message, light_mode)?
        game_components.metric(window, frame, resources, "WAGER", string.from_int(table.bet), value.rail.x + 16, value.rail.y + 124, 92, false, light_mode)?
        game_components.metric(window, frame, resources, "MULTIPLIER", multiplier_label(table.multiplier_basis_points), value.rail.x + 126, value.rail.y + 124, 116, false, light_mode)?
        game_components.metric(window, frame, resources, "POTENTIAL", string.from_int(table.potential_payout), value.rail.x + 252, value.rail.y + 124, 108, true, light_mode)?
        draw_history(window, frame, resources, table, value, light_mode)?
    if table.phase == 0:
        let minus = bet_minus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let plus = bet_plus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let start = start_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let restart = restart_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        components.modern_button(window, frame, resources, minus, "-", components.button_secondary(), true, components.contains(minus, mouse_x, mouse_y), false, light_mode)?
        components.modern_button(window, frame, resources, plus, "+", components.button_secondary(), true, components.contains(plus, mouse_x, mouse_y), false, light_mode)?
        components.modern_button(window, frame, resources, start, string.concat("DEAL  ", string.from_int(table.bet)), components.button_primary(), table.bet <= table.balance, components.contains(start, mouse_x, mouse_y), true, light_mode)?
        components.modern_button(window, frame, resources, restart, "RESTART [R]", components.button_secondary(), true, components.contains(restart, mouse_x, mouse_y), false, light_mode)?
    if table.phase == 1:
        let lower = lower_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let higher = higher_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let cash = cash_out_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        components.modern_button(window, frame, resources, lower, string.concat("LOWER [L]  ", string.from_int(table.lower_outcomes)), components.button_primary(), table.can_lower, components.contains(lower, mouse_x, mouse_y), false, light_mode)?
        components.modern_button(window, frame, resources, higher, string.concat("HIGHER [H]  ", string.from_int(table.higher_outcomes)), components.button_primary(), table.can_higher, components.contains(higher, mouse_x, mouse_y), true, light_mode)?
        components.modern_button(window, frame, resources, cash, "CASH OUT [S]", components.button_secondary(), table.correct_predictions > 0, components.contains(cash, mouse_x, mouse_y), false, light_mode)?
    if table.phase == 2:
        let next = next_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let restart = restart_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        components.modern_button(window, frame, resources, next, "NEXT ROUND [N]", components.button_primary(), true, components.contains(next, mouse_x, mouse_y), true, light_mode)?
        components.modern_button(window, frame, resources, restart, "RESTART [R]", components.button_secondary(), true, components.contains(restart, mouse_x, mouse_y), false, light_mode)?
    return Ok(true)

fn draw_help(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, light_mode: Bool) -> Result[Bool, String]:
    let lines = ["A checked 52-card deck is Fisher-Yates shuffled only at round start.", "One card is visible; every future card remains private until it is drawn.", "Choose an enabled Higher or Lower action using the exact cards-left counts.", "EQUAL RANK = LOSS, regardless of whether Higher or Lower was selected.", "Each correct prediction reveals the next card and advances the multiplier.", "Cash Out becomes legal after one correct prediction; a wrong pick loses.", "Step return = floor(previous x 9600 x remaining / winning / 10000).", "Payout = floor(wager x multiplier / 10000); integer caps protect credits.", "H / L predicts, arrows size wager, Enter deals, and S cashes out."]
    return game_components.help_overlay(window, frame, resources, "HILO  /  EXACT RETURN GUIDE", lines, 3, light_mode)

pub fn draw(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, table: hilo_api.PublicTable, help: Bool, light_mode: Bool, reduced_motion: Bool, now: Float, animation_end: Float, mouse_x: Int, mouse_y: Int) -> Result[Bool, String]:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    let value = interior(width, height)
    draw_stage_background(frame, resources, value.stage, light_mode)?
    let offset = game_components.motion_offset(now, animation_end, reduced_motion, 34)
    draw_direction_effects(frame, resources, table, value.stage)?
    draw_deck(window, frame, resources, value.stage, light_mode)?
    draw_outcome_effect(window, frame, resources, table, value.stage, offset, light_mode)?
    draw_current(window, frame, resources, table, value.stage, offset, light_mode)?
    draw_odds(window, frame, resources, table, value.stage, light_mode)?
    draw_sequence(window, frame, resources, table, value.stage, light_mode)?
    components.badge(window, frame, resources, components.rect(value.stage.x + value.stage.width / 2 - 92, value.stage.y + 14, 184, 32), "EQUAL RANK = LOSS", light_mode)?
    rocket_raylib.draw_rounded_rectangle_lines(frame, value.stage.x + value.stage.width / 2 - 96, value.stage.y + 10, 192, 40, 0.4, 10, 2.0, theme.destructive(light_mode))?
    draw_controls(window, frame, resources, table, value, mouse_x, mouse_y, light_mode)?
    let help_button = help_rect(width, height)
    components.modern_button(window, frame, resources, help_button, "RULES", components.button_quiet(), true, components.contains(help_button, mouse_x, mouse_y), false, light_mode)?
    if help:
        draw_help(window, frame, resources, light_mode)?
    return Ok(true)
