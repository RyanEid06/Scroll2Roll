import src.app.components
import src.app.game_components
import src.app.game_layout
import src.app.shell_view
import src.app.theme
import src.app.ui_resources
import src.mines.mines_api
import src.mines.mines_model
import src.mines.mines_rules
import src.rocket_raylib
import std.collections
import std.string

fn interior(width: Int, height: Int) -> game_layout.Interior:
    return game_layout.interior(width, height)

fn board_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    let stage = game_layout.inset(value.stage, 18)
    var side = stage.height - 54
    if side > stage.width - 34:
        side = stage.width - 34
    return components.rect(stage.x +(stage.width - side) / 2, stage.y + 34, side, side)

pub fn tile_rect(tile: Int, width: Int, height: Int) -> components.Rect:
    let board = board_rect(width, height)
    let gap = 8
    let size =(board.width - gap * 4) / 5
    let row = tile / 5
    let column = tile - row * 5
    return components.rect(board.x + column *(size + gap), board.y + row *(size + gap), size, size)

pub fn bet_minus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 16, value.dock.y + 14, 44, 44)
    return components.rect(value.rail.x + 16, value.rail.y + 180, 48, 44)

pub fn bet_plus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 136, value.dock.y + 14, 44, 44)
    return components.rect(value.rail.x + value.rail.width - 64, value.rail.y + 180, 48, 44)

pub fn mines_minus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 196, value.dock.y + 14, 44, 44)
    return components.rect(value.rail.x + 16, value.rail.y + 240, 48, 44)

pub fn mines_plus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 316, value.dock.y + 14, 44, 44)
    return components.rect(value.rail.x + value.rail.width - 64, value.rail.y + 240, 48, 44)

pub fn start_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 380, value.dock.y + 14, value.dock.width - 396, 44)
    return components.rect(value.rail.x + 16, value.rail.y + 302, value.rail.width - 32, 50)

pub fn cash_out_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + value.dock.width / 2, value.dock.y + value.dock.height - 60, value.dock.width / 2 - 16, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 128, value.rail.width - 32, 50)

pub fn help_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    return components.rect(value.stage.x + value.stage.width - 88, value.stage.y + 6, 76, 44)

pub fn next_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 16, value.dock.y + value.dock.height - 60, value.dock.width / 2 - 24, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 128, value.rail.width - 32, 50)

pub fn restart_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + value.dock.width / 2, value.dock.y + value.dock.height - 60, value.dock.width / 2 - 16, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 68, value.rail.width - 32, 50)

pub fn lobby_rect(width: Int, height: Int) -> components.Rect:
    let expected = height
    return shell_view.back_rect(width)

fn multiplier_label(basis_points: Int) -> String:
    let whole = basis_points / 10000
    let hundredths =(basis_points - whole * 10000) / 100
    var fraction = string.from_int(hundredths)
    if hundredths < 10:
        fraction = string.concat("0", fraction)
    return string.concat(string.from_int(whole), string.concat(".", string.concat(fraction, "x")))

fn phase_name(code: Int) -> String:
    if code == 0:
        return "GRID READY"
    if code == 1:
        return "EXPLORING"
    return "GRID SETTLED"

fn draw_gem(frame: rocket_raylib.Frame, box: components.Rect, offset: Int, light_mode: Bool) -> Result[Bool, String]:
    let center_x = box.x + box.width / 2
    let center_y = box.y + box.height / 2 - offset
    var radius = box.width / 5
    if radius > 24:
        radius = 24
    rocket_raylib.draw_triangle(frame, center_x, center_y - radius, center_x - radius, center_y, center_x + radius, center_y, theme.cyan(light_mode))?
    rocket_raylib.draw_triangle(frame, center_x - radius, center_y, center_x, center_y + radius, center_x + radius, center_y, theme.violet(light_mode))?
    rocket_raylib.draw_line(frame, center_x, center_y - radius, center_x, center_y + radius, 1.0, rocket_raylib.color(255, 255, 255, 150))?
    return rocket_raylib.draw_circle_pixels(frame, center_x - radius / 3, center_y - radius / 3, 3, rocket_raylib.color(255, 255, 255, 235))

fn draw_mine(frame: rocket_raylib.Frame, box: components.Rect, light_mode: Bool) -> Result[Bool, String]:
    let center_x = box.x + box.width / 2
    let center_y = box.y + box.height / 2
    var radius = box.width / 5
    if radius > 22:
        radius = 22
    let danger = theme.destructive(light_mode)
    rocket_raylib.draw_line(frame, center_x - radius - 8, center_y, center_x + radius + 8, center_y, 4.0, danger)?
    rocket_raylib.draw_line(frame, center_x, center_y - radius - 8, center_x, center_y + radius + 8, 4.0, danger)?
    rocket_raylib.draw_line(frame, center_x - radius, center_y - radius, center_x + radius, center_y + radius, 4.0, danger)?
    rocket_raylib.draw_line(frame, center_x + radius, center_y - radius, center_x - radius, center_y + radius, 4.0, danger)?
    rocket_raylib.draw_circle_pixels(frame, center_x, center_y, radius, rocket_raylib.color(17, 22, 38, 255))?
    rocket_raylib.draw_circle_pixels(frame, center_x - radius / 3, center_y - radius / 3, 4, theme.highlight(light_mode))?
    return Ok(true)

fn draw_board(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, session: mines_api.Session, selected_tile: Int, mouse_x: Int, mouse_y: Int, light_mode: Bool, reduced_motion: Bool, now: Float, animation_end: Float) -> Result[Bool, String]:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    let value = interior(width, height)
    let board = board_rect(width, height)
    let phase = mines_api.phase_code(session)
    let reveal_offset = game_components.motion_offset(now, animation_end, reduced_motion, 12)
    rocket_raylib.draw_rounded_rectangle(frame, board.x - 14, board.y - 14, board.width + 28, board.height + 28, 0.04, 10, rocket_raylib.color(4, 18, 32, 225))?
    var tile = 0
    while tile < mines_rules.tile_count():
        let box = tile_rect(tile, width, height)
        let state = mines_api.tile_state(session, tile)?
        var fill = rocket_raylib.color(19, 35, 55, 244)
        var border = theme.subtle_border(light_mode)
        if phase == 1 and tile == selected_tile:
            border = theme.highlight(light_mode)
        if state == 1:
            fill = rocket_raylib.color(12, 84, 91, 245)
            border = theme.success(light_mode)
        if state == 2:
            fill = rocket_raylib.color(67, 21, 42, 245)
            border = theme.destructive(light_mode)
        if state == 0 and phase == 1 and components.contains(box, mouse_x, mouse_y):
            fill = rocket_raylib.color(33, 54, 78, 250)
            border = theme.cyan(light_mode)
        rocket_raylib.draw_rounded_rectangle(frame, box.x, box.y + 4, box.width, box.height, 0.16, 8, rocket_raylib.color(1, 5, 20, 110))?
        rocket_raylib.draw_rounded_rectangle(frame, box.x, box.y, box.width, box.height, 0.16, 8, fill)?
        rocket_raylib.draw_rounded_rectangle_lines(frame, box.x, box.y, box.width, box.height, 0.16, 8, 2.0, border)?
        if state == 0:
            rocket_raylib.draw_ring_pixels(frame, box.x + box.width / 2, box.y + box.height / 2, 4, 7, 0.0, 360.0, 16, rocket_raylib.color(160, 188, 213, 82))?
        if state == 1:
            var offset = 0
            if tile == selected_tile:
                offset = reveal_offset
            draw_gem(frame, box, offset, light_mode)?
        if state == 2:
            draw_mine(frame, box, light_mode)?
        tile = tile + 1
    components.type_text(window, frame, resources, "COMMITTED 5 x 5 CAVERN", value.stage.x + 16, value.stage.y + 14, components.type_caption(), rocket_raylib.color(255, 255, 255, 140))?
    return Ok(true)

fn history_label(result: mines_model.RoundResult) -> String:
    if result.hit_mine:
        return string.concat(string.from_int(result.safe_reveals), " gems / mine")
    return string.concat(string.concat(string.from_int(result.safe_reveals), " gems / return "), string.from_int(result.payout))

fn draw_history(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, session: mines_api.Session, value: game_layout.Interior, light_mode: Bool) -> Result[Bool, String]:
    if value.compact:
        return Ok(true)
    components.type_text(window, frame, resources, "RECENT EXPEDITIONS", value.rail.x + 16, value.rail.y + 372, components.type_caption(), theme.secondary_text(light_mode))?
    var index = 0
    while index < collections.length(session.game.history) and index < 4:
        let result = session.game.history[index]
        var ink = theme.success(light_mode)
        if result.hit_mine:
            ink = theme.destructive(light_mode)
        components.type_text(window, frame, resources, history_label(result), value.rail.x + 16, value.rail.y + 398 + index * 24, components.type_caption(), ink)?
        index = index + 1
    return Ok(true)

fn draw_controls(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, session: mines_api.Session, value: game_layout.Interior, mouse_x: Int, mouse_y: Int, light_mode: Bool) -> Result[Bool, String]:
    let game = session.game
    let phase = mines_api.phase_code(session)
    components.modern_panel(frame, value.rail, light_mode, true)?
    if value.compact:
        if phase == 0:
            components.type_centered(window, frame, resources, string.concat("BET ", string.from_int(game.bet)), components.rect(value.dock.x + 60, value.dock.y + 14, 76, 44), components.type_caption(), theme.primary_text(light_mode))?
            components.type_centered(window, frame, resources, string.concat("MINES ", string.from_int(game.mine_count)), components.rect(value.dock.x + 240, value.dock.y + 14, 76, 44), components.type_caption(), theme.primary_text(light_mode))?
        else:
            components.badge(window, frame, resources, components.rect(value.dock.x + 16, value.dock.y + 14, 132, 28), phase_name(phase), light_mode)?
            game_components.metric(window, frame, resources, "GEMS", string.from_int(game.safe_reveals), value.dock.x + 164, value.dock.y + 10, 72, false, light_mode)?
            game_components.metric(window, frame, resources, "MULTIPLIER", multiplier_label(game.multiplier_basis_points), value.dock.x + 252, value.dock.y + 10, 104, true, light_mode)?
            game_components.metric(window, frame, resources, "POTENTIAL", string.from_int(game.potential_payout), value.dock.x + 372, value.dock.y + 10, 96, true, light_mode)?
    else:
        components.badge(window, frame, resources, components.rect(value.rail.x + 16, value.rail.y + 16, 142, 28), phase_name(phase), light_mode)?
        game_components.status_banner(window, frame, resources, components.rect(value.rail.x + 16, value.rail.y + 56, value.rail.width - 32, 54), game.message, light_mode)?
        game_components.metric(window, frame, resources, "GEMS", string.from_int(game.safe_reveals), value.rail.x + 16, value.rail.y + 118, 70, false, light_mode)?
        game_components.metric(window, frame, resources, "POTENTIAL", string.from_int(game.potential_payout), value.rail.x + 104, value.rail.y + 118, 104, true, light_mode)?
        game_components.metric(window, frame, resources, "MULTIPLIER", multiplier_label(game.multiplier_basis_points), value.rail.x + 214, value.rail.y + 118, 90, true, light_mode)?
    if phase == 0:
        let bet_minus = bet_minus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let bet_plus = bet_plus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let mines_minus = mines_minus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let mines_plus = mines_plus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let start = start_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        components.modern_button(window, frame, resources, bet_minus, "-", components.button_secondary(), true, components.contains(bet_minus, mouse_x, mouse_y), false, light_mode)?
        components.modern_button(window, frame, resources, bet_plus, "+", components.button_secondary(), true, components.contains(bet_plus, mouse_x, mouse_y), false, light_mode)?
        components.modern_button(window, frame, resources, mines_minus, "-", components.button_secondary(), true, components.contains(mines_minus, mouse_x, mouse_y), false, light_mode)?
        components.modern_button(window, frame, resources, mines_plus, "+", components.button_secondary(), true, components.contains(mines_plus, mouse_x, mouse_y), false, light_mode)?
        if not value.compact:
            components.type_centered(window, frame, resources, string.concat("WAGER  ", string.from_int(game.bet)), components.rect(bet_minus.x + 48, bet_minus.y, bet_plus.x - bet_minus.x - 48, 44), components.type_label(), theme.primary_text(light_mode))?
            components.type_centered(window, frame, resources, string.concat("MINES  ", string.from_int(game.mine_count)), components.rect(mines_minus.x + 48, mines_minus.y, mines_plus.x - mines_minus.x - 48, 44), components.type_label(), theme.primary_text(light_mode))?
        components.modern_button(window, frame, resources, start, "ENTER CAVERN", components.button_primary(), game.bet <= game.balance, components.contains(start, mouse_x, mouse_y), true, light_mode)?
    if phase == 1:
        let cash = cash_out_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        components.modern_button(window, frame, resources, cash, "CASH OUT [S]", components.button_primary(), game.safe_reveals > 0, components.contains(cash, mouse_x, mouse_y), true, light_mode)?
    if phase == 2:
        let next = next_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        components.modern_button(window, frame, resources, next, "NEXT GRID [N]", components.button_primary(), true, components.contains(next, mouse_x, mouse_y), true, light_mode)?
    if phase != 1:
        let restart = restart_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        components.modern_button(window, frame, resources, restart, "RESET [R]", components.button_secondary(), true, components.contains(restart, mouse_x, mouse_y), false, light_mode)?
    draw_history(window, frame, resources, session, value, light_mode)?
    return Ok(true)

fn draw_help(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, light_mode: Bool) -> Result[Bool, String]:
    let lines = ["Choose 1-24 mines and a wager, then enter the 5 x 5 cavern.", "The complete unique mine layout is committed before any reveal.", "Unrevealed tiles never disclose whether a mine is underneath.", "Each gem raises the exact survival-based multiplier and potential payout.", "Cash Out is legal after one gem; a mine loses the prepaid wager.", "Multiplier = floor(9600 x C(25,r) / C(25-mines,r)) basis points.", "Payout = floor(wager x multiplier / 10000); return factor is 96%.", "Arrows configure/focus, Enter starts/reveals, and S cashes out.", "Finish or settle a live cavern before returning to the lobby."]
    return game_components.help_overlay(window, frame, resources, "MINES  /  EXACT CAVERN GUIDE", lines, -1, light_mode)

pub fn draw(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, session: mines_api.Session, selected_tile: Int, help: Bool, light_mode: Bool, reduced_motion: Bool, now: Float, animation_end: Float, mouse_x: Int, mouse_y: Int) -> Result[Bool, String]:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    let value = interior(width, height)
    game_components.ambient_stage(frame, resources, value.stage, 6, light_mode)?
    draw_board(window, frame, resources, session, selected_tile, mouse_x, mouse_y, light_mode, reduced_motion, now, animation_end)?
    draw_controls(window, frame, resources, session, value, mouse_x, mouse_y, light_mode)?
    let rules = help_rect(width, height)
    components.modern_button(window, frame, resources, rules, "RULES", components.button_quiet(), true, components.contains(rules, mouse_x, mouse_y), false, light_mode)?
    if help:
        draw_help(window, frame, resources, light_mode)?
    return Ok(true)
