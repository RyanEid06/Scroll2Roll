import src.app.components
import src.app.theme
import src.plinko.engine
import src.plinko.model
import src.plinko.rules
import src.rocket_raylib
import std.collections
import std.string

pub fn rows_minus_rect(width: Int) -> components.Rect:
    return components.rect(width - 330, 130, 46, 38)

pub fn rows_plus_rect(width: Int) -> components.Rect:
    return components.rect(width - 144, 130, 46, 38)

pub fn risk_rect(width: Int) -> components.Rect:
    return components.rect(width - 330, 184, 232, 40)

pub fn bet_minus_rect(width: Int) -> components.Rect:
    return components.rect(width - 330, 240, 46, 38)

pub fn bet_plus_rect(width: Int) -> components.Rect:
    return components.rect(width - 144, 240, 46, 38)

pub fn batch_minus_rect(width: Int) -> components.Rect:
    return components.rect(width - 330, 294, 46, 38)

pub fn batch_plus_rect(width: Int) -> components.Rect:
    return components.rect(width - 144, 294, 46, 38)

pub fn drop_rect(width: Int) -> components.Rect:
    return components.rect(width - 330, 354, 232, 46)

pub fn help_rect(width: Int) -> components.Rect:
    return components.rect(width - 118, 24, 86, 38)

pub fn next_rect(height: Int) -> components.Rect:
    return components.rect(32, height - 68, 150, 42)

pub fn lobby_rect(height: Int) -> components.Rect:
    return components.rect(192, height - 68, 120, 42)

fn board_center(width: Int) -> Int:
    return(width - 360) / 2

fn peg_gap(rows: Int, width: Int) -> Int:
    var gap =(width - 400) / rows
    if gap < 18:
        gap = 18
    if gap > 42:
        gap = 42
    return gap

fn row_gap(rows: Int, height: Int) -> Int:
    var gap =(height - 210) / rows
    if gap < 20:
        gap = 20
    if gap > 34:
        gap = 34
    return gap

fn board_top() -> Int:
    return 94

fn draw_board(frame: rocket_raylib.Frame, game: model.Game, width: Int, height: Int, stage: Int) -> Result[Bool, String]:
    let center = board_center(width)
    let horizontal = peg_gap(game.rows, width)
    let vertical = row_gap(game.rows, height)
    var row = 0
    while row < game.rows:
        var peg = 0
        while peg <= row:
            let x = center +(peg * 2 - row) * horizontal / 2
            let y = board_top() + row * vertical
            rocket_raylib.draw_circle(frame, x, y, 4.0, theme.border())?
            peg = peg + 1
        row = row + 1
    let multipliers = rules.multipliers(game.rows, game.risk)?
    let bucket_y = board_top() + game.rows * vertical + 12
    var bucket = 0
    while bucket <= game.rows:
        let x = center +(bucket * 2 - game.rows) * horizontal / 2
        var fill = theme.panel()
        if bucket == 0 or bucket == game.rows:
            fill = theme.danger()
        rocket_raylib.draw_rectangle(frame, x - horizontal / 2 + 2, bucket_y, horizontal - 4, 34, fill)?
        let label = string.concat(string.from_int(multipliers[bucket] / 100), "%")
        rocket_raylib.draw_text(frame, label, x - horizontal / 2 + 4, bucket_y + 10, 10, theme.text())?
        bucket = bucket + 1
    if engine.phase_code(game.phase) == 1:
        var ball = 0
        while ball < collections.length(game.pending):
            var ball_stage = stage - ball * 2
            if ball_stage < 0:
                ball_stage = 0
            if ball_stage > game.rows:
                ball_stage = game.rows
            var rights = 0
            var step = 0
            while step < ball_stage:
                rights = rights + game.pending[ball].path[step]
                step = step + 1
            let ball_x = center +(rights * 2 - ball_stage) * horizontal / 2
            let ball_y = board_top() - 18 + ball_stage * vertical
            rocket_raylib.draw_circle(frame, ball_x, ball_y, 8.0, theme.gold())?
            ball = ball + 1
    return Ok(true)

fn draw_help(window: rocket_raylib.Window, frame: rocket_raylib.Frame) -> Result[Bool, String]:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    rocket_raylib.draw_rectangle(frame, 0, 0, width, height, theme.overlay())?
    let box = components.rect(width / 2 - 350, 92, 700, 490)
    components.panel(frame, box)?
    rocket_raylib.draw_text(frame, "PLINKO RULES AND RETURN", box.x + 28, box.y + 28, theme.heading_size(), theme.gold())?
    let lines = ["Choose 8-16 rows and Low, Medium, or High risk.", "Each row is one deterministic seeded 50/50 left/right engine step.", "The landing bucket is the number of right steps in the tested path.", "Multiplier tables use basis points; settlement floors fractional credits.", "Exact binomial auditing yields a 95.98%-96.00% theoretical return.", "High risk moves value from center buckets to rare edge buckets.", "Drop 1-10 balls; every batch is finite and prepaid before animation.", "Left/Right rows | Tab risk | Up/Down bet | M balls | Enter drop.", "P closes help. Credits are local play money with no monetary value."]
    var index = 0
    while index < collections.length(lines):
        rocket_raylib.draw_text(frame, lines[index], box.x + 28, box.y + 86 + index * 40, theme.body_size(), theme.text())?
        index = index + 1
    return Ok(true)

pub fn draw(window: rocket_raylib.Window, frame: rocket_raylib.Frame, game: model.Game, stage: Int, help: Bool, mouse_x: Int, mouse_y: Int) -> Result[Bool, String]:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    rocket_raylib.draw_text(frame, "PLINKO", 32, 28, theme.heading_size(), theme.gold())?
    rocket_raylib.draw_text(frame, game.message, 188, 36, theme.body_size(), theme.text())?
    rocket_raylib.draw_text(frame, string.concat("Credits ", string.from_int(game.balance)), width - 300, 36, theme.body_size(), theme.emerald())?
    let help_button = help_rect(width)
    components.button(window, frame, help_button, "Help [P]", true, components.contains(help_button, mouse_x, mouse_y), false)?
    draw_board(frame, game, width, height, stage)?
    components.panel(frame, components.rect(width - 350, 110, 272, 330))?
    rocket_raylib.draw_text(frame, string.concat("Rows: ", string.from_int(game.rows)), width - 270, 140, theme.body_size(), theme.text())?
    components.button(window, frame, rows_minus_rect(width), "-", engine.phase_code(game.phase) == 0, components.contains(rows_minus_rect(width), mouse_x, mouse_y), false)?
    components.button(window, frame, rows_plus_rect(width), "+", engine.phase_code(game.phase) == 0, components.contains(rows_plus_rect(width), mouse_x, mouse_y), false)?
    components.button(window, frame, risk_rect(width), string.concat("Risk: ", rules.risk_name(game.risk)), engine.phase_code(game.phase) == 0, components.contains(risk_rect(width), mouse_x, mouse_y), false)?
    rocket_raylib.draw_text(frame, string.concat("Bet: ", string.from_int(game.bet)), width - 270, 250, theme.body_size(), theme.text())?
    components.button(window, frame, bet_minus_rect(width), "-", engine.phase_code(game.phase) == 0, components.contains(bet_minus_rect(width), mouse_x, mouse_y), false)?
    components.button(window, frame, bet_plus_rect(width), "+", engine.phase_code(game.phase) == 0, components.contains(bet_plus_rect(width), mouse_x, mouse_y), false)?
    rocket_raylib.draw_text(frame, string.concat("Balls: ", string.from_int(game.batch_count)), width - 270, 304, theme.body_size(), theme.text())?
    components.button(window, frame, batch_minus_rect(width), "-", engine.phase_code(game.phase) == 0, components.contains(batch_minus_rect(width), mouse_x, mouse_y), false)?
    components.button(window, frame, batch_plus_rect(width), "+", engine.phase_code(game.phase) == 0, components.contains(batch_plus_rect(width), mouse_x, mouse_y), false)?
    let wager = game.bet * game.batch_count
    components.button(window, frame, drop_rect(width), string.concat("Drop ", string.from_int(wager)), engine.phase_code(game.phase) == 0 and wager <= game.balance, components.contains(drop_rect(width), mouse_x, mouse_y), true)?
    let expected = rules.expected_return_basis_points(game.rows, game.risk)?
    rocket_raylib.draw_text(frame, string.concat("Audited return: ", string.concat(string.from_int(expected / 100), string.concat(".", string.from_int(expected - expected / 100 * 100)))), width - 330, 414, theme.small_size(), theme.muted())?
    let phase = engine.phase_code(game.phase)
    if phase == 1:
        rocket_raylib.draw_text(frame, "Animation follows precomputed engine paths", 32, height - 56, theme.body_size(), theme.gold())?
    if phase == 2:
        rocket_raylib.draw_text(frame, string.concat("Wager ", string.from_int(game.total_wager)), 32, height - 104, theme.body_size(), theme.text())?
        rocket_raylib.draw_text(frame, string.concat("Return ", string.from_int(game.total_return)), 168, height - 104, theme.body_size(), theme.emerald())?
        let next = next_rect(height)
        let lobby = lobby_rect(height)
        components.button(window, frame, next, "Next [N]", true, components.contains(next, mouse_x, mouse_y), true)?
        components.button(window, frame, lobby, "Lobby [B]", true, components.contains(lobby, mouse_x, mouse_y), false)?
    if phase == 0:
        rocket_raylib.draw_text(frame, "B or Escape returns to the lobby", 32, height - 56, theme.small_size(), theme.muted())?
    if help:
        draw_help(window, frame)?
    return Ok(true)
