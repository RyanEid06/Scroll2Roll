import src.app.components
import src.app.game_components
import src.app.game_layout
import src.app.shell_view
import src.app.theme
import src.app.ui_resources
import src.plinko.plinko_engine
import src.plinko.plinko_model
import src.plinko.plinko_rules
import src.rocket_raylib
import std.collections
import std.string

fn interior(width: Int, height: Int) -> game_layout.Interior:
    return game_layout.interior(width, height)

pub fn rows_minus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 16, value.dock.y + 12, 44, 44)
    return components.rect(value.rail.x + 16, value.rail.y + 156, 48, 44)

pub fn rows_plus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 120, value.dock.y + 12, 44, 44)
    return components.rect(value.rail.x + value.rail.width - 64, value.rail.y + 156, 48, 44)

pub fn risk_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 178, value.dock.y + 12, 150, 44)
    return components.rect(value.rail.x + 16, value.rail.y + 216, value.rail.width - 32, 44)

pub fn bet_minus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 344, value.dock.y + 12, 44, 44)
    return components.rect(value.rail.x + 16, value.rail.y + 276, 48, 44)

pub fn bet_plus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 448, value.dock.y + 12, 44, 44)
    return components.rect(value.rail.x + value.rail.width - 64, value.rail.y + 276, 48, 44)

pub fn batch_minus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 508, value.dock.y + 12, 44, 44)
    return components.rect(value.rail.x + 16, value.rail.y + 336, 48, 44)

pub fn batch_plus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 612, value.dock.y + 12, 44, 44)
    return components.rect(value.rail.x + value.rail.width - 64, value.rail.y + 336, 48, 44)

pub fn drop_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 16, value.dock.y + value.dock.height - 60, value.dock.width - 32, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 64, value.rail.width - 32, 48)

pub fn help_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    return components.rect(value.stage.x + value.stage.width - 88, value.stage.y + 6, 76, 44)

pub fn next_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 16, value.dock.y + value.dock.height - 60, value.dock.width - 32, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 64, value.rail.width - 32, 48)

pub fn lobby_rect(width: Int, height: Int) -> components.Rect:
    let expected = height
    return shell_view.back_rect(width)

fn phase_name(code: Int) -> String:
    if code == 0:
        return "BOARD READY"
    if code == 1:
        return "BALLS IN PLAY"
    return "BATCH SETTLED"

fn draw_stage_background(frame: rocket_raylib.Frame, resources: ui_resources.UiResources, value: components.Rect, light_mode: Bool) -> Result[Bool, String]:
    if not resources.group_three.plinko_chamber_ready:
        return game_components.ambient_stage(frame, resources, value, 2, light_mode)
    rocket_raylib.draw_rounded_rectangle(frame, value.x, value.y, value.width, value.height, 0.04, 12, theme.surface(light_mode))?
    rocket_raylib.begin_scissor(frame, value.x, value.y, value.width, value.height)?
    game_components.texture_cover(frame, resources.group_three.plinko_chamber, value, 224)?
    var veil = rocket_raylib.color(3, 9, 25, 112)
    if light_mode:
        veil = rocket_raylib.color(236, 243, 250, 142)
    rocket_raylib.draw_rectangle(frame, value.x, value.y, value.width, value.height, veil)?
    rocket_raylib.end_scissor(frame)?
    return rocket_raylib.draw_rounded_rectangle_lines(frame, value.x, value.y, value.width, value.height, 0.04, 12, 1.0, theme.subtle_border(light_mode))

fn board_rect(value: game_layout.Interior) -> components.Rect:
    return game_layout.inset(value.stage, 18)

fn peg_gap(game: plinko_model.Game, board: components.Rect) -> Int:
    var gap =(board.width - 60) / game.rows
    if gap > 46:
        gap = 46
    if gap < 18:
        gap = 18
    return gap

fn row_gap(game: plinko_model.Game, board: components.Rect) -> Int:
    var gap =(board.height - 78) / game.rows
    if gap > 38:
        gap = 38
    if gap < 15:
        gap = 15
    return gap

fn path_progress(now: Float, animation_end: Float, reduced_motion: Bool) -> Int:
    if reduced_motion:
        return 0
    let remaining = animation_end - now
    if remaining <= 0.0:
        return 8
    if remaining > 0.07:
        return 0
    if remaining > 0.06:
        return 1
    if remaining > 0.05:
        return 2
    if remaining > 0.04:
        return 3
    if remaining > 0.03:
        return 4
    if remaining > 0.02:
        return 5
    if remaining > 0.01:
        return 6
    return 7

fn landed_in_bucket(game: plinko_model.Game, stage: Int, bucket: Int) -> Int:
    var count = 0
    var ball = 0
    while ball < collections.length(game.pending):
        var landed = plinko_engine.phase_code(game.phase) == 2
        if stage - ball * 2 >= game.rows:
            landed = true
        if landed and game.pending[ball].bucket == bucket:
            count = count + 1
        ball = ball + 1
    return count

fn draw_board(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, game: plinko_model.Game, value: game_layout.Interior, stage: Int, light_mode: Bool, reduced_motion: Bool, now: Float, animation_end: Float) -> Result[Bool, String]:
    let board = board_rect(value)
    rocket_raylib.draw_rounded_rectangle(frame, board.x, board.y, board.width, board.height, 0.06, 12, rocket_raylib.color(6, 19, 45, 224))?
    rocket_raylib.begin_scissor(frame, board.x, board.y, board.width, board.height)?
    if resources.group_three.plinko_enclosure_ready:
        game_components.texture_cover(frame, resources.group_three.plinko_enclosure, board, 238)?
    let field = components.rect(board.x + 24, board.y + 20, board.width - 48, board.height - 38)
    rocket_raylib.draw_rounded_rectangle(frame, field.x, field.y, field.width, field.height, 0.05, 10, rocket_raylib.color(3, 15, 38, 226))?
    rocket_raylib.draw_rounded_rectangle_lines(frame, field.x, field.y, field.width, field.height, 0.05, 10, 1.0, rocket_raylib.color(106, 206, 255, 108))?
    let center = board.x + board.width / 2
    let horizontal = peg_gap(game, board)
    let vertical = row_gap(game, board)
    let top = board.y + 28
    var row = 0
    while row < game.rows:
        var peg = 0
        while peg <= row:
            let x = center +(peg * 2 - row) * horizontal / 2
            let y = top + row * vertical
            rocket_raylib.draw_circle_pixels(frame, x + 2, y + 2, 5, rocket_raylib.color(2, 6, 23, 120))?
            rocket_raylib.draw_circle_pixels(frame, x, y, 4, rocket_raylib.color(190, 223, 255, 255))?
            rocket_raylib.draw_circle_pixels(frame, x - 1, y - 1, 1, rocket_raylib.color(255, 255, 255, 255))?
            peg = peg + 1
        row = row + 1
    let multipliers = plinko_rules.multipliers(game.rows, game.risk)?
    let bucket_y = top + game.rows * vertical + 6
    var bucket = 0
    while bucket <= game.rows:
        let x = center +(bucket * 2 - game.rows) * horizontal / 2
        var fill = theme.violet(false)
        if bucket == 0 or bucket == game.rows:
            fill = theme.destructive(light_mode)
        if bucket > game.rows / 3 and bucket < game.rows * 2 / 3:
            fill = theme.success(light_mode)
        let bucket_box = components.rect(x - horizontal / 2 + 2, bucket_y, horizontal - 4, 34)
        rocket_raylib.draw_rounded_rectangle(frame, bucket_box.x, bucket_box.y, bucket_box.width, bucket_box.height, 0.18, 6, fill)?
        let landed = landed_in_bucket(game, stage, bucket)
        if landed > 0:
            rocket_raylib.draw_rounded_rectangle_lines(frame, bucket_box.x - 2, bucket_box.y - 2, bucket_box.width + 4, bucket_box.height + 4, 0.18, 6, 3.0, theme.highlight(light_mode))?
            if not reduced_motion:
                rocket_raylib.draw_ring_pixels(frame, x, bucket_y + 17, horizontal / 4, horizontal / 2, 0.0, 360.0, 20, rocket_raylib.color(255, 220, 112, 96))?
        components.type_centered(window, frame, resources, string.concat(string.from_int(multipliers[bucket] / 100), "%"), bucket_box, components.type_caption(), rocket_raylib.color(255, 255, 255, 255))?
        bucket = bucket + 1
    if plinko_engine.phase_code(game.phase) == 1:
        let progress = path_progress(now, animation_end, reduced_motion)
        var ball = 0
        while ball < collections.length(game.pending):
            let raw_stage = stage - ball * 2
            var ball_stage = raw_stage
            if ball_stage < 0:
                ball_stage = 0
            if ball_stage > game.rows:
                ball_stage = game.rows
            var rights = 0
            var step = 0
            while step < ball_stage:
                rights = rights + game.pending[ball].path[step]
                step = step + 1
            let ball_x = center +(rights * 2 - ball_stage) * horizontal / 2
            let ball_y = top - 16 + ball_stage * vertical
            var displayed_x = ball_x
            var displayed_y = ball_y
            if raw_stage >= 0 and ball_stage < game.rows:
                let next_stage = ball_stage + 1
                let next_rights = rights + game.pending[ball].path[ball_stage]
                let next_x = center +(next_rights * 2 - next_stage) * horizontal / 2
                let next_y = top - 16 + next_stage * vertical
                displayed_x =(ball_x *(8 - progress) + next_x * progress) / 8
                displayed_y =(ball_y *(8 - progress) + next_y * progress) / 8
                if not reduced_motion and progress > 1:
                    let trail_progress = progress - 2
                    let trail_x =(ball_x *(8 - trail_progress) + next_x * trail_progress) / 8
                    let trail_y =(ball_y *(8 - trail_progress) + next_y * trail_progress) / 8
                    rocket_raylib.draw_circle_pixels(frame, trail_x, trail_y, 6, rocket_raylib.color(249, 197, 81, 72))?
                if not reduced_motion and progress >= 6:
                    rocket_raylib.draw_ring_pixels(frame, displayed_x, displayed_y, 9, 13, 0.0, 360.0, 18, rocket_raylib.color(118, 220, 255, 138))?
            rocket_raylib.draw_circle_pixels(frame, displayed_x + 3, displayed_y + 4, 9, rocket_raylib.color(2, 6, 23, 110))?
            rocket_raylib.draw_circle_pixels(frame, displayed_x, displayed_y, 8, theme.highlight(light_mode))?
            ball = ball + 1
    rocket_raylib.end_scissor(frame)?
    rocket_raylib.draw_rounded_rectangle_lines(frame, board.x, board.y, board.width, board.height, 0.06, 12, 2.0, theme.cyan(light_mode))?
    components.type_text(window, frame, resources, "AUDITED PEG CHAMBER", board.x + 16, board.y + 12, components.type_caption(), rocket_raylib.color(255, 255, 255, 125))?
    return Ok(true)

fn draw_controls(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, game: plinko_model.Game, value: game_layout.Interior, mouse_x: Int, mouse_y: Int, light_mode: Bool) -> Result[Bool, String]:
    components.modern_panel(frame, value.rail, light_mode, true)?
    let phase = plinko_engine.phase_code(game.phase)
    let wager = game.bet * game.batch_count
    let expected = plinko_rules.expected_return_basis_points(game.rows, game.risk)?
    if value.compact:
        components.type_centered(window, frame, resources, string.concat("ROWS ", string.from_int(game.rows)), components.rect(value.dock.x + 60, value.dock.y + 12, 60, 44), components.type_caption(), theme.primary_text(light_mode))?
        components.type_centered(window, frame, resources, string.concat("BET ", string.from_int(game.bet)), components.rect(value.dock.x + 388, value.dock.y + 12, 60, 44), components.type_caption(), theme.primary_text(light_mode))?
        components.type_centered(window, frame, resources, string.concat("BALLS ", string.from_int(game.batch_count)), components.rect(value.dock.x + 552, value.dock.y + 12, 60, 44), components.type_caption(), theme.primary_text(light_mode))?
        if phase == 1:
            components.badge(window, frame, resources, components.rect(value.dock.x + 16, value.dock.y + 80, 138, 28), phase_name(phase), light_mode)?
            game_components.status_banner(window, frame, resources, components.rect(value.dock.x + 170, value.dock.y + 68, value.dock.width - 186, 54), game.message, light_mode)?
    else:
        components.badge(window, frame, resources, components.rect(value.rail.x + 16, value.rail.y + 16, 138, 28), phase_name(phase), light_mode)?
        game_components.status_banner(window, frame, resources, components.rect(value.rail.x + 16, value.rail.y + 56, value.rail.width - 32, 54), game.message, light_mode)?
        game_components.metric(window, frame, resources, "AUDITED RETURN", string.concat(string.from_int(expected / 100), "%"), value.rail.x + 16, value.rail.y + 118, 140, true, light_mode)?
        components.type_centered(window, frame, resources, string.concat("ROWS  ", string.from_int(game.rows)), components.rect(value.rail.x + 70, value.rail.y + 156, value.rail.width - 140, 44), components.type_label(), theme.primary_text(light_mode))?
        components.type_centered(window, frame, resources, string.concat("BET  ", string.from_int(game.bet)), components.rect(value.rail.x + 70, value.rail.y + 276, value.rail.width - 140, 44), components.type_label(), theme.primary_text(light_mode))?
        components.type_centered(window, frame, resources, string.concat("BALLS  ", string.from_int(game.batch_count)), components.rect(value.rail.x + 70, value.rail.y + 336, value.rail.width - 140, 44), components.type_label(), theme.primary_text(light_mode))?
    let enabled = phase == 0
    let minus_rows = rows_minus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
    let plus_rows = rows_plus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
    let risk = risk_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
    let minus_bet = bet_minus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
    let plus_bet = bet_plus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
    let minus_batch = batch_minus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
    let plus_batch = batch_plus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
    components.modern_button(window, frame, resources, minus_rows, "-", components.button_secondary(), enabled, components.contains(minus_rows, mouse_x, mouse_y), false, light_mode)?
    components.modern_button(window, frame, resources, plus_rows, "+", components.button_secondary(), enabled, components.contains(plus_rows, mouse_x, mouse_y), false, light_mode)?
    components.modern_button(window, frame, resources, risk, plinko_rules.risk_name(game.risk), components.button_secondary(), enabled, components.contains(risk, mouse_x, mouse_y), false, light_mode)?
    components.modern_button(window, frame, resources, minus_bet, "-", components.button_secondary(), enabled, components.contains(minus_bet, mouse_x, mouse_y), false, light_mode)?
    components.modern_button(window, frame, resources, plus_bet, "+", components.button_secondary(), enabled, components.contains(plus_bet, mouse_x, mouse_y), false, light_mode)?
    components.modern_button(window, frame, resources, minus_batch, "-", components.button_secondary(), enabled, components.contains(minus_batch, mouse_x, mouse_y), false, light_mode)?
    components.modern_button(window, frame, resources, plus_batch, "+", components.button_secondary(), enabled, components.contains(plus_batch, mouse_x, mouse_y), false, light_mode)?
    if phase == 0:
        let drop = drop_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        components.modern_button(window, frame, resources, drop, string.concat("DROP  ", string.from_int(wager)), components.button_primary(), wager <= game.balance, components.contains(drop, mouse_x, mouse_y), true, light_mode)?
    if phase == 2:
        if not value.compact:
            game_components.metric(window, frame, resources, "RETURN", string.from_int(game.total_return), value.rail.x + 16, value.rail.y + 410, 120, true, light_mode)?
        let next = next_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        components.modern_button(window, frame, resources, next, "NEXT BOARD [N]", components.button_primary(), true, components.contains(next, mouse_x, mouse_y), true, light_mode)?
    return Ok(true)

fn draw_help(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, light_mode: Bool) -> Result[Bool, String]:
    let lines = ["Choose 8-16 rows and Low, Medium, or High risk.", "Every row is one deterministic seeded 50/50 engine step.", "The landing bucket equals the number of right steps in the tested path.", "Basis-point multipliers settle with one final integer-credit floor.", "Exact binomial auditing yields a 95.98%-96.00% theoretical return.", "High risk moves value from center buckets to rare edge buckets.", "Drop one to ten balls; every finite batch is prepaid before motion.", "Left/Right changes rows, Tab risk, Up/Down wager, and M balls.", "Animation follows committed paths and never chooses a bucket."]
    return game_components.help_overlay(window, frame, resources, "PLINKO  /  AUDITED RETURN GUIDE", lines, -1, light_mode)

pub fn draw(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, game: plinko_model.Game, stage: Int, help: Bool, light_mode: Bool, reduced_motion: Bool, now: Float, animation_end: Float, mouse_x: Int, mouse_y: Int) -> Result[Bool, String]:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    let value = interior(width, height)
    draw_stage_background(frame, resources, value.stage, light_mode)?
    draw_board(window, frame, resources, game, value, stage, light_mode, reduced_motion, now, animation_end)?
    draw_controls(window, frame, resources, game, value, mouse_x, mouse_y, light_mode)?
    let rules = help_rect(width, height)
    components.modern_button(window, frame, resources, rules, "RULES", components.button_quiet(), true, components.contains(rules, mouse_x, mouse_y), false, light_mode)?
    if help:
        draw_help(window, frame, resources, light_mode)?
    return Ok(true)
