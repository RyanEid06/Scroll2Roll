import src.app.components
import src.app.game_components
import src.app.game_layout
import src.app.shell_view
import src.app.theme
import src.app.ui_resources
import src.crash.crash_api
import src.crash.crash_rules
import src.rocket_raylib
import std.collections
import std.string

fn interior(width: Int, height: Int) -> game_layout.Interior:
    return game_layout.interior(width, height)

pub fn bet_minus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 16, value.dock.y + 14, 44, 44)
    return components.rect(value.rail.x + 16, value.rail.y + 184, 48, 44)

pub fn bet_plus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 136, value.dock.y + 14, 44, 44)
    return components.rect(value.rail.x + value.rail.width - 64, value.rail.y + 184, 48, 44)

pub fn auto_toggle_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 196, value.dock.y + 14, 136, 44)
    return components.rect(value.rail.x + 16, value.rail.y + 246, value.rail.width - 144, 44)

pub fn auto_minus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 342, value.dock.y + 14, 44, 44)
    return components.rect(value.rail.x + value.rail.width - 120, value.rail.y + 246, 48, 44)

pub fn auto_plus_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 396, value.dock.y + 14, 44, 44)
    return components.rect(value.rail.x + value.rail.width - 64, value.rail.y + 246, 48, 44)

pub fn start_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 456, value.dock.y + 14, value.dock.width - 472, 44)
    return components.rect(value.rail.x + 16, value.rail.y + 306, value.rail.width - 32, 50)

pub fn cash_out_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + value.dock.width / 2, value.dock.y + value.dock.height - 60, value.dock.width / 2 - 16, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 128, value.rail.width - 32, 50)

pub fn help_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    return components.rect(value.stage.x + value.stage.width - 88, value.stage.y + 6, 76, 44)

pub fn next_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + 16, value.dock.y + value.dock.height - 60, value.dock.width / 2 - 24, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 128, value.rail.width - 32, 50)

pub fn restart_rect(width: Int, height: Int) -> components.Rect:
    let value = interior(width, height)
    if value.compact:
        return components.rect(value.dock.x + value.dock.width / 2, value.dock.y + value.dock.height - 60, value.dock.width / 2 - 16, 48)
    return components.rect(value.rail.x + 16, value.rail.y + value.rail.height - 68, value.rail.width - 32, 50)

pub fn lobby_rect(width: Int, height: Int) -> components.Rect:
    let expected = height
    return shell_view.back_rect(width)

fn multiplier_label(basis_points: Int) -> String:
    let whole = basis_points / 10000
    let hundredths =(basis_points - whole * 10000) / 100
    var fraction = string.from_int(hundredths)
    if hundredths < 10:
        fraction = string.concat("0", fraction)
    return string.concat(string.from_int(whole), string.concat(".", string.concat(fraction, "x")))

fn phase_name(phase: Int) -> String:
    if phase == 0:
        return "FLIGHT READY"
    if phase == 1:
        return "IN FLIGHT"
    return "FLIGHT SETTLED"

fn graph_color(table: crash_api.PublicTable, light_mode: Bool) -> rocket_raylib.Color:
    if table.crashed:
        return theme.destructive(light_mode)
    if table.multiplier_basis_points >= 50000:
        return theme.highlight(light_mode)
    if table.multiplier_basis_points >= 20000:
        return theme.violet(light_mode)
    return theme.success(light_mode)

fn draw_cover_texture(frame: rocket_raylib.Frame, texture: rocket_raylib.Texture, value: components.Rect, alpha: Int) -> Result[Bool, String]:
    var source_x = 0
    var source_y = 0
    var source_width = texture.width
    var source_height = texture.height
    if value.width * texture.height > value.height * texture.width:
        source_height = texture.width * value.height / value.width
        source_y =(texture.height - source_height) / 2
    else:
        source_width = texture.height * value.width / value.height
        source_x =(texture.width - source_width) / 2
    return rocket_raylib.draw_texture_region(frame, texture, source_x, source_y, source_width, source_height, value.x, value.y, value.width, value.height, rocket_raylib.color(255, 255, 255, alpha))

fn draw_asset(frame: rocket_raylib.Frame, texture: rocket_raylib.Texture, source_x: Int, source_y: Int, source_width: Int, source_height: Int, value: components.Rect, alpha: Int) -> Result[Bool, String]:
    return rocket_raylib.draw_texture_region(frame, texture, source_x, source_y, source_width, source_height, value.x, value.y, value.width, value.height, rocket_raylib.color(255, 255, 255, alpha))

fn draw_grid(frame: rocket_raylib.Frame, box: components.Rect, light_mode: Bool) -> Result[Bool, String]:
    var column = 1
    while column < 6:
        let x = box.x + box.width * column / 6
        rocket_raylib.draw_line(frame, x, box.y, x, box.y + box.height, 1.0, rocket_raylib.color(130, 170, 220, 38))?
        column = column + 1
    var row = 1
    while row < 5:
        let y = box.y + box.height * row / 5
        rocket_raylib.draw_line(frame, box.x, y, box.x + box.width, y, 1.0, rocket_raylib.color(130, 170, 220, 38))?
        row = row + 1
    return rocket_raylib.draw_rounded_rectangle_lines(frame, box.x, box.y, box.width, box.height, 0.04, 8, 1.0, theme.subtle_border(light_mode))

fn curve_point(table: crash_api.PublicTable, graph: components.Rect, point: Int, count: Int) -> Result[components.Rect, String]:
    var source_tick = table.tick_count - count + point
    if source_tick < 0:
        source_tick = 0
    let value = crash_rules.multiplier_for_tick(source_tick)?
    var range = table.multiplier_basis_points - 10000
    if range < 2000:
        range = 2000
    var vertical =(value - 10000) *(graph.height - 156) / range
    if vertical > graph.height - 156:
        vertical = graph.height - 156
    return Ok(components.rect(graph.x + 104 + point *(graph.width - 208) / count, graph.y + graph.height - 78 - vertical, 1, 1))

fn draw_fallback_rocket(frame: rocket_raylib.Frame, x: Int, y: Int, tick: Int, reduced_motion: Bool, light_mode: Bool) -> Result[Bool, String]:
    var flame = 20
    if not reduced_motion and tick - tick / 2 * 2 == 0:
        flame = 30
    rocket_raylib.draw_triangle(frame, x - 20 - flame, y + 8, x - 20, y - 7, x - 20, y + 20, theme.highlight(light_mode))?
    rocket_raylib.draw_triangle(frame, x + 26, y, x - 14, y - 22, x - 14, y + 22, theme.cyan(light_mode))?
    rocket_raylib.draw_triangle(frame, x - 8, y - 18, x - 24, y - 32, x - 20, y - 8, theme.violet(light_mode))?
    rocket_raylib.draw_triangle(frame, x - 8, y + 18, x - 24, y + 32, x - 20, y + 8, theme.violet(light_mode))?
    return rocket_raylib.draw_circle_pixels(frame, x - 2, y, 6, rocket_raylib.color(235, 249, 255, 255))

fn draw_flight_trail(frame: rocket_raylib.Frame, x: Int, y: Int, tick: Int, reduced_motion: Bool, light_mode: Bool) -> Result[Bool, String]:
    var flame = 18
    if not reduced_motion and tick - tick / 2 * 2 == 0:
        flame = 28
    rocket_raylib.draw_triangle(frame, x - 46 - flame, y + 24 + flame / 2, x - 44, y + 12, x - 28, y + 30, theme.highlight(light_mode))?
    rocket_raylib.draw_triangle(frame, x - 38 - flame / 2, y + 28 + flame / 2, x - 32, y + 17, x - 18, y + 34, theme.cyan(light_mode))?
    if not reduced_motion:
        var mote = 0
        while mote < 4:
            let drift = 26 + mote * 18 +(tick + mote * 3) -((tick + mote * 3) / 8) * 8
            rocket_raylib.draw_circle_pixels(frame, x - drift, y + 28 + mote * 5, 2 + mote / 2, rocket_raylib.color(255, 180, 66, 150 - mote * 24))?
            mote = mote + 1
    return Ok(true)

fn draw_crash_marker(frame: rocket_raylib.Frame, resources: ui_resources.UiResources, x: Int, y: Int, light_mode: Bool) -> Result[Bool, String]:
    let danger = theme.destructive(light_mode)
    if resources.crash_burst_ready:
        draw_asset(frame, resources.crash_burst, 0, 56, 1233, 1127, components.rect(x - 54, y - 49, 108, 98), 245)?
    else:
        rocket_raylib.draw_line(frame, x - 34, y, x + 34, y, 4.0, danger)?
        rocket_raylib.draw_line(frame, x, y - 34, x, y + 34, 4.0, danger)?
        rocket_raylib.draw_line(frame, x - 24, y - 24, x + 24, y + 24, 4.0, danger)?
        rocket_raylib.draw_line(frame, x + 24, y - 24, x - 24, y + 24, 4.0, danger)?
    return rocket_raylib.draw_ring_pixels(frame, x, y, 34, 39, 0.0, 360.0, 36, danger)

fn draw_flight_vehicle(frame: rocket_raylib.Frame, resources: ui_resources.UiResources, table: crash_api.PublicTable, x: Int, y: Int, reduced_motion: Bool, light_mode: Bool) -> Result[Bool, String]:
    let vehicle_y = y - 36
    if table.crashed:
        return draw_crash_marker(frame, resources, x, y, light_mode)
    if table.phase == 1:
        draw_flight_trail(frame, x, vehicle_y, table.tick_count, reduced_motion, light_mode)?
    if table.cashed_out:
        rocket_raylib.draw_ring_pixels(frame, x, vehicle_y, 42, 47, 0.0, 360.0, 36, theme.success(light_mode))?
    if resources.crash_rocket_ready:
        return draw_asset(frame, resources.crash_rocket, 172, 186, 1055, 823, components.rect(x - 58, vehicle_y - 47, 116, 90), 255)
    return draw_fallback_rocket(frame, x, vehicle_y, table.tick_count, reduced_motion, light_mode)

fn draw_flight_background(frame: rocket_raylib.Frame, resources: ui_resources.UiResources, graph: components.Rect, table: crash_api.PublicTable, light_mode: Bool, reduced_motion: Bool) -> Result[Bool, String]:
    rocket_raylib.draw_rounded_rectangle(frame, graph.x, graph.y, graph.width, graph.height, 0.04, 10, rocket_raylib.color(4, 13, 35, 245))?
    if resources.crash_flight_ready:
        draw_cover_texture(frame, resources.crash_flight, graph, 255)?
        var veil = rocket_raylib.color(3, 9, 28, 92)
        if light_mode:
            veil = rocket_raylib.color(232, 240, 250, 48)
        rocket_raylib.draw_rectangle(frame, graph.x, graph.y, graph.width, graph.height, veil)?
    if table.phase == 1 and not reduced_motion:
        var streak = 0
        while streak < 7:
            let offset =(table.tick_count * 11 + streak * 83) -((table.tick_count * 11 + streak * 83) /(graph.width + 120)) *(graph.width + 120)
            let streak_x = graph.x + graph.width - offset
            let streak_y = graph.y + 38 + streak *(graph.height - 76) / 7
            rocket_raylib.draw_line(frame, streak_x, streak_y, streak_x + 36, streak_y - 12, 2.0, rocket_raylib.color(173, 226, 255, 105))?
            streak = streak + 1
    return Ok(true)

fn draw_graph(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, table: crash_api.PublicTable, value: game_layout.Interior, light_mode: Bool, reduced_motion: Bool) -> Result[Bool, String]:
    let graph = game_layout.inset(value.stage, 20)
    rocket_raylib.begin_scissor(frame, graph.x, graph.y, graph.width, graph.height)?
    draw_flight_background(frame, resources, graph, table, light_mode, reduced_motion)?
    draw_grid(frame, graph, light_mode)?
    let ink = graph_color(table, light_mode)
    var count = table.tick_count
    if count > 90:
        count = 90
    if count < 1:
        count = 1
    var previous = curve_point(table, graph, 0, count)?
    var point = 1
    while point <= count:
        let current = curve_point(table, graph, point, count)?
        rocket_raylib.draw_line(frame, previous.x, previous.y, current.x, current.y, 3.0, ink)?
        previous = current
        point = point + 1
    var rocket_x = previous.x
    var rocket_y = previous.y
    if table.phase == 0:
        rocket_x = graph.x + 104
        rocket_y = graph.y + graph.height - 42
    draw_flight_vehicle(frame, resources, table, rocket_x, rocket_y, reduced_motion, light_mode)?
    let readout = components.rect(graph.x + 22, graph.y + 22, 256, 108)
    rocket_raylib.draw_rounded_rectangle(frame, readout.x, readout.y, readout.width, readout.height, 0.16, 10, rocket_raylib.color(4, 9, 28, 218))?
    components.type_centered(window, frame, resources, multiplier_label(table.multiplier_basis_points), components.rect(readout.x, readout.y + 9, readout.width, 58), components.type_display(), ink)?
    var subtitle = "PRECOMMITTED POINT HIDDEN"
    if table.phase == 2:
        subtitle = string.concat("REVEALED  ", multiplier_label(table.revealed_crash_basis_points))
    components.type_centered(window, frame, resources, subtitle, components.rect(readout.x, readout.y + 70, readout.width, 24), components.type_caption(), rocket_raylib.color(235, 243, 255, 180))?
    components.type_text(window, frame, resources, "LOCAL FLIGHT CURVE  /  20 HZ", graph.x + 16, graph.y + graph.height - 24, components.type_caption(), rocket_raylib.color(255, 255, 255, 160))?
    rocket_raylib.end_scissor(frame)?
    return rocket_raylib.draw_rounded_rectangle_lines(frame, graph.x, graph.y, graph.width, graph.height, 0.04, 8, 2.0, theme.subtle_border(light_mode))

fn draw_history(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, table: crash_api.PublicTable, value: game_layout.Interior, light_mode: Bool) -> Result[Bool, String]:
    if value.compact:
        return Ok(true)
    components.type_text(window, frame, resources, "RECENT COMMITTED POINTS", value.rail.x + 16, value.rail.y + 382, components.type_caption(), theme.secondary_text(light_mode))?
    var index = 0
    while index < collections.length(table.history) and index < 5:
        let result = table.history[index]
        var label = string.concat("CRASH  ", multiplier_label(result.crash_basis_points))
        var ink = theme.destructive(light_mode)
        if result.payout > 0:
            label = string.concat(string.concat("OUT  ", multiplier_label(result.cash_out_basis_points)), string.concat("  /  ", string.from_int(result.payout)))
            ink = theme.success(light_mode)
        components.type_text(window, frame, resources, label, value.rail.x + 16, value.rail.y + 408 + index * 24, components.type_caption(), ink)?
        index = index + 1
    return Ok(true)

fn draw_controls(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, table: crash_api.PublicTable, value: game_layout.Interior, mouse_x: Int, mouse_y: Int, light_mode: Bool) -> Result[Bool, String]:
    components.modern_panel(frame, value.rail, light_mode, true)?
    if value.compact:
        if table.phase == 0:
            components.type_centered(window, frame, resources, string.concat("BET ", string.from_int(table.bet)), components.rect(value.dock.x + 60, value.dock.y + 14, 76, 44), components.type_caption(), theme.primary_text(light_mode))?
        else:
            components.badge(window, frame, resources, components.rect(value.dock.x + 16, value.dock.y + 14, 136, 28), phase_name(table.phase), light_mode)?
            game_components.metric(window, frame, resources, "MULTIPLIER", multiplier_label(table.multiplier_basis_points), value.dock.x + 168, value.dock.y + 10, 108, true, light_mode)?
            game_components.metric(window, frame, resources, "RETURN", string.from_int(table.payout), value.dock.x + 292, value.dock.y + 10, 84, true, light_mode)?
    else:
        components.badge(window, frame, resources, components.rect(value.rail.x + 16, value.rail.y + 16, 146, 28), phase_name(table.phase), light_mode)?
        game_components.status_banner(window, frame, resources, components.rect(value.rail.x + 16, value.rail.y + 56, value.rail.width - 32, 54), table.message, light_mode)?
        game_components.metric(window, frame, resources, "MULTIPLIER", multiplier_label(table.multiplier_basis_points), value.rail.x + 16, value.rail.y + 118, 112, true, light_mode)?
        game_components.metric(window, frame, resources, "RETURN", string.from_int(table.payout), value.rail.x + 146, value.rail.y + 118, 90, true, light_mode)?
    if table.phase == 0:
        let bet_minus = bet_minus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let bet_plus = bet_plus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let auto_toggle = auto_toggle_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let auto_minus = auto_minus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let auto_plus = auto_plus_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        let start = start_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        components.modern_button(window, frame, resources, bet_minus, "-", components.button_secondary(), true, components.contains(bet_minus, mouse_x, mouse_y), false, light_mode)?
        components.modern_button(window, frame, resources, bet_plus, "+", components.button_secondary(), true, components.contains(bet_plus, mouse_x, mouse_y), false, light_mode)?
        if not value.compact:
            components.type_centered(window, frame, resources, string.concat("WAGER  ", string.from_int(table.bet)), components.rect(bet_minus.x + 48, bet_minus.y, bet_plus.x - bet_minus.x - 48, 44), components.type_label(), theme.primary_text(light_mode))?
        var auto_label = "AUTO OFF"
        if table.auto_cash_out_basis_points > 0:
            auto_label = multiplier_label(table.auto_cash_out_basis_points)
        components.modern_button(window, frame, resources, auto_toggle, auto_label, components.button_secondary(), true, components.contains(auto_toggle, mouse_x, mouse_y), false, light_mode)?
        components.modern_button(window, frame, resources, auto_minus, "-", components.button_secondary(), table.auto_cash_out_basis_points > 0, components.contains(auto_minus, mouse_x, mouse_y), false, light_mode)?
        components.modern_button(window, frame, resources, auto_plus, "+", components.button_secondary(), table.auto_cash_out_basis_points > 0, components.contains(auto_plus, mouse_x, mouse_y), false, light_mode)?
        components.modern_button(window, frame, resources, start, "LAUNCH [ENTER]", components.button_primary(), table.bet <= table.balance, components.contains(start, mouse_x, mouse_y), true, light_mode)?
    if table.phase == 1:
        let cash = cash_out_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        components.modern_button(window, frame, resources, cash, "CASH OUT [S]", components.button_primary(), true, components.contains(cash, mouse_x, mouse_y), true, light_mode)?
    if table.phase == 2:
        let next = next_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        components.modern_button(window, frame, resources, next, "NEXT FLIGHT [N]", components.button_primary(), true, components.contains(next, mouse_x, mouse_y), true, light_mode)?
    if table.phase != 1:
        let restart = restart_rect(rocket_raylib.window_width(window), rocket_raylib.window_height(window))
        components.modern_button(window, frame, resources, restart, "RESET [R]", components.button_secondary(), true, components.contains(restart, mouse_x, mouse_y), false, light_mode)?
    draw_history(window, frame, resources, table, value, light_mode)?
    return Ok(true)

fn draw_help(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, light_mode: Bool) -> Result[Bool, String]:
    let lines = ["The wager is prepaid and one deterministic crash point is committed.", "The curve starts at 1.00x and advances on bounded 20 Hz engine ticks.", "Cash Out settles the exact current integer multiplier only before crash.", "The hidden point is revealed after settlement and never reaches this view.", "Tickets 1-40000 crash at 1.00x; later tickets use a 960000 range.", "Threshold = clamp(floor(10000 x 960000 / denominator)).", "That is an exact 4% instant point and 96% reciprocal survival model.", "One optional auto target is validated for the round; help pauses ticks.", "Arrows/Tab configure, Enter launches, and S cashes out."]
    return game_components.help_overlay(window, frame, resources, "CRASH  /  PRECOMMITMENT GUIDE", lines, -1, light_mode)

pub fn draw(window: rocket_raylib.Window, frame: rocket_raylib.Frame, resources: ui_resources.UiResources, table: crash_api.PublicTable, help: Bool, light_mode: Bool, reduced_motion: Bool, now: Float, mouse_x: Int, mouse_y: Int) -> Result[Bool, String]:
    let width = rocket_raylib.window_width(window)
    let height = rocket_raylib.window_height(window)
    let value = interior(width, height)
    let expected = now
    game_components.ambient_stage(frame, resources, value.stage, 9, light_mode)?
    draw_graph(window, frame, resources, table, value, light_mode, reduced_motion)?
    draw_controls(window, frame, resources, table, value, mouse_x, mouse_y, light_mode)?
    let rules = help_rect(width, height)
    components.modern_button(window, frame, resources, rules, "RULES", components.button_quiet(), true, components.contains(rules, mouse_x, mouse_y), false, light_mode)?
    if help:
        draw_help(window, frame, resources, light_mode)?
    return Ok(true)
