import src.rocket_raylib

pub fn canvas(light_mode: Bool) -> rocket_raylib.Color:
    if light_mode:
        return rocket_raylib.color(238, 242, 250, 255)
    return rocket_raylib.color(9, 11, 20, 255)

pub fn shell(light_mode: Bool) -> rocket_raylib.Color:
    if light_mode:
        return rocket_raylib.color(255, 255, 255, 255)
    return rocket_raylib.color(15, 19, 36, 255)

pub fn surface(light_mode: Bool) -> rocket_raylib.Color:
    if light_mode:
        return rocket_raylib.color(255, 255, 255, 255)
    return rocket_raylib.color(21, 26, 45, 255)

pub fn elevated(light_mode: Bool) -> rocket_raylib.Color:
    if light_mode:
        return rocket_raylib.color(233, 238, 255, 255)
    return rocket_raylib.color(29, 36, 64, 255)

pub fn primary_text(light_mode: Bool) -> rocket_raylib.Color:
    if light_mode:
        return rocket_raylib.color(23, 32, 51, 255)
    return rocket_raylib.color(247, 248, 255, 255)

pub fn secondary_text(light_mode: Bool) -> rocket_raylib.Color:
    if light_mode:
        return rocket_raylib.color(102, 112, 133, 255)
    return rocket_raylib.color(162, 170, 196, 255)

pub fn subtle_border(light_mode: Bool) -> rocket_raylib.Color:
    if light_mode:
        return rocket_raylib.color(215, 221, 234, 255)
    return rocket_raylib.color(42, 51, 84, 255)

pub fn primary(light_mode: Bool) -> rocket_raylib.Color:
    if light_mode:
        return rocket_raylib.color(79, 70, 229, 255)
    return rocket_raylib.color(91, 124, 255, 255)

pub fn violet(light_mode: Bool) -> rocket_raylib.Color:
    if light_mode:
        return rocket_raylib.color(124, 58, 237, 255)
    return rocket_raylib.color(139, 92, 246, 255)

pub fn cyan(light_mode: Bool) -> rocket_raylib.Color:
    if light_mode:
        return rocket_raylib.color(8, 145, 178, 255)
    return rocket_raylib.color(34, 211, 238, 255)

pub fn success(light_mode: Bool) -> rocket_raylib.Color:
    if light_mode:
        return rocket_raylib.color(5, 150, 105, 255)
    return rocket_raylib.color(52, 211, 153, 255)

pub fn highlight(light_mode: Bool) -> rocket_raylib.Color:
    if light_mode:
        return rocket_raylib.color(217, 119, 6, 255)
    return rocket_raylib.color(251, 191, 36, 255)

pub fn destructive(light_mode: Bool) -> rocket_raylib.Color:
    if light_mode:
        return rocket_raylib.color(225, 29, 72, 255)
    return rocket_raylib.color(251, 113, 133, 255)

pub fn background() -> rocket_raylib.Color:
    return canvas(false)

pub fn panel() -> rocket_raylib.Color:
    return surface(false)

pub fn panel_hover() -> rocket_raylib.Color:
    return elevated(false)

pub fn gold() -> rocket_raylib.Color:
    return highlight(false)

pub fn emerald() -> rocket_raylib.Color:
    return success(false)

pub fn danger() -> rocket_raylib.Color:
    return destructive(false)

pub fn text() -> rocket_raylib.Color:
    return primary_text(false)

pub fn muted() -> rocket_raylib.Color:
    return secondary_text(false)

pub fn border() -> rocket_raylib.Color:
    return subtle_border(false)

pub fn road() -> rocket_raylib.Color:
    return rocket_raylib.color(30, 41, 59, 255)

pub fn rail() -> rocket_raylib.Color:
    return rocket_raylib.color(55, 48, 63, 255)

pub fn water() -> rocket_raylib.Color:
    return rocket_raylib.color(15, 70, 110, 255)

pub fn safe_lane() -> rocket_raylib.Color:
    return rocket_raylib.color(17, 72, 58, 255)

pub fn timber() -> rocket_raylib.Color:
    return rocket_raylib.color(146, 94, 48, 255)

pub fn card_light() -> rocket_raylib.Color:
    return rocket_raylib.color(248, 250, 252, 255)

pub fn card_dark() -> rocket_raylib.Color:
    return rocket_raylib.color(20, 28, 43, 255)

pub fn card_back() -> rocket_raylib.Color:
    return rocket_raylib.color(79, 36, 110, 255)

pub fn felt() -> rocket_raylib.Color:
    return rocket_raylib.color(8, 91, 67, 255)

pub fn felt_inner() -> rocket_raylib.Color:
    return rocket_raylib.color(6, 71, 55, 255)

pub fn overlay() -> rocket_raylib.Color:
    return rocket_raylib.color(0, 0, 0, 190)

