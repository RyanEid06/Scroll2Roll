import src.app.application
import src.app.chicken_view
import src.app.shell_view
import src.chicken.chicken_engine
import src.rocket_raylib
import src.rocket_raylib_testing
import std.collections
import std.file
import std.testing

fn press(window: rocket_raylib.Window, key: Int, state: application.State) -> application.State:
    let scripted = rocket_raylib_testing.set_key(key, true, false)
    return application.step_for_test(state, window)

fn click(window: rocket_raylib.Window, x: Int, y: Int, state: application.State) -> application.State:
    let scripted = rocket_raylib_testing.set_mouse(x, y, true)
    return application.step_for_test(state, window)

fn run() -> Result[Int, String]:
    if not rocket_raylib_testing.enable() or not rocket_raylib_testing.reset():
        return Ok(1)
    let temporary = testing.temp_directory("scroll2roll-chicken-gui")?
    let save_path = testing.fixture_path(temporary, "settings.s2r")?
    match rocket_raylib.open_window(800, 600, "Coop Climb scripted GUI"):
        case Ok(window):
            var state = application.initial_for_test(save_path)?
            state = press(window, rocket_raylib.key_enter(), state)
            var lobby_move = 0
            while lobby_move < 3:
                state = press(window, rocket_raylib.key_tab(), state)
                lobby_move = lobby_move + 1
            let lobby_card = shell_view.lobby_card_rect(3, 800, 600)
            state = click(window, lobby_card.x + lobby_card.width / 2, lobby_card.y + lobby_card.height / 2, state)
            if state.screen != 6 or chicken_engine.phase_code(state.chicken.game.phase) != 0:
                return Ok(2)
            state = press(window, rocket_raylib.key_p(), state)
            if not state.chicken_help:
                return Ok(3)
            application.draw_for_test(window, state)?
            state = press(window, rocket_raylib.key_p(), state)
            state = press(window, rocket_raylib.key_tab(), state)
            state = press(window, rocket_raylib.key_up(), state)
            if state.chicken.game.bet != 15:
                return Ok(4)
            state = press(window, rocket_raylib.key_enter(), state)
            if chicken_engine.phase_code(state.chicken.game.phase) != 1 or state.chicken.game.balance != 985 or collections.length(state.chicken.game.path) != 10:
                return Ok(5)
            state = press(window, rocket_raylib.key_enter(), state)
            if chicken_engine.phase_code(state.chicken.game.phase) == 1:
                state = press(window, rocket_raylib.key_s(), state)
            if chicken_engine.phase_code(state.chicken.game.phase) != 2 or not file.exists(save_path):
                return Ok(6)
            let first_balance = state.chicken.game.balance
            let next = chicken_view.next_rect(800, 600)
            state = click(window, next.x + next.width / 2, next.y + next.height / 2, state)
            if chicken_engine.phase_code(state.chicken.game.phase) != 0:
                return Ok(7)
            let risk = chicken_view.risk_rect(800, 600)
            let bet_plus = chicken_view.bet_plus_rect(800, 600)
            state = click(window, risk.x + risk.width / 2, risk.y + risk.height / 2, state)
            state = click(window, bet_plus.x + bet_plus.width / 2, bet_plus.y + bet_plus.height / 2, state)
            if state.chicken.game.bet != 20:
                return Ok(8)
            let start = chicken_view.start_rect(800, 600)
            state = click(window, start.x + start.width / 2, start.y + start.height / 2, state)
            if chicken_engine.phase_code(state.chicken.game.phase) != 1:
                return Ok(9)
            let advance = chicken_view.advance_rect(800, 600)
            state = click(window, advance.x + advance.width / 2, advance.y + advance.height / 2, state)
            if chicken_engine.phase_code(state.chicken.game.phase) == 1:
                let cash = chicken_view.cash_out_rect(800, 600)
                state = click(window, cash.x + cash.width / 2, cash.y + cash.height / 2, state)
            if chicken_engine.phase_code(state.chicken.game.phase) != 2:
                return Ok(10)
            application.draw_for_test(window, state)?
            let back = chicken_view.lobby_rect(800, 600)
            state = click(window, back.x + back.width / 2, back.y + back.height / 2, state)
            if state.screen != 1 or state.settings.play_balance != state.chicken.game.balance:
                return Ok(11)
            if first_balance < 0 or state.chicken.game.balance < 0:
                return Ok(12)
            let closed = rocket_raylib.close_window(window)
            testing.cleanup_temp(temporary)?
            if rocket_raylib_testing.buffer_live_count() != 0:
                return Ok(13)
            return Ok(0)
        case Err(error):
            return Err(error)

fn main() -> Int:
    match run():
        case Ok(status):
            return status
        case Err(error):
            print(error)
            return 90
