import src.app.components
import src.app.ui_resources
import src.rocket_raylib
import src.rocket_raylib_testing

fn run() -> Result[Int, String]:
    if not rocket_raylib_testing.enable() or not rocket_raylib_testing.reset():
        return Ok(1)
    let window = rocket_raylib.open_window(1280, 720, "UI component states")?
    let resources = ui_resources.load_from_paths(window, "font.ttf", "atlas-a.png", "atlas-b.png")
    let frame = rocket_raylib.begin_frame(window)?
    rocket_raylib.clear(frame, rocket_raylib.black())?
    components.modern_panel(frame, components.rect(20, 20, 360, 180), false, false)?
    components.modern_panel(frame, components.rect(400, 20, 360, 180), true, true)?
    components.modern_button(window, frame, resources, components.rect(40, 60, 150, 48), "Primary", components.button_primary(), true, true, true, false)?
    components.modern_button(window, frame, resources, components.rect(210, 60, 150, 48), "Disabled", components.button_secondary(), false, false, false, false)?
    components.modern_button(window, frame, resources, components.rect(420, 60, 150, 48), "Quiet", components.button_quiet(), true, false, false, true)?
    components.modern_button(window, frame, resources, components.rect(590, 60, 150, 48), "Danger", components.button_danger(), true, true, false, true)?
    components.icon_button(frame, components.rect(780, 28, 48, 48), 0, true, true, true, false)?
    components.icon_button(frame, components.rect(840, 28, 48, 48), 1, true, false, false, true)?
    components.icon_button(frame, components.rect(900, 28, 48, 48), 2, false, false, false, false)?
    components.toggle(frame, components.rect(780, 96, 60, 32), false, true, false)?
    components.toggle(frame, components.rect(860, 96, 60, 32), true, false, true)?
    components.pill(window, frame, resources, components.rect(40, 130, 128, 30), "1,000 credits", true, false)?
    components.badge(window, frame, resources, components.rect(190, 130, 92, 30), "TABLE", false)?
    components.section_header(window, frame, resources, "Featured games", 20, 220, 920, false)?
    components.game_card(window, frame, resources, components.rect(20, 280, 270, 330), 0, "Blackjack", "Classic table", true, true, false)?
    components.game_card(window, frame, resources, components.rect(310, 280, 270, 330), 10, "Slots", "Five reels", false, false, true)?
    components.game_card(window, frame, ui_resources.empty(), components.rect(600, 280, 270, 330), 6, "Mines", "Procedural fallback", false, false, false)?
    components.toast(window, frame, resources, components.rect(890, 280, 340, 52), "Settings saved", false, false)?
    if rocket_raylib_testing.scissor_active() or rocket_raylib_testing.draw_count() < 40:
        return Ok(2)
    rocket_raylib.end_frame(frame)?
    ui_resources.unload(resources)?
    rocket_raylib.close_window(window)?
    if rocket_raylib_testing.font_live_count() != 0 or rocket_raylib_testing.texture_live_count() != 0 or rocket_raylib_testing.buffer_live_count() != 0:
        return Ok(3)
    return Ok(0)

fn main() -> Int:
    match run():
        case Ok(status):
            return status
        case Err(error):
            print(error)
            return 90
