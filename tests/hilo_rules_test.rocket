import src.hilo.hilo_cards
import src.hilo.hilo_model
import src.hilo.hilo_rules
import src.holdem.holdem_model
import std.collections

fn run() -> Result[Int, String]:
    if hilo_rules.valid_bet(0) or hilo_rules.valid_bet(7) or hilo_rules.valid_bet(1005) or not hilo_rules.valid_bet(5) or not hilo_rules.valid_bet(1000):
        return Ok(1)
    let ordered = hilo_cards.ordered()?
    let first = hilo_cards.shuffled(8080)?
    let duplicate = hilo_cards.shuffled(8080)?
    if not hilo_cards.is_standard(ordered) or not hilo_cards.is_standard(first) or collections.length(first) != 52:
        return Ok(2)
    var index = 0
    var changed = false
    while index < 52:
        if first[index].rank != duplicate[index].rank or first[index].suit != duplicate[index].suit:
            return Ok(3)
        if first[index].rank != ordered[index].rank or first[index].suit != ordered[index].suit:
            changed = true
        index = index + 1
    if not changed:
        return Ok(4)
    var rank = 1
    while rank <= 13:
        let current = holdem_model.Card(rank, 0)
        var start = 0
        while start <= 52:
            let counts = hilo_rules.outcomes(current, ordered, start)?
            var lower = 0
            var higher = 0
            var equal = 0
            index = start
            while index < 52:
                let value = hilo_cards.rank_value(ordered[index])
                if value < hilo_cards.rank_value(current):
                    lower = lower + 1
                if value > hilo_cards.rank_value(current):
                    higher = higher + 1
                if value == hilo_cards.rank_value(current):
                    equal = equal + 1
                index = index + 1
            if counts.lower != lower or counts.higher != higher or counts.equal != equal or counts.total != 52 - start:
                return Ok(5)
            start = start + 1
        rank = rank + 1
    let exact_counts = hilo_rules.OutcomeCounts(25, 20, 6, 51)
    let expected = 10000 * 9600 * 51 /(25 * 10000)
    if hilo_rules.advance_multiplier(10000, exact_counts, hilo_model.Lower())? != expected:
        return Ok(6)
    if hilo_rules.payout(15, expected) != 15 * expected / 10000:
        return Ok(7)
    let no_higher = hilo_rules.OutcomeCounts(48, 0, 3, 51)
    if hilo_rules.legal(no_higher, hilo_model.Higher()) or not hilo_rules.legal(no_higher, hilo_model.Lower()):
        return Ok(8)
    match hilo_rules.advance_multiplier(10000, no_higher, hilo_model.Higher()):
        case Ok(value):
            return Ok(9)
        case Err(error):
            let expected_error = true
    let five_hearts = holdem_model.Card(5, 1)
    let five_spades = holdem_model.Card(5, 0)
    if hilo_rules.prediction_wins(five_hearts, five_spades, hilo_model.Higher()) or hilo_rules.prediction_wins(five_hearts, five_spades, hilo_model.Lower()):
        return Ok(10)
    if hilo_rules.payout(1000, hilo_rules.maximum_multiplier_basis_points()) != hilo_rules.maximum_balance():
        return Ok(11)
    match hilo_rules.outcomes(five_hearts, ordered, 53):
        case Ok(value):
            return Ok(12)
        case Err(error):
            let expected_error = true
    return Ok(0)

fn main() -> Int:
    match run():
        case Ok(status):
            return status
        case Err(error):
            print(error)
            return 90
