import src.app.application
import src.app.roulette_view
import src.app.shell_view
import src.roulette.roulette_engine
import src.roulette.roulette_rules
import src.rocket_raylib
import src.rocket_raylib_testing
import std.collections
import std.file
import std.testing

fn press(window: rocket_raylib.Window, key: Int, state: application.State) -> application.State:
    let scripted = rocket_raylib_testing.set_key(key, true, false)
    return application.step_for_test(state, window)

fn click(window: rocket_raylib.Window, x: Int, y: Int, state: application.State) -> application.State:
    let scripted = rocket_raylib_testing.set_mouse(x, y, true)
    return application.step_for_test(state, window)

fn frame(window: rocket_raylib.Window, state: application.State) -> Result[application.State, String]:
    application.draw_for_test(window, state)?
    return Ok(application.step_for_test(state, window))

fn run() -> Result[Int, String]:
    if not rocket_raylib_testing.enable() or not rocket_raylib_testing.reset():
        return Ok(1)
    let temporary = testing.temp_directory("scroll2roll-roulette-gui")?
    let save_path = testing.fixture_path(temporary, "settings.s2r")?
    let six = roulette_view.number_rect(6, 1280, 720)
    let two = roulette_view.number_rect(2, 1280, 720)
    let five = roulette_view.number_rect(5, 1280, 720)
    let street_rail = roulette_view.street_rail_rect(0, 1280, 720)
    let six_line_rail = roulette_view.six_line_rail_rect(1, 1280, 720)
    let basket_box = roulette_view.basket_rect(1280, 720)
    let horizontal_split = roulette_view.mouse_bet(six.x + 1, six.y + six.height / 2, 1280, 720, 10)?
    let vertical_split = roulette_view.mouse_bet(two.x + two.width / 2, two.y + 1, 1280, 720, 10)?
    let corner = roulette_view.mouse_bet(five.x + 1, five.y + 1, 1280, 720, 10)?
    let street = roulette_view.mouse_bet(street_rail.x + street_rail.width / 2, street_rail.y + 1, 1280, 720, 10)?
    let six_line = roulette_view.mouse_bet(six_line_rail.x + 1, six_line_rail.y + 1, 1280, 720, 10)?
    let basket = roulette_view.mouse_bet(basket_box.x + basket_box.width / 2, basket_box.y + basket_box.height / 2, 1280, 720, 10)?
    if roulette_rules.kind_code(horizontal_split.kind) != 1 or horizontal_split.numbers[0] != 3 or horizontal_split.numbers[1] != 6:
        return Ok(19)
    if roulette_rules.kind_code(vertical_split.kind) != 1 or vertical_split.numbers[0] != 2 or vertical_split.numbers[1] != 3:
        return Ok(20)
    if roulette_rules.kind_code(corner.kind) != 3 or corner.numbers[0] != 2 or corner.numbers[3] != 6:
        return Ok(21)
    if roulette_rules.kind_code(street.kind) != 2 or street.numbers[0] != 1 or street.numbers[2] != 3:
        return Ok(22)
    if roulette_rules.kind_code(six_line.kind) != 4 or six_line.numbers[0] != 1 or six_line.numbers[5] != 6:
        return Ok(23)
    if roulette_rules.kind_code(basket.kind) != 5 or basket.numbers[0] != 0 or basket.numbers[3] != 3:
        return Ok(24)
    match rocket_raylib.open_window(1280, 720, "Roulette scripted GUI"):
        case Ok(window):
            var state = application.initial_for_test(save_path)?
            state = press(window, rocket_raylib.key_enter(), state)
            if state.screen != 1:
                return Ok(2)
            state = press(window, rocket_raylib.key_tab(), state)
            let lobby_card = shell_view.lobby_card_rect(1, 1280, 720)
            state = click(window, lobby_card.x + lobby_card.width / 2, lobby_card.y + lobby_card.height / 2, state)
            if state.screen != 4 or roulette_engine.phase_code(state.roulette.game.phase) != 0:
                return Ok(3)
            state = press(window, rocket_raylib.key_p(), state)
            if not state.roulette_help:
                return Ok(4)
            application.draw_for_test(window, state)?
            state = press(window, rocket_raylib.key_p(), state)
            if state.roulette_help:
                return Ok(5)
            state = press(window, rocket_raylib.key_enter(), state)
            if collections.length(state.roulette.game.bets) != 1 or state.roulette.game.bets[0].numbers[0] != 0:
                return Ok(6)
            state = press(window, rocket_raylib.key_tab(), state)
            state = press(window, rocket_raylib.key_right(), state)
            state = press(window, rocket_raylib.key_enter(), state)
            if collections.length(state.roulette.game.bets) != 2:
                return Ok(7)
            state = press(window, rocket_raylib.key_h(), state)
            if collections.length(state.roulette.game.bets) != 1:
                return Ok(8)
            let chip = roulette_view.chip_rect(2, 1280, 720)
            state = click(window, chip.x + chip.width / 2, chip.y + chip.height / 2, state)
            if state.roulette.game.selected_chip != 25:
                return Ok(9)
            let zero = roulette_view.number_rect(0, 1280, 720)
            let seventeen = roulette_view.number_rect(17, 1280, 720)
            state = click(window, zero.x + zero.width / 2, zero.y + zero.height / 2, state)
            state = click(window, seventeen.x + seventeen.width / 2, seventeen.y + seventeen.height / 2, state)
            if collections.length(state.roulette.game.bets) != 3:
                return Ok(10)
            let wager = roulette_engine.total_wager(state.roulette.game)
            state = press(window, rocket_raylib.key_s(), state)
            if roulette_engine.phase_code(state.roulette.game.phase) != 1 or state.roulette.game.pending_winner < 0:
                return Ok(11)
            var guard = 0
            while roulette_engine.phase_code(state.roulette.game.phase) != 2 and guard < 180:
                state = frame(window, state)?
                guard = guard + 1
            if guard >= 180 or roulette_engine.phase_code(state.roulette.game.phase) != 2:
                return Ok(12)
            if state.roulette.game.result.total_wager != wager or not file.exists(save_path):
                return Ok(13)
            application.draw_for_test(window, state)?
            state = press(window, rocket_raylib.key_r(), state)
            if roulette_engine.phase_code(state.roulette.game.phase) != 0 or roulette_engine.total_wager(state.roulette.game) != wager:
                return Ok(14)
            state = press(window, rocket_raylib.key_d(), state)
            if roulette_engine.total_wager(state.roulette.game) != 0:
                return Ok(15)
            state = press(window, rocket_raylib.key_b(), state)
            if state.screen != 1:
                return Ok(16)
            let saved_balance = state.settings.play_balance
            if saved_balance != state.roulette.game.balance:
                return Ok(17)
            let closed = rocket_raylib.close_window(window)
            testing.cleanup_temp(temporary)?
            if rocket_raylib_testing.buffer_live_count() != 0:
                return Ok(18)
            return Ok(0)
        case Err(error):
            return Err(error)

fn main() -> Int:
    match run():
        case Ok(status):
            return status
        case Err(error):
            print(error)
            return 90
