import src.app.application
import src.app.shell_view
import src.plinko.plinko_engine
import src.rocket_raylib
import src.rocket_raylib_testing
import std.collections
import std.file
import std.testing

fn press(window: rocket_raylib.Window, key: Int, state: application.State) -> application.State:
    let scripted = rocket_raylib_testing.set_key(key, true, false)
    return application.step_for_test(state, window)

fn click(window: rocket_raylib.Window, x: Int, y: Int, state: application.State) -> application.State:
    let scripted = rocket_raylib_testing.set_mouse(x, y, true)
    return application.step_for_test(state, window)

fn frame(window: rocket_raylib.Window, state: application.State) -> Result[application.State, String]:
    application.draw_for_test(window, state)?
    return Ok(application.step_for_test(state, window))

fn settle_animation(window: rocket_raylib.Window, value: application.State) -> Result[application.State, String]:
    var state = value
    var guard = 0
    while plinko_engine.phase_code(state.plinko.game.phase) != 2 and guard < 400:
        state = frame(window, state)?
        guard = guard + 1
    if guard >= 400:
        return Err("Plinko GUI animation exceeded 400 frames")
    return Ok(state)

fn run() -> Result[Int, String]:
    if not rocket_raylib_testing.enable() or not rocket_raylib_testing.reset():
        return Ok(1)
    let temporary = testing.temp_directory("scroll2roll-plinko-gui")?
    let save_path = testing.fixture_path(temporary, "settings.s2r")?
    match rocket_raylib.open_window(1280, 720, "Plinko scripted GUI"):
        case Ok(window):
            var state = application.initial_for_test(save_path)?
            state = press(window, rocket_raylib.key_enter(), state)
            state = press(window, rocket_raylib.key_tab(), state)
            state = press(window, rocket_raylib.key_tab(), state)
            let lobby_card = shell_view.lobby_card_rect(2, 1280, 720)
            state = click(window, lobby_card.x + lobby_card.width / 2, lobby_card.y + lobby_card.height / 2, state)
            if state.screen != 5 or plinko_engine.phase_code(state.plinko.game.phase) != 0:
                return Ok(2)
            state = press(window, rocket_raylib.key_p(), state)
            if not state.plinko_help:
                return Ok(3)
            application.draw_for_test(window, state)?
            state = press(window, rocket_raylib.key_p(), state)
            state = press(window, rocket_raylib.key_right(), state)
            state = press(window, rocket_raylib.key_tab(), state)
            state = press(window, rocket_raylib.key_up(), state)
            state = press(window, rocket_raylib.key_m(), state)
            if state.plinko.game.rows != 13 or state.plinko.game.bet != 15 or state.plinko.game.batch_count != 2:
                return Ok(4)
            state = press(window, rocket_raylib.key_enter(), state)
            if plinko_engine.phase_code(state.plinko.game.phase) != 1 or collections.length(state.plinko.game.pending) != 2:
                return Ok(5)
            let first_balance = state.plinko.game.balance
            state = settle_animation(window, state)?
            if plinko_engine.phase_code(state.plinko.game.phase) != 2 or state.plinko_stage <= 0:
                return Ok(6)
            if not file.exists(save_path) or state.plinko.game.balance < first_balance:
                return Ok(12)
            state = click(window, 100, 670, state)
            if plinko_engine.phase_code(state.plinko.game.phase) != 0:
                return Ok(7)
            state = click(window, 973, 149, state)
            state = click(window, 1040, 204, state)
            state = click(window, 1159, 259, state)
            state = click(window, 1159, 313, state)
            if state.plinko.game.rows != 12 or state.plinko.game.bet != 20 or state.plinko.game.batch_count != 3:
                return Ok(8)
            state = click(window, 1040, 377, state)
            if plinko_engine.phase_code(state.plinko.game.phase) != 1 or collections.length(state.plinko.game.pending) != 3:
                return Ok(9)
            state = settle_animation(window, state)?
            application.draw_for_test(window, state)?
            state = click(window, 230, 670, state)
            if state.screen != 1 or state.settings.play_balance != state.plinko.game.balance:
                return Ok(10)
            let closed = rocket_raylib.close_window(window)
            testing.cleanup_temp(temporary)?
            if rocket_raylib_testing.buffer_live_count() != 0:
                return Ok(11)
            return Ok(0)
        case Err(error):
            return Err(error)

fn main() -> Int:
    match run():
        case Ok(status):
            return status
        case Err(error):
            print(error)
            return 90
