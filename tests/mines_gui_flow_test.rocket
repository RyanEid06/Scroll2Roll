import src.app.application
import src.app.mines_view
import src.mines.mines_api
import src.rocket_raylib
import src.rocket_raylib_testing
import std.file
import std.testing

fn press(window: rocket_raylib.Window, key: Int, state: application.State) -> application.State:
    let scripted = rocket_raylib_testing.set_key(key, true, false)
    return application.step_for_test(state, window)

fn click(window: rocket_raylib.Window, x: Int, y: Int, state: application.State) -> application.State:
    let scripted = rocket_raylib_testing.set_mouse(x, y, true)
    return application.step_for_test(state, window)

fn finish_animation(window: rocket_raylib.Window, state: application.State) -> Result[application.State, String]:
    var frame = 0
    while frame < 18:
        application.draw_for_test(window, state)?
        frame = frame + 1
    return Ok(state)

fn find_tile(state: application.State, wanted: Int) -> Result[Int, String]:
    var tile = 0
    while tile < 25:
        if state.mines.game.mine_layout[tile] == wanted:
            return Ok(tile)
        tile = tile + 1
    return Err("Expected scripted Mines tile was not found")

fn run() -> Result[Int, String]:
    if not rocket_raylib_testing.enable() or not rocket_raylib_testing.reset():
        return Ok(1)
    let temporary = testing.temp_directory("scroll2roll-mines-gui")?
    let save_path = testing.fixture_path(temporary, "settings.s2r")?
    match rocket_raylib.open_window(800, 600, "Mines scripted GUI"):
        case Ok(window):
            var state = application.initial_for_test(save_path)?
            state = press(window, rocket_raylib.key_enter(), state)
            state = click(window, 400, 135, state)
            if state.screen != 9 or mines_api.phase_code(state.mines) != 0:
                return Ok(2)
            state = press(window, rocket_raylib.key_p(), state)
            if not state.mines_help:
                return Ok(3)
            application.draw_for_test(window, state)?
            state = press(window, rocket_raylib.key_p(), state)
            state = press(window, rocket_raylib.key_up(), state)
            state = press(window, rocket_raylib.key_right(), state)
            if state.mines.game.bet != 15 or state.mines.game.mine_count != 4:
                return Ok(4)
            state = press(window, rocket_raylib.key_enter(), state)
            if mines_api.phase_code(state.mines) != 1 or state.mines.game.balance != 985:
                return Ok(5)
            let first_safe = find_tile(state, 0)?
            var move = 0
            while move < first_safe:
                state = press(window, rocket_raylib.key_right(), state)
                move = move + 1
            state = press(window, rocket_raylib.key_enter(), state)
            if state.mines.game.safe_reveals != 1 or mines_api.tile_state(state.mines, first_safe)? != 1:
                return Ok(6)
            state = finish_animation(window, state)?
            state = press(window, rocket_raylib.key_s(), state)
            if mines_api.phase_code(state.mines) != 2 or not file.exists(save_path):
                return Ok(7)
            state = finish_animation(window, state)?
            state = click(window, 100, 550, state)
            if mines_api.phase_code(state.mines) != 0:
                return Ok(8)
            state = click(window, 586, 226, state)
            state = click(window, 679, 286, state)
            state = click(window, 586, 349, state)
            if mines_api.phase_code(state.mines) != 1:
                return Ok(9)
            let second_safe = find_tile(state, 0)?
            let box = mines_view.tile_rect(second_safe)
            state = click(window, box.x + 20, box.y + 20, state)
            if state.mines.game.safe_reveals != 1:
                return Ok(10)
            state = finish_animation(window, state)?
            state = click(window, 586, 349, state)
            if mines_api.phase_code(state.mines) != 2:
                return Ok(11)
            state = finish_animation(window, state)?
            application.draw_for_test(window, state)?
            state = click(window, 230, 550, state)
            if state.screen != 1 or state.settings.play_balance != state.mines.game.balance:
                return Ok(12)
            let closed = rocket_raylib.close_window(window)
            testing.cleanup_temp(temporary)?
            if rocket_raylib_testing.buffer_live_count() != 0:
                return Ok(13)
            return Ok(0)
        case Err(error):
            return Err(error)

fn main() -> Int:
    match run():
        case Ok(status):
            return status
        case Err(error):
            print(error)
            return 90
