import src.chicken.chicken_model
import src.chicken.chicken_rules
import std.collections

fn run() -> Result[Int, String]:
    if chicken_rules.maximum_depth() != 10 or chicken_rules.target_return_basis_points() != 9600:
        return Ok(1)
    if chicken_rules.survival_numerator(chicken_model.Low()) != 4 or chicken_rules.survival_denominator(chicken_model.Low()) != 5:
        return Ok(2)
    if chicken_rules.survival_numerator(chicken_model.Medium()) != 2 or chicken_rules.survival_denominator(chicken_model.Medium()) != 3:
        return Ok(3)
    if chicken_rules.survival_numerator(chicken_model.High()) != 1 or chicken_rules.survival_denominator(chicken_model.High()) != 2:
        return Ok(4)
    let low = chicken_rules.multipliers(chicken_model.Low())
    let medium = chicken_rules.multipliers(chicken_model.Medium())
    let high = chicken_rules.multipliers(chicken_model.High())
    if collections.length(low) != 10 or collections.length(medium) != 10 or collections.length(high) != 10:
        return Ok(5)
    if low[0] != 12000 or low[9] != 89406:
        return Ok(6)
    if medium[0] != 14400 or medium[9] != 553584:
        return Ok(7)
    if high[0] != 19200 or high[9] != 9830400:
        return Ok(8)
    var depth = 1
    while depth <= chicken_rules.maximum_depth():
        let low_return = chicken_rules.expected_return_basis_points(chicken_model.Low(), depth)?
        let medium_return = chicken_rules.expected_return_basis_points(chicken_model.Medium(), depth)?
        let high_return = chicken_rules.expected_return_basis_points(chicken_model.High(), depth)?
        if low_return < 9599 or low_return > 9600:
            return Ok(9)
        if medium_return < 9599 or medium_return > 9600:
            return Ok(10)
        if high_return != 9600:
            return Ok(11)
        if not(low[depth - 1] < medium[depth - 1] and medium[depth - 1] < high[depth - 1]):
            return Ok(12)
        depth = depth + 1
    match chicken_rules.multiplier_at(chicken_model.Low(), 0):
        case Ok(value):
            return Ok(13)
        case Err(error):
            let expected = true
    match chicken_rules.multiplier_at(chicken_model.High(), 11):
        case Ok(value):
            return Ok(14)
        case Err(error):
            let expected = true
    if chicken_rules.valid_bet(4) or chicken_rules.valid_bet(11) or chicken_rules.valid_bet(1005):
        return Ok(15)
    if not chicken_rules.valid_bet(5) or not chicken_rules.valid_bet(1000):
        return Ok(16)
    if chicken_rules.payout(25, 23437) != 58 or chicken_rules.payout(5, 12000) != 6:
        return Ok(17)
    return Ok(0)

fn main() -> Int:
    match run():
        case Ok(status):
            return status
        case Err(error):
            print(error)
            return 90
