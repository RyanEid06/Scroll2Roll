import src.app.application
import src.app.crossing_view
import src.app.shell_view
import src.crossing.crossing_engine
import src.crossing.crossing_rules
import src.rocket_raylib
import src.rocket_raylib_testing
import std.file
import std.testing

fn press(window: rocket_raylib.Window, key: Int, state: application.State) -> application.State:
    let scripted = rocket_raylib_testing.set_key(key, true, false)
    return application.step_for_test(state, window)

fn click(window: rocket_raylib.Window, x: Int, y: Int, state: application.State) -> application.State:
    let scripted = rocket_raylib_testing.set_mouse(x, y, true)
    return application.step_for_test(state, window)

fn frame(window: rocket_raylib.Window, state: application.State) -> Result[application.State, String]:
    application.draw_for_test(window, state)?
    return Ok(application.step_for_test(state, window))

fn drive_checkpoint(window: rocket_raylib.Window, value: application.State, mouse: Bool) -> Result[application.State, String]:
    var state = value
    var guard = 0
    while crossing_engine.phase_code(state.crossing.game.phase) == 1 and state.crossing.game.checkpoints == 0 and guard < 3000:
        let next_lane = state.crossing.game.player_lane + 1
        var corridor_clear = true
        if state.crossing.game.player_lane == 0:
            corridor_clear = crossing_engine.safe_at(state.crossing.game, state.crossing.game.player_x, 1) and crossing_engine.safe_at(state.crossing.game, state.crossing.game.player_x, 2) and crossing_engine.safe_at(state.crossing.game, state.crossing.game.player_x, 3)
        if corridor_clear and crossing_engine.safe_at(state.crossing.game, state.crossing.game.player_x, next_lane):
            if mouse:
                let up = crossing_view.up_rect(800, 600)
                state = click(window, up.x + up.width / 2, up.y + up.height / 2, state)
            else:
                state = press(window, rocket_raylib.key_up(), state)
        else:
            let left_x = state.crossing.game.player_x - crossing_rules.movement_step()
            let right_x = state.crossing.game.player_x + crossing_rules.movement_step()
            let current_lane = state.crossing.game.player_lane
            if crossing_rules.lane_kind(current_lane) == 3 and crossing_engine.safe_at(state.crossing.game, left_x, current_lane) and crossing_engine.safe_at(state.crossing.game, left_x, next_lane):
                if mouse:
                    let left = crossing_view.left_rect(800, 600)
                    state = click(window, left.x + left.width / 2, left.y + left.height / 2, state)
                else:
                    state = press(window, rocket_raylib.key_left(), state)
            else:
                if crossing_rules.lane_kind(current_lane) == 3 and crossing_engine.safe_at(state.crossing.game, right_x, current_lane) and crossing_engine.safe_at(state.crossing.game, right_x, next_lane):
                    if mouse:
                        let right = crossing_view.right_rect(800, 600)
                        state = click(window, right.x + right.width / 2, right.y + right.height / 2, state)
                    else:
                        state = press(window, rocket_raylib.key_right(), state)
                else:
                    state = frame(window, state)?
        guard = guard + 1
    if guard >= 3000:
        return Err("Midnight Crossing GUI checkpoint guard exceeded")
    return Ok(state)

fn run() -> Result[Int, String]:
    if not rocket_raylib_testing.enable() or not rocket_raylib_testing.reset():
        return Ok(1)
    let temporary = testing.temp_directory("scroll2roll-crossing-gui")?
    let save_path = testing.fixture_path(temporary, "settings.s2r")?
    match rocket_raylib.open_window(800, 600, "Midnight Crossing scripted GUI"):
        case Ok(window):
            var state = application.initial_for_test(save_path)?
            state = press(window, rocket_raylib.key_enter(), state)
            var lobby_move = 0
            while lobby_move < 4:
                state = press(window, rocket_raylib.key_tab(), state)
                lobby_move = lobby_move + 1
            let lobby_card = shell_view.lobby_card_rect(4, 800, 600)
            state = click(window, lobby_card.x + lobby_card.width / 2, lobby_card.y + lobby_card.height / 2, state)
            if state.screen != 7 or crossing_engine.phase_code(state.crossing.game.phase) != 0:
                return Ok(2)
            state = press(window, rocket_raylib.key_p(), state)
            if not state.crossing_help:
                return Ok(3)
            application.draw_for_test(window, state)?
            state = press(window, rocket_raylib.key_p(), state)
            state = press(window, rocket_raylib.key_up(), state)
            if state.crossing.game.bet != 15:
                return Ok(4)
            state = press(window, rocket_raylib.key_enter(), state)
            if crossing_engine.phase_code(state.crossing.game.phase) != 1 or state.crossing.game.balance != 985:
                return Ok(5)
            state = press(window, rocket_raylib.key_p(), state)
            let paused_tick = state.crossing.game.tick_count
            state = frame(window, state)?
            if not state.crossing_help or not state.crossing.game.paused or state.crossing.game.tick_count != paused_tick:
                return Ok(6)
            state = press(window, rocket_raylib.key_p(), state)
            state = drive_checkpoint(window, state, false)?
            if crossing_engine.phase_code(state.crossing.game.phase) != 1 or state.crossing.game.checkpoints != 1:
                return Ok(7)
            state = press(window, rocket_raylib.key_s(), state)
            if crossing_engine.phase_code(state.crossing.game.phase) != 2 or state.crossing.game.payout != 18 or not file.exists(save_path):
                return Ok(8)
            let first_balance = state.crossing.game.balance
            let next = crossing_view.next_rect(800, 600)
            state = click(window, next.x + next.width / 2, next.y + next.height / 2, state)
            if crossing_engine.phase_code(state.crossing.game.phase) != 0:
                return Ok(9)
            let bet_plus = crossing_view.bet_plus_rect(800, 600)
            let start = crossing_view.start_rect(800, 600)
            state = click(window, bet_plus.x + bet_plus.width / 2, bet_plus.y + bet_plus.height / 2, state)
            state = click(window, start.x + start.width / 2, start.y + start.height / 2, state)
            if crossing_engine.phase_code(state.crossing.game.phase) != 1 or state.crossing.game.bet != 20:
                return Ok(10)
            let right = crossing_view.right_rect(800, 600)
            let left = crossing_view.left_rect(800, 600)
            state = click(window, right.x + right.width / 2, right.y + right.height / 2, state)
            state = click(window, left.x + left.width / 2, left.y + left.height / 2, state)
            if state.crossing.game.player_x != 450 or state.crossing.game.checkpoints != 0:
                return Ok(11)
            let pause = crossing_view.pause_rect(800, 600)
            state = click(window, pause.x + pause.width / 2, pause.y + pause.height / 2, state)
            if not state.crossing_help or not state.crossing.game.paused:
                return Ok(12)
            state = click(window, pause.x + pause.width / 2, pause.y + pause.height / 2, state)
            state = drive_checkpoint(window, state, true)?
            if crossing_engine.phase_code(state.crossing.game.phase) != 1 or state.crossing.game.checkpoints != 1:
                return Ok(13)
            let cash = crossing_view.cash_out_rect(800, 600)
            state = click(window, cash.x + cash.width / 2, cash.y + cash.height / 2, state)
            if crossing_engine.phase_code(state.crossing.game.phase) != 2:
                return Ok(14)
            application.draw_for_test(window, state)?
            let back = crossing_view.lobby_rect(800, 600)
            state = click(window, back.x + back.width / 2, back.y + back.height / 2, state)
            if state.screen != 1 or state.settings.play_balance != state.crossing.game.balance:
                return Ok(15)
            if first_balance < 0 or state.crossing.game.balance < 0:
                return Ok(16)
            let closed = rocket_raylib.close_window(window)
            testing.cleanup_temp(temporary)?
            if rocket_raylib_testing.buffer_live_count() != 0:
                return Ok(17)
            return Ok(0)
        case Err(error):
            return Err(error)

fn main() -> Int:
    match run():
        case Ok(status):
            return status
        case Err(error):
            print(error)
            return 90
