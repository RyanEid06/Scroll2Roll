import src.crossing.crossing_model
import src.crossing.crossing_rules

fn run() -> Result[Int, String]:
    if crossing_rules.world_width() != 900 or crossing_rules.lane_count() != 8 or crossing_rules.fixed_ticks_per_second() != 20:
        return Ok(1)
    if crossing_rules.max_ticks_per_frame() != 8 or crossing_rules.max_checkpoints() != 5:
        return Ok(2)
    if crossing_rules.lane_kind(0) != 0 or crossing_rules.lane_kind(1) != 1 or crossing_rules.lane_kind(3) != 2:
        return Ok(3)
    if crossing_rules.lane_kind(4) != 0 or crossing_rules.lane_kind(5) != 3 or crossing_rules.lane_kind(7) != 4:
        return Ok(4)
    if crossing_rules.multiplier_for(0) != 10000 or crossing_rules.multiplier_for(1) != 12500 or crossing_rules.multiplier_for(5) != 22500:
        return Ok(5)
    if crossing_rules.multiplier_for(99) != 22500 or crossing_rules.payout(25, 12500) != 31:
        return Ok(6)
    if not crossing_rules.overlaps(450, 430, 70) or crossing_rules.overlaps(450, 471, 70):
        return Ok(7)
    if crossing_rules.valid_bet(4) or crossing_rules.valid_bet(11) or crossing_rules.valid_bet(1005):
        return Ok(8)
    if not crossing_rules.valid_bet(5) or not crossing_rules.valid_bet(1000):
        return Ok(9)
    if not crossing_rules.valid_hazard(crossing_model.Hazard(1, crossing_model.Car(), 100, 70, 6)):
        return Ok(10)
    if not crossing_rules.valid_hazard(crossing_model.Hazard(3, crossing_model.Tram(), 100, 280, -12)):
        return Ok(11)
    if not crossing_rules.valid_hazard(crossing_model.Hazard(5, crossing_model.Log(), 100, 180, 4)):
        return Ok(12)
    if crossing_rules.valid_hazard(crossing_model.Hazard(5, crossing_model.Car(), 100, 70, 6)):
        return Ok(13)
    if crossing_rules.valid_hazard(crossing_model.Hazard(1, crossing_model.Car(), 100, 20, 0)):
        return Ok(14)
    return Ok(0)

fn main() -> Int:
    match run():
        case Ok(status):
            return status
        case Err(error):
            print(error)
            return 90
